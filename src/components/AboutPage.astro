---
import { Image } from "astro:assets";
import studioPhoto from "@/assets/editorial/about-studio-worktable.jpg";
import BlinkText from "@/components/BlinkText";
import FinalCta from "@/components/home/FinalCta.astro";
import SiteFooter from "@/components/home/SiteFooter.astro";
import SiteHeader from "@/components/home/SiteHeader.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { ArrowRight } from "lucide-react";
import type { Locale } from "@/i18n/config";
import { pathFor } from "@/i18n/routes";
import type { Messages } from "@/i18n/types";
import { brand } from "@/lib/brand";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const { about, solutions } = messages;
const skipLink = locale === "tr" ? "Ana içeriğe geç" : "Skip to content";

interface Fact {
  label: string;
  value: string;
  href?: string;
}

// The entity facts Google has nothing else to read the company from. Blank
// values are dropped rather than rendered empty: an unfinished field should be
// absent, not published as a claim that the company has no legal name.
const facts: Fact[] = [
  brand.legalName
    ? { label: about.factLabels.legalName, value: brand.legalName }
    : null,
  { label: about.factLabels.based, value: about.factValues.based },
  { label: about.factLabels.languages, value: about.factValues.languages },
  { label: about.factLabels.products, value: about.factValues.products },
  { label: about.factLabels.site, value: brand.domain, href: "/" },
  brand.email
    ? {
        label: about.factLabels.contact,
        value: brand.email,
        href: `mailto:${brand.email}`,
      }
    : null,
].filter((fact): fact is Fact => fact !== null);

// Each product has its own page, and its row links there.
const products = (["kollektor", "intelval", "hastam", "fountible"] as const).map((slug) => ({
  product: solutions[slug],
  page: { href: pathFor(slug, locale), label: solutions[slug].pageCta },
}));
---

<a class="skip-link" href="#main-content">{skipLink}</a>

<div class="min-h-screen bg-background">
  <SiteHeader locale={locale} messages={messages} />

  <main id="main-content" tabindex="-1">
    <section
      class="frame frame-cross border-b border-border"
      aria-labelledby="about-title"
    >
      {/* The display size, as on the home and product pages. At the default
          h2 size the page title was no larger than "Neler ürettik" below it. */}
      <SectionHeader
        as="h1"
        eyebrow={about.eyebrow}
        lead={about.lead}
        headingId="about-title"
        headingClass="max-w-3xl text-display"
        rule={false}
        class="pt-16!"
      >
        <BlinkText client:idle priority text={about.title} />
      </SectionHeader>

      {/* The page's one picture, and what closes the header instead of a
          hairline. An illustrative studio scene, not the GBO office, and
          decorative, so the alt is empty (docs/editorial-imagery.md). */}
      <div class="px-3 pb-3">
        <div class="overflow-hidden rounded-well bg-muted">
          <Image
            src={studioPhoto}
            alt=""
            width={1200}
            widths={[480, 768, 1200, 1800, 2400]}
            sizes="(min-width: 78rem) 75rem, 100vw"
            format="webp"
            quality={72}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-[3/2] w-full object-cover sm:aspect-[21/9]"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="px-5 py-10 sm:px-8 sm:py-14 lg:col-span-7 lg:px-12">
          <h2 class="max-w-2xl text-title-h3">
            <BlinkText client:visible text={about.bodyTitle} />
          </h2>
          <div class="mt-6 space-y-5">
            {
              about.body.map((paragraph) => (
                <p class="max-w-xl text-pretty text-paragraph-md text-muted-foreground">
                  {paragraph}
                </p>
              ))
            }
          </div>
        </div>

        <div class="px-5 pb-12 sm:px-8 sm:py-14 lg:col-span-5 lg:px-12">
          <h2 class="text-label-sm text-tertiary-foreground">
            {about.factsTitle}
          </h2>
          <dl class="mt-6 divide-y divide-border border-y border-border">
            {
              facts.map((fact) => (
                <div class="flex items-baseline justify-between gap-6 py-3.5">
                  <dt class="text-label-sm text-muted-foreground">
                    {fact.label}
                  </dt>
                  <dd class="text-right text-label-sm text-foreground">
                    {
                      fact.href ? (
                        <a
                          href={fact.href}
                          class="underline-offset-4 transition-colors hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
                        >
                          {fact.value}
                        </a>
                      ) : (
                        fact.value
                      )
                    }
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section
      class="frame frame-cross border-b border-border"
      aria-labelledby="about-products-title"
    >
      <SectionHeader
        lead={about.productsIntro}
        headingId="about-products-title"
        headingClass="max-w-2xl text-title-h2"
        class="pt-16!"
      >
        <BlinkText client:visible text={about.productsTitle} />
      </SectionHeader>

      {/* Two by two: four products in three columns left one alone on a row,
          and four columns cut the longer descriptions to a narrow strip. */}
      <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-2">
        {
          products.map(({ product, page }) => (
            <article class="flex flex-col bg-background px-5 py-10 sm:px-8 sm:py-12">
              <p class="text-label-sm text-tertiary-foreground">
                {product.eyebrow}
              </p>
              <h3 class="mt-4 text-title-h5 text-foreground sm:text-title-h4">
                {product.title}
              </h3>
              <p class="mt-4 max-w-md text-pretty text-paragraph-md text-muted-foreground">
                {product.description}
              </p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {product.highlights.map((highlight) => (
                  <li class="rounded-full bg-foreground/[0.05] px-3 py-1 text-label-xs text-muted-foreground">
                    {highlight}
                  </li>
                ))}
              </ul>
              <div class="mt-auto pt-6">
                <a
                  href={page.href}
                  class="button button-sm button-secondary group w-fit"
                >
                  {page.label}
                  <ArrowRight
                    aria-hidden="true"
                    focusable="false"
                    className="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
                    strokeWidth={1.5}
                  />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <FinalCta locale={locale} messages={messages} />
  </main>

  <SiteFooter locale={locale} messages={messages} />
</div>
