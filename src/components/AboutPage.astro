---
import BlinkText from "@/components/BlinkText";
import FinalCta from "@/components/home/FinalCta.astro";
import SiteFooter from "@/components/home/SiteFooter.astro";
import SiteHeader from "@/components/home/SiteHeader.astro";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";
import { brand } from "@/lib/brand";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const { about, solutions } = messages;
const skipLink = locale === "tr" ? "Ana içeriğe geç" : "Skip to content";

interface Fact {
  label: string;
  value: string;
  href?: string;
}

// The entity facts Google has nothing else to read the company from. Blank
// values are dropped rather than rendered empty: an unfinished field should be
// absent, not published as a claim that the company has no legal name.
const facts: Fact[] = [
  brand.legalName
    ? { label: about.factLabels.legalName, value: brand.legalName }
    : null,
  { label: about.factLabels.based, value: about.factValues.based },
  { label: about.factLabels.languages, value: about.factValues.languages },
  { label: about.factLabels.products, value: about.factValues.products },
  { label: about.factLabels.site, value: brand.domain, href: "/" },
  brand.email
    ? {
        label: about.factLabels.contact,
        value: brand.email,
        href: `mailto:${brand.email}`,
      }
    : null,
].filter((fact): fact is Fact => fact !== null);

const products = [solutions.kollektor, solutions.intelval];
---

<a class="skip-link" href="#main-content">{skipLink}</a>

<div class="min-h-screen bg-background">
  <SiteHeader locale={locale} messages={messages} />

  <main id="main-content" tabindex="-1">
    <section
      class="mx-auto w-full max-w-[83.75rem] scroll-mt-16 border-x border-b border-border"
      aria-labelledby="about-title"
    >
      <div class="grid grid-cols-1 border-b border-border lg:grid-cols-12">
        <div class="px-5 py-10 sm:px-8 sm:py-14 lg:col-span-7 lg:px-12 lg:py-18">
          <p
            class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/45"
          >
            <span class="h-px w-5 bg-foreground/25" aria-hidden="true"></span>
            {about.eyebrow}
          </p>
          <h1
            id="about-title"
            class="max-w-3xl text-3xl font-medium leading-[1.1] tracking-[-0.035em] sm:text-5xl"
          >
            <BlinkText client:idle priority text={about.title} />
          </h1>
        </div>
        <div
          class="flex items-end border-t border-border px-5 py-8 sm:px-8 lg:col-span-5 lg:border-t-0 lg:border-l lg:px-10 lg:py-14"
        >
          <p class="max-w-lg text-pretty text-base leading-relaxed text-muted-foreground">
            {about.lead}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-px bg-border lg:grid-cols-12">
        <div class="bg-background px-5 py-10 sm:px-8 sm:py-14 lg:col-span-7 lg:px-12">
          <h2
            class="max-w-2xl text-2xl font-medium leading-[1.15] tracking-[-0.03em] sm:text-3xl"
          >
            <BlinkText client:visible text={about.bodyTitle} />
          </h2>
          <div class="mt-6 space-y-5">
            {
              about.body.map((paragraph) => (
                <p class="max-w-xl text-pretty text-base leading-relaxed text-muted-foreground">
                  {paragraph}
                </p>
              ))
            }
          </div>
        </div>

        <div class="bg-background px-5 py-10 sm:px-8 sm:py-14 lg:col-span-5 lg:px-10">
          <h2
            class="font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/45"
          >
            {about.factsTitle}
          </h2>
          <dl class="mt-6 divide-y divide-border border-y border-border">
            {
              facts.map((fact) => (
                <div class="flex items-baseline justify-between gap-6 py-3.5">
                  <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
                    {fact.label}
                  </dt>
                  <dd class="text-right text-sm font-medium text-foreground">
                    {
                      fact.href ? (
                        <a
                          href={fact.href}
                          class="underline-offset-4 transition-colors hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
                        >
                          {fact.value}
                        </a>
                      ) : (
                        fact.value
                      )
                    }
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section
      class="mx-auto w-full max-w-[83.75rem] scroll-mt-16 border-x border-b border-border"
      aria-labelledby="about-products-title"
    >
      <div class="grid grid-cols-1 border-b border-border lg:grid-cols-12">
        <div class="px-5 py-10 sm:px-8 sm:py-14 lg:col-span-7 lg:px-12">
          <h2
            id="about-products-title"
            class="max-w-2xl text-2xl font-medium leading-[1.15] tracking-[-0.03em] sm:text-3xl"
          >
            <BlinkText client:visible text={about.productsTitle} />
          </h2>
        </div>
        <div
          class="flex items-end border-t border-border px-5 py-8 sm:px-8 lg:col-span-5 lg:border-t-0 lg:border-l lg:px-10 lg:py-14"
        >
          <p class="max-w-lg text-pretty text-base leading-relaxed text-muted-foreground">
            {about.productsIntro}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-2">
        {
          products.map((product) => (
            <article class="flex flex-col bg-background px-5 py-10 sm:px-8 sm:py-12">
              <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/45">
                {product.eyebrow}
              </p>
              <h3 class="mt-4 text-xl font-medium tracking-tight text-foreground sm:text-2xl">
                {product.title}
              </h3>
              <p class="mt-4 max-w-md text-pretty text-base leading-relaxed text-muted-foreground">
                {product.description}
              </p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {product.highlights.map((highlight) => (
                  <li class="rounded-full border border-border px-3 py-1 font-mono text-[11px] tracking-[0.06em] text-muted-foreground">
                    {highlight}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <FinalCta locale={locale} messages={messages} />
  </main>

  <SiteFooter locale={locale} messages={messages} />
</div>
