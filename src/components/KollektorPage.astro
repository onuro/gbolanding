---
// The Kollektor product page. One story, top to bottom: what it is, one call
// played from start to finish, how a list becomes calls, what it does on the
// call, what the team sees, when a person steps in, the rules, the data, who
// it is for, and the questions. ProductPageShell adds the demo request.
//
// Nothing on this page starts by itself. The sample call (KollektorDemo) shows
// its finished state and plays once each time the visitor presses its button;
// every other picture is a still. A call that played and looped below the hero
// pulled the eye off the copy around it.
import { Image } from "astro:assets";
import headsetPhoto from "@/assets/editorial/kollektor-voice-workspace.png";
import kollektorLogo from "@/assets/product/kollektor-logo.svg";
import KollektorDemo from "@/components/home/KollektorDemo.astro";
import KollektorStage from "@/components/home/kollektor-parts/KollektorStage.astro";
import DataPicture from "@/components/kollektor-page/DataPicture.astro";
import HandoffMock from "@/components/kollektor-page/HandoffMock.astro";
import HeroPicture from "@/components/kollektor-page/HeroPicture.astro";
import ListMock from "@/components/kollektor-page/ListMock.astro";
import StepGrid from "@/components/kollektor-page/StepGrid.astro";
import StepRows from "@/components/kollektor-page/StepRows.astro";
import TeamScreenMock from "@/components/kollektor-page/TeamScreenMock.astro";
import Chapter from "@/components/product/Chapter.astro";
import FactCells from "@/components/product/FactCells.astro";
import Faq from "@/components/product/Faq.astro";
import NumberedRows from "@/components/product/NumberedRows.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import ProductPageShell from "@/components/product/ProductPageShell.astro";
import SampleTag from "@/components/product/SampleTag.astro";
import SayDoTable from "@/components/product/SayDoTable.astro";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const page = messages.kollektorPage;
// Clears the sticky header when a link jumps to a section.
const anchor = "scroll-mt-20";
---

<ProductPageShell
  locale={locale}
  messages={messages}
  product="kollektor"
  assurances={page.ctaAssurances}
>
  <ProductHero copy={page.hero} product="kollektor" secondaryHref="#call">
    <img
      slot="logo"
      src={kollektorLogo.src}
      alt="Kollektor"
      width="44"
      height="44"
      class="mb-7 size-11"
    />
    <HeroPicture slot="visual" locale={locale} copy={page.heroPicture} />
  </ProductHero>

  {/* The sample call: the home page's scripted demo, with this page's own
      facts under it instead of the home page's figures. */}
  <Chapter
    id="call"
    headingId="kollektor-call-title"
    copy={page.call}
    class={anchor}
    wide
    flush
  >
    <div
      class="flex items-center justify-between gap-4 border-t border-border px-5 py-4 sm:px-8 lg:px-12"
    >
      <p class="max-w-[46rem] text-pretty text-paragraph-sm text-muted-foreground">
        {page.call.caption}
      </p>
      {/* From sm the demo's own stage header says "sample data"; below that it
          has no room for it, so the tag is shown here instead. */}
      <SampleTag locale={locale} class="sm:hidden" />
    </div>
    <KollektorDemo
      locale={locale}
      embedded
      proof={page.call.proof}
      stereo={false}
      replay={{ play: page.call.play, pause: page.call.pause }}
    />
  </Chapter>

  <Chapter id="start" headingId="kollektor-start-title" copy={page.start} class={anchor}>
    <div data-reveal>
      <KollektorStage label={page.start.mock.summary}>
        <ListMock locale={locale} copy={page.start.mock} />
      </KollektorStage>
    </div>
    <NumberedRows rows={page.start.rows} class="mt-10 lg:mt-12" />
  </Chapter>

  <Chapter id="on-call" headingId="kollektor-oncall-title" copy={page.onCall} class={anchor}>
    <SayDoTable
      rows={page.onCall.rows}
      sayLabel={page.onCall.sayLabel}
      doLabel={page.onCall.doLabel}
    />
  </Chapter>

  {/* Wide, like the sample call: the team's screen is the product the buyer
      would use, so it gets the frame's full width, and its six rows sit under
      it as a three-column legend. A wide chapter has no margin column, so the
      note is printed under the picture. */}
  <Chapter
    id="team"
    headingId="kollektor-team-title"
    copy={page.team}
    class={anchor}
    wide
    flush
  >
    <div class="px-5 pb-10 sm:px-8 lg:px-12 lg:pb-12" data-reveal>
      <KollektorStage label={page.team.mock.summary}>
        <TeamScreenMock locale={locale} copy={page.team.mock} />
      </KollektorStage>
      <p class="mt-3 pl-1 text-paragraph-xs text-tertiary-foreground">{page.team.note}</p>
    </div>
    <StepGrid rows={page.team.rows} />
  </Chapter>

  <Chapter id="handoff" headingId="kollektor-handoff-title" copy={page.handoff} class={anchor}>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-12">
      <div data-reveal>
        <KollektorStage label={page.handoff.mock.summary}>
          <HandoffMock locale={locale} copy={page.handoff.mock} />
        </KollektorStage>
      </div>
      <StepRows rows={page.handoff.rows} />
    </div>
  </Chapter>

  <Chapter id="rules" headingId="kollektor-rules-title" copy={page.rules} class={anchor}>
    <NumberedRows rows={page.rules.rows} />
  </Chapter>

  <Chapter id="data" headingId="kollektor-data-title" copy={page.data} class={anchor} flush>
    {/* The section's own bottom rule closes the cells, so theirs is dropped.
        The chapter is flush, so the cells also carry its bottom space: with
        only their own 2rem the next section's label sat right under the last
        paragraph. Stacked (below lg, where FactCells is one column) only the
        last cell needs it; side by side, all three do. */}
    <FactCells
      items={page.data.items}
      class="border-b-0 [&>li:last-child>div:last-child]:pb-16 sm:[&>li:last-child>div:last-child]:pb-20 lg:[&>li>div:last-child]:pb-20"
    >
      <DataPicture slot="cell-0" locale={locale} kind="log" copy={page.data.pictures} />
      <DataPicture slot="cell-1" locale={locale} kind="keep" copy={page.data.pictures} />
      <DataPicture slot="cell-2" locale={locale} kind="role" copy={page.data.pictures} />
    </FactCells>
  </Chapter>

  <Chapter
    id="audience"
    headingId="kollektor-audience-title"
    copy={page.audience}
    class={anchor}
  >
    <div class="overflow-hidden rounded-card bg-muted" data-reveal>
      <Image
        src={headsetPhoto}
        alt={page.audience.imageAlt}
        width={1120}
        widths={[480, 768, 1120]}
        sizes="(min-width: 84rem) 57rem, (min-width: 64rem) 85vw, 100vw"
        format="webp"
        quality={72}
        loading="lazy"
        decoding="async"
        class="aspect-[3/2] w-full object-cover sm:aspect-[21/9]"
      />
    </div>
    <NumberedRows rows={page.audience.rows} class="mt-10 lg:mt-12" />
  </Chapter>

  <Chapter id="faq" headingId="kollektor-faq-title" copy={page.faq} class={anchor}>
    <Faq items={page.faq.items} name="kollektor-faq" />
  </Chapter>
</ProductPageShell>
