---
// Your team's screen after the calls: today's list with one result per call,
// and beside it the call that is picked, with its promise, its recording and
// its last two lines. A still. The picked row is marked by a tint and by its
// darker name, not by a bar on its edge.
//
// It is drawn wide: this is the one place a buyer sees the product they would
// use, so from a 48rem window the list and the picked call sit side by side
// like the real screen. Below that the picked call drops under the list.
import type { Locale } from "@/i18n/config";
import type { KollektorPageMessages } from "@/i18n/page-types/kollektor";
import DotWave from "./DotWave.astro";
import MockWindow from "./MockWindow.astro";
import StateDot from "./StateDot.astro";

interface Props {
  locale: Locale;
  copy: KollektorPageMessages["team"]["mock"];
}

const { locale, copy } = Astro.props;
const PICKED = 0;
// Every row is a subgrid of one table grid, so the time and the result line up
// down the list while each column is only as wide as its longest value and the
// name is never narrower than its text. Fixed widths left the name 40px on a
// 320px phone and cut it to three letters. The time only shows from an 18rem
// window (on a 320px phone the name and the result need the whole row) and
// the length from a 28rem one.
const table =
  "grid grid-cols-[minmax(max-content,1fr)_auto] gap-x-2 @2xs:grid-cols-[minmax(max-content,1fr)_auto_auto] @2xs:gap-x-3 @md:grid-cols-[minmax(max-content,1fr)_auto_auto_auto] @md:gap-x-6 @3xl:grid-cols-[minmax(0,1fr)_4rem_4rem_9.5rem]";
const row = "col-span-full grid grid-cols-subgrid items-center px-3 @2xs:px-4";
---

<MockWindow locale={locale} owner={copy.owner} title={copy.window} meta={copy.range} class="max-w-[64rem]">
  {/* minmax(0, ...) on both layouts: an auto column would grow to the widest
      line of the picked call and push the window past a 320px phone. */}
  <div class="grid grid-cols-[minmax(0,1fr)] @3xl:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
    <div class:list={[table, "content-start"]}>
      <div class:list={[row, "border-b border-border bg-foreground/[0.02] py-2"]}>
        <span class="data-label whitespace-nowrap">{copy.columns[0]}</span>
        <span class="hidden data-label whitespace-nowrap @2xs:block">{copy.columns[1]}</span>
        <span class="hidden data-label whitespace-nowrap @md:block">{copy.columns[2]}</span>
        <span class="data-label whitespace-nowrap">{copy.columns[3]}</span>
      </div>
      <ul class="col-span-full grid grid-cols-subgrid">
        {
          copy.rows.map((call, index) => (
            <li
              class:list={[
                row,
                "py-2.5",
                index > 0 && "border-t border-border",
                index === PICKED && "bg-foreground/[0.05]",
              ]}
            >
              <span
                class:list={[
                  "truncate text-paragraph-sm",
                  index === PICKED ? "text-foreground" : "text-muted-foreground",
                ]}
              >
                {call.name}
              </span>
              <span class="hidden data-label whitespace-nowrap tabular-nums @2xs:block">
                {call.time}
              </span>
              <span class="hidden data-label whitespace-nowrap tabular-nums @md:block">
                {call.length}
              </span>
              <StateDot tone={call.tone} label={call.state} class="whitespace-nowrap" />
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="border-t border-border-strong px-3 pt-3.5 pb-4 @2xs:px-4 @3xl:border-t-0 @3xl:border-l @3xl:px-5 @3xl:pt-4 @3xl:pb-5"
    >
      <p class="text-label-xs text-foreground">{copy.detailTitle}</p>

      <dl class="mt-3 grid grid-cols-2 gap-3">
        {
          copy.detailRows.map((pair) => (
            <div>
              <dt class="data-label">{pair.label}</dt>
              <dd class="mt-1 text-paragraph-sm text-foreground tabular-nums">{pair.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-3.5 flex items-center gap-3 border-t border-border pt-3.5">
        <span class="data-label shrink-0">{copy.recording}</span>
        <DotWave class="flex-1 text-tertiary-foreground" bars={34} rows={6} seed={3} />
        <span class="data-label shrink-0 tabular-nums">{copy.duration}</span>
      </div>

      <ul class="mt-3.5 flex flex-col gap-2 border-t border-border pt-3.5">
        {
          copy.lines.map((line) => (
            <li class="grid grid-cols-[4.75rem_minmax(0,1fr)] items-baseline gap-2">
              <span class="data-label truncate">{line.who}</span>
              <span class="text-paragraph-sm text-foreground">{line.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</MockWindow>
