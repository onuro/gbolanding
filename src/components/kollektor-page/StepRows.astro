---
// NumberedRows for half a column. The shared one switches to three columns by
// viewport width, which is too tight beside a picture; this keeps the same
// hairlines and numbers and stacks title over text at every width.
import type { RowCopy } from "@/i18n/page-types/shared";

interface Props {
  rows: readonly RowCopy[];
  class?: string;
}

const { rows, class: className } = Astro.props;
---

<ol class:list={["border-b border-border", className]}>
  {
    rows.map((row, index) => (
      <li class="border-t border-border">
        <div
          class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 py-5 sm:grid-cols-[3.5rem_minmax(0,1fr)]"
          data-reveal
        >
          <span class="data-label pt-1 tabular-nums" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div>
            <h3 class="text-title-h6 text-foreground">{row.title}</h3>
            <p class="mt-1.5 max-w-[34rem] text-pretty text-paragraph-sm text-muted-foreground">
              {row.description}
            </p>
          </div>
        </div>
      </li>
    ))
  }
</ol>
