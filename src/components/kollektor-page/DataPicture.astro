---
// The three small pictures of the "data" section, one per fact: a system log
// with masked numbers, the 90 days a record lives, and one role's rights.
// Each is a still drawn in DOM. A picture whose values are made up says so.
import { Check, Minus } from "lucide-react";
import SampleTag from "@/components/product/SampleTag.astro";
import type { Locale } from "@/i18n/config";
import type { KollektorPageMessages } from "@/i18n/page-types/kollektor";

interface Props {
  locale: Locale;
  kind: "log" | "keep" | "role";
  copy: KollektorPageMessages["data"]["pictures"];
}

const { locale, kind, copy } = Astro.props;
const card = "w-full max-w-[19rem] rounded-card border border-border bg-background";
const summary = { log: copy.logSummary, keep: copy.keepSummary, role: copy.roleSummary }[kind];
---

{/* One height for all three, so the trays and the text under them line up. */}
<div class="flex min-h-[11.5rem] w-full items-center justify-center">
  <p class="sr-only">{summary}</p>

  {
    kind === "log" && (
      <div class={card} aria-hidden="true">
        <div class="flex items-center justify-between gap-3 border-b border-border px-3.5 py-2">
          <span class="text-label-xs text-foreground">{copy.logTitle}</span>
          <SampleTag locale={locale} />
        </div>
        <ul class="px-3.5 py-1">
          {copy.logRows.map((row, index) => (
            <li
              class:list={[
                "flex items-baseline justify-between gap-3 py-2",
                index > 0 && "border-t border-border",
              ]}
            >
              <span class="data-label tabular-nums">{row.label}</span>
              <span class="text-paragraph-sm text-foreground tabular-nums">{row.value}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    kind === "keep" && (
      <div class:list={[card, "px-3.5 py-4"]} aria-hidden="true">
        <div class="flex items-center gap-2">
          <span class="size-2 shrink-0 rounded-full bg-foreground" />
          <span class="keep-line h-px flex-1" />
          <span class="size-2 shrink-0 rounded-full border border-border-strong" />
        </div>
        <div class="mt-3 flex items-start justify-between gap-3">
          <p>
            <span class="data-label block">{copy.keepFrom.label}</span>
            <span class="mt-1 block text-paragraph-sm text-foreground">{copy.keepFrom.value}</span>
          </p>
          <p class="text-right">
            <span class="data-label block">{copy.keepTo.label}</span>
            <span class="mt-1 block text-paragraph-sm text-foreground">{copy.keepTo.value}</span>
          </p>
        </div>
        <ul class="mt-3.5 flex flex-wrap gap-1.5 border-t border-border pt-3.5">
          {copy.keepItems.map((item) => (
            <li class="rounded-full border border-border px-2.5 py-0.5 text-label-xs text-muted-foreground">
              {item}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    kind === "role" && (
      <div class={card} aria-hidden="true">
        <div class="flex items-center justify-between gap-3 border-b border-border px-3.5 py-2">
          <span class="text-label-xs text-foreground">{copy.roleTitle}</span>
          <SampleTag locale={locale} />
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_3rem_3rem] items-center gap-x-2 px-3.5 pt-2 pb-1">
          <span />
          {copy.roleColumns.map((column) => (
            <span class="data-label text-center">{column}</span>
          ))}
          {copy.roleRows.map((row) => (
            <>
              <span class="border-t border-border py-1.5 text-paragraph-sm text-foreground">
                {row.label}
              </span>
              {["r", "w"].map((right) => (
                <span class="grid place-items-center self-stretch border-t border-border">
                  {row.value.includes(right) ? (
                    <span class="grid size-4 place-items-center rounded-full bg-foreground text-background">
                      <Check className="size-2.5" strokeWidth={3} aria-hidden="true" />
                    </span>
                  ) : (
                    <span class="grid size-4 place-items-center rounded-full border border-border-strong text-tertiary-foreground">
                      <Minus className="size-2.5" strokeWidth={2.5} aria-hidden="true" />
                    </span>
                  )}
                </span>
              ))}
            </>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  /* The life of a record as a dotted line: day 0 on the left, day 90 on the
     right. Dots, not a solid rule, to match the page's other pictures. */
  .keep-line {
    background: radial-gradient(circle, var(--tertiary-foreground) 1px, transparent 1.2px) 0 50% /
      6px 3px repeat-x;
    height: 3px;
  }
</style>
