---
// Each row starts from the sentence the caller says and ends at what the
// product does with it. The caller's words are the large text: a visitor
// recognises their own customers in them before reading any feature name.
import type { SayDoCopy } from "@/i18n/page-types/shared";

interface Props {
  rows: readonly SayDoCopy[];
  /** Column heads, e.g. "What the patient says" / "What Hastam does". */
  sayLabel: string;
  doLabel: string;
  class?: string;
}

const { rows, sayLabel, doLabel, class: className } = Astro.props;
const columns =
  "md:grid-cols-[3.5rem_minmax(0,1.15fr)_minmax(0,1fr)] md:gap-x-8";
---

<div class:list={["border-b border-border-strong", className]}>
  <div class:list={["hidden pb-3 md:grid", columns]} aria-hidden="true">
    <span></span>
    <span class="data-label">{sayLabel}</span>
    <span class="data-label">{doLabel}</span>
  </div>

  <ol>
    {
      rows.map((row, index) => (
        <li class="group border-t border-border-strong">
          <div
            class:list={["grid gap-y-3 py-7 md:items-baseline lg:py-8", columns]}
            data-reveal
          >
            <span class="data-label tabular-nums" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <p class="text-balance text-title-h4 text-foreground transition-colors duration-200 group-hover:text-brand lg:text-title-h3">
              <span class="sr-only">{sayLabel}: </span>
              {row.say}
            </p>
            <div>
              <h3 class="text-title-h6 text-foreground">{row.title}</h3>
              <p class="mt-2 max-w-[34rem] text-pretty text-paragraph-sm text-muted-foreground">
                {row.description}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>
