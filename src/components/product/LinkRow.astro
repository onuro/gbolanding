---
// The link that closes a section: one quiet pill, one arrow.
import { ArrowUpRight } from "lucide-react";

interface Props {
  href: string;
  label: string;
  /** Preselects a product pill in the demo form when the link is "#demo". */
  demoProduct?: "kollektor" | "intelval" | "hastam" | "custom";
  /** Opens another site: adds rel and says so to screen readers. */
  external?: boolean;
  externalHint?: string;
  class?: string;
}

const {
  href,
  label,
  demoProduct,
  external = false,
  externalHint,
  class: className,
} = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-2 px-5 pt-2 pb-10 sm:px-8 sm:pb-14 lg:px-12", className]}>
  <a
    href={href}
    data-demo-product={demoProduct}
    rel={external ? "noopener" : undefined}
    class="button button-sm button-secondary group"
  >
    <span>
      {label}
      {external && externalHint && <span class="sr-only"> ({externalHint})</span>}
    </span>
    <ArrowUpRight
      aria-hidden="true"
      className="size-3.5 text-tertiary-foreground transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      strokeWidth={1.5}
    />
  </a>
</div>
