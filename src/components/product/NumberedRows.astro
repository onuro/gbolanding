---
// A list as a hairline table instead of a card grid: number, what it is, what
// it means. Used for steps and for rules, where the order or the count matters.
import type { RowCopy } from "@/i18n/page-types/shared";

interface Props {
  rows: readonly RowCopy[];
  /** First number shown. */
  start?: number;
  class?: string;
}

const { rows, start = 1, class: className } = Astro.props;
---

<ol class:list={["border-b border-border", className]}>
  {
    rows.map((row, index) => (
      <li class="border-t border-border">
        <div
          class="grid gap-x-8 gap-y-2 py-6 md:grid-cols-[3.5rem_minmax(0,1fr)_minmax(0,1.2fr)] md:items-baseline lg:py-7"
          data-reveal
        >
          <span class="data-label tabular-nums" aria-hidden="true">
            {String(index + start).padStart(2, "0")}
          </span>
          <h3 class="text-title-h5 text-foreground">{row.title}</h3>
          <p class="max-w-[34rem] text-pretty text-paragraph-md text-muted-foreground">
            {row.description}
          </p>
        </div>
      </li>
    ))
  }
</ol>
