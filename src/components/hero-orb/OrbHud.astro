---
/**
 * Instrument ring around the hero orb.
 *
 * Radii are in a 1000×1000 viewBox. The shader disc sits at ~385 of that box
 * when the HUD is the same size as the canvas; the overlay is drawn larger so
 * the instrument rings sit farther from the orb. Everything drawn lives outside
 * the disc.
 */
const C = 500;
const DISC = 345;

const polar = (r: number, deg: number) => {
  const rad = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(rad), C + r * Math.sin(rad)] as const;
};

const n = (value: number) => Number(value.toFixed(2));

const arc = (r: number, from: number, to: number) => {
  const [x1, y1] = polar(r, from);
  const [x2, y2] = polar(r, to);
  const large = Math.abs(to - from) > 180 ? 1 : 0;
  return `M ${n(x1)} ${n(y1)} A ${r} ${r} 0 ${large} 1 ${n(x2)} ${n(y2)}`;
};

const radial = (from: number, to: number, deg: number) => {
  const [x1, y1] = polar(from, deg);
  const [x2, y2] = polar(to, deg);
  return { x1: n(x1), y1: n(y1), x2: n(x2), y2: n(y2) };
};

/**
 * Every mark comes up on its own, and they have to arrive out of order or the
 * ring reads as a wipe rather than a panel finding power. Hashed from the index
 * so the server and the client agree on the scatter.
 */
const scatter = (seed: number, span: number) =>
  Math.round((Math.abs(Math.sin(seed * 12.9898) * 43758.5453) % 1) * span);

const boot = (base: number, seed: number, span: number) =>
  `--boot:${base + scatter(seed, span)}ms`;

const GRADUATION = 412;
const graduations = Array.from({ length: 120 }, (_, i) => {
  const deg = i * 3;
  const major = i % 5 === 0;
  return {
    ...radial(GRADUATION - (major ? 16 : 7), GRADUATION, deg),
    major,
    boot: boot(180, i + 1, 560),
  };
});

// Five arcs with gaps, so the ring reads as machined rather than drawn.
const SEGMENT = 444;
const segments = [0, 72, 144, 216, 288].map((start, i) => ({
  d: arc(SEGMENT, start, start + 52),
  boot: boot(420, i + 200, 280),
}));

// Trailing comet that sweeps the segmented ring while a call is up.
const sweep = Array.from({ length: 7 }, (_, i) => ({
  d: arc(SEGMENT, -i * 7 - 7, -i * 7),
  opacity: n(0.85 - i * 0.12),
}));

const OUTER = 478;
const outerArcs = [20, 140, 260].map((start, i) => ({
  d: arc(OUTER, start, start + 26),
  boot: boot(560, i + 300, 300),
  caps: [polar(OUTER, start), polar(OUTER, start + 26)].map(([x, y], cap) => ({
    x: n(x),
    y: n(y),
    boot: boot(640, i * 2 + cap + 320, 260),
  })),
}));

// Bar-code cluster: reads as a readout without pretending to be text.
const cells = Array.from({ length: 15 }, (_, i) => {
  const deg = 297 + i * 3.2;
  const length = i % 3 === 0 ? 13 : 7;
  return {
    ...radial(466 - length / 2, 466 + length / 2, deg),
    boot: boot(640, i + 400, 280),
  };
});

const BRACKET = 494;
const brackets = [45, 135, 225, 315].flatMap((deg, i) => [
  {
    type: "arc" as const,
    d: arc(BRACKET, deg - 8, deg + 8),
    boot: boot(380, i + 500, 320),
  },
  {
    type: "tick" as const,
    ...radial(BRACKET, BRACKET + 8, deg - 8),
    boot: boot(380, i + 520, 320),
  },
  {
    type: "tick" as const,
    ...radial(BRACKET, BRACKET + 8, deg + 8),
    boot: boot(380, i + 540, 320),
  },
]);

const axes = [0, 90, 180, 270].map((deg, i) => ({
  ...radial(DISC + 42, 498, deg),
  boot: boot(320, i + 600, 260),
}));

// Level gauge, in the manner of a cockpit dot matrix: the whole track is always
// drawn so you can read capacity, and it fills with the voice. It grows from 6
// o'clock out to both sides, so `t` is how far round a dot sits from the bottom.
const METER_COUNT = 96;
const METER_R = 359;
const meterDots = Array.from({ length: METER_COUNT }, (_, i) => {
  const deg = (i * 360) / METER_COUNT;
  const [x, y] = polar(METER_R, deg);
  return {
    x: n(x),
    y: n(y),
    t: n(Math.abs(180 - deg) / 180),
    boot: boot(80, i + 700, 480),
  };
});
---

<div
  class="orb-hud pointer-events-none absolute left-1/2 top-1/2 z-10 size-[128%] -translate-x-1/2 -translate-y-1/2"
  aria-hidden="true"
  data-orb-hud
>
  <svg viewBox="0 0 1000 1000" fill="none" class="size-full text-foreground">
    <g class="hud-static">
      <circle
        class="hud-cell"
        style="--boot:280ms"
        cx={C}
        cy={C}
        r={DISC + 48}
        stroke="currentColor"
        stroke-width="1"
        stroke-opacity="0.16"
      />

      {axes.map((line) => (
        <line
          class="hud-cell"
          style={line.boot}
          x1={line.x1}
          y1={line.y1}
          x2={line.x2}
          y2={line.y2}
          stroke="currentColor"
          stroke-width="1"
          stroke-opacity="0.1"
        />
      ))}

      {graduations.map((tick) => (
        <line
          class="hud-cell"
          style={tick.boot}
          x1={tick.x1}
          y1={tick.y1}
          x2={tick.x2}
          y2={tick.y2}
          stroke="currentColor"
          stroke-width={tick.major ? 1.4 : 1}
          stroke-opacity={tick.major ? 0.4 : 0.18}
        />
      ))}

      {brackets.map((part) =>
        part.type === "arc" ? (
          <path
            class="hud-cell"
            style={part.boot}
            d={part.d}
            stroke="currentColor"
            stroke-width="1.4"
            stroke-opacity="0.12"
          />
        ) : (
          <line
            class="hud-cell"
            style={part.boot}
            x1={part.x1}
            y1={part.y1}
            x2={part.x2}
            y2={part.y2}
            stroke="currentColor"
            stroke-width="1.4"
            stroke-opacity="0.12"
          />
        ),
      )}
    </g>

    <g class="hud-meter">
      {meterDots.map((dot) => (
        <circle
          class="hud-cell"
          style={dot.boot}
          cx={dot.x}
          cy={dot.y}
          r="3.4"
          fill="currentColor"
          fill-opacity="0.1"
        />
      ))}
      {meterDots.map((dot) => (
        <circle
          class="hud-meter-lit"
          cx={dot.x}
          cy={dot.y}
          r="3.4"
          fill="var(--brand)"
          style={`--t:${dot.t}`}
        />
      ))}
    </g>

    <g class="hud-spin-slow">
      {segments.map((segment) => (
        <path
          class="hud-cell"
          style={segment.boot}
          d={segment.d}
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.12"
          stroke-linecap="round"
        />
      ))}
    </g>

    <g class="hud-spin-reverse">
      <circle
        class="hud-cell"
        style="--boot:520ms"
        cx={C}
        cy={C}
        r="458"
        stroke="currentColor"
        stroke-width="1"
        stroke-opacity="0.22"
        stroke-dasharray="3 10"
      />
    </g>

    <g class="hud-spin-outer">
      {outerArcs.map((item) => (
        <>
          <path
            class="hud-cell"
            style={item.boot}
            d={item.d}
            stroke="currentColor"
            stroke-width="1.2"
            stroke-opacity="0.26"
          />
          {item.caps.map((cap) => (
            <circle
              class="hud-cell"
              style={cap.boot}
              cx={cap.x}
              cy={cap.y}
              r="2.4"
              fill="currentColor"
              fill-opacity="0.35"
            />
          ))}
        </>
      ))}
      {cells.map((cell) => (
        <line
          class="hud-cell"
          style={cell.boot}
          x1={cell.x1}
          y1={cell.y1}
          x2={cell.x2}
          y2={cell.y2}
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.28"
        />
      ))}
    </g>

    <g class="hud-sweep">
      {sweep.map((part) => (
        <path
          d={part.d}
          stroke="var(--brand)"
          stroke-width="2.2"
          stroke-opacity={part.opacity}
          stroke-linecap="round"
        />
      ))}
    </g>
  </svg>
</div>

<script>
  const hud = document.querySelector<HTMLElement>("[data-orb-hud]");

  // ?kill=hud — see CrashProbe. Takes the ring off the page entirely, not just
  // its level animation, so the ~360 SVG nodes go with it.
  if (document.documentElement.dataset.kill?.split(",").includes("hud")) {
    hud?.remove();
  } else if (
    hud &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    let target = 0;
    let eased = 0;
    let raf = 0;

    // The dots of the level gauge, ordered the way they light: from 6 o'clock
    // outwards. Their thresholds never change, so they are read once.
    //
    // This used to be one custom property on the container and an
    // `opacity: clamp(0, calc((var(--hud-level) - var(--t)) * 24), 1)` on each
    // dot. That is a lovely declarative way to write a bar graph and it is
    // ruinous: a custom property is inherited, so rewriting it once a frame
    // invalidated style on every node in the ring — ~360 of them — and repainted
    // the whole SVG at 60fps for the length of the call. SVG paints in the GPU
    // process, which is why it killed the tab on iOS about twenty seconds in
    // while the main thread sat at a comfortable 60fps and JS saw nothing at
    // all. Toggling a class on the handful of dots that actually cross the
    // level each frame does the same job and usually touches nothing.
    const dots = [...hud.querySelectorAll<SVGElement>(".hud-meter-lit")]
      .map((el) => ({ el, t: Number(el.style.getPropertyValue("--t")) }))
      .sort((a, b) => a.t - b.t);
    const sweep = hud.querySelector<SVGElement>(".hud-sweep");

    let lit = 0;
    let glow = -1;
    const frame = () => {
      eased += (target - eased) * 0.14;

      while (lit < dots.length && dots[lit].t < eased) {
        dots[lit].el.classList.add("is-on");
        lit += 1;
      }
      while (lit > 0 && dots[lit - 1].t >= eased) {
        lit -= 1;
        dots[lit].el.classList.remove("is-on");
      }

      // The sweep is a single group, so it can stay continuous — but in ten
      // steps rather than every frame, which its 400ms transition smooths out.
      const step = Math.round(eased * 10) / 10;
      if (sweep && step !== glow) {
        glow = step;
        sweep.style.opacity = String(0.35 + step * 0.65);
      }

      raf = requestAnimationFrame(frame);
    };

    // Only metered while a call is up; off-call the ring holds its resting look.
    const setLive = (live: boolean) => {
      hud.classList.toggle("is-live", live);
      if (live && !raf) {
        raf = requestAnimationFrame(frame);
      } else if (!live && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
        target = 0;
        eased = 0;
        for (const dot of dots) dot.el.classList.remove("is-on");
        lit = 0;
        glow = -1;
        sweep?.style.removeProperty("opacity");
      }
    };

    window.addEventListener("orb-level", (event) => {
      target = (event as CustomEvent<number>).detail ?? 0;
    });
    window.addEventListener("orb-live", (event) => {
      setLive((event as CustomEvent<boolean>).detail === true);
    });
    window.addEventListener(
      "pagehide",
      () => {
        if (raf) cancelAnimationFrame(raf);
      },
      { once: true },
    );
  }
</script>

<style>
  /* The container brightens for the call, not for the syllable. The lit marks
     below are what follow the voice, and they do it by class rather than by an
     inherited custom property — nothing in this subtree reads a per-frame
     value any more, which is the whole point. */
  .orb-hud {
    opacity: 0.62;
    transition: opacity 240ms linear;
  }

  .orb-hud.is-live {
    opacity: 1;
  }

  .orb-hud svg > g {
    transform-box: view-box;
    transform-origin: 50% 50%;
  }

  /* Each mark is addressed, blinks four times, then locks. step-end is per
     keyframe interval — steps() on the whole animation was collapsing the
     blink into a single pop. */
  .hud-cell {
    animation: hud-cell-in 480ms step-end both;
    animation-delay: var(--boot, 0ms);
  }

  @keyframes hud-cell-in {
    0%,
    6% {
      opacity: 0;
    }
    7%,
    13% {
      opacity: 1;
    }
    14%,
    20% {
      opacity: 0;
    }
    21%,
    27% {
      opacity: 1;
    }
    28%,
    34% {
      opacity: 0;
    }
    35%,
    41% {
      opacity: 1;
    }
    42%,
    48% {
      opacity: 0;
    }
    49%,
    55% {
      opacity: 1;
    }
    56%,
    64% {
      opacity: 0.12;
    }
    65%,
    100% {
      opacity: 1;
    }
  }

  /* No will-change: these are permanently rotating decorative groups, so the
     promotion is never a hint about something *about* to change — it just
     parks four composited layers in the GPU process for the whole page life,
     next to the orb's own WebGL surface. */
  .hud-spin-slow,
  .hud-spin-reverse,
  .hud-spin-outer,
  .hud-sweep {
    animation-name: hud-rotate;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .hud-spin-slow {
    animation-duration: 72s;
  }

  .hud-spin-reverse {
    animation-duration: 48s;
    animation-direction: reverse;
  }

  .hud-spin-outer {
    animation-duration: 104s;
    animation-direction: reverse;
  }

  /* A dot lights once the level passes its position on the track — a hard on,
     which is what the old multiplier was approximating anyway. The class is put
     on by the rAF loop above; see the note there for why it is not a calc(). */
  .hud-meter-lit {
    opacity: 0;
  }

  .orb-hud.is-live .hud-meter-lit.is-on {
    opacity: 1;
  }

  /* The sweep is the only part that reads as "scanning", so it stays hidden
     until there is something to scan. Its live opacity is written inline by the
     rAF loop; this is the resting value it fades up from. */
  .hud-sweep {
    animation-duration: 9s;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .orb-hud.is-live .hud-sweep {
    opacity: 0.35;
  }

  @keyframes hud-rotate {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hud-cell,
    .hud-spin-slow,
    .hud-spin-reverse,
    .hud-spin-outer,
    .hud-sweep {
      animation: none;
    }

    .hud-sweep {
      display: none;
    }
  }
</style>
