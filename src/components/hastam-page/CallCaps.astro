---
// The default limit on routine calls for one patient: 2 a day, 5 a week (the
// product default, hastam-app call-policy.ts). No patient and no clock time
// here, so it is tagged as a default setting rather than as sample data.
import type { HastamOutboundMockCopy } from "@/i18n/page-types/hastam";

interface Props {
  copy: HastamOutboundMockCopy["caps"];
}

const { copy } = Astro.props;
const rows = [
  { label: copy.day, count: 2 },
  { label: copy.week, count: 5 },
];
---

<div class="flex min-h-[13.5rem] w-full flex-col">
  <div class="flex items-center justify-between gap-3">
    <span class="data-label">{copy.label}</span>
    <span class="data-label inline-flex h-6 shrink-0 items-center rounded-full border border-border-strong px-2">
      {copy.setting}
    </span>
  </div>
  <dl class="my-auto flex flex-col gap-2 pt-4">
    {
      rows.map((row) => (
        <div class="flex items-center justify-between gap-3 rounded-tile border border-border bg-background px-3 py-3">
          <dt class="text-paragraph-sm text-foreground">{row.label}</dt>
          <dd class="flex items-center gap-3">
            <span class="flex gap-1.5" aria-hidden="true">
              {Array.from({ length: row.count }, () => (
                <span class="size-2 rounded-full bg-foreground" />
              ))}
            </span>
            <span class="data-value w-3 text-right">{row.count}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</div>
