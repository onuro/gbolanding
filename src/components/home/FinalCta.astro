---
import {
  ArrowRight,
  Check,
  Languages,
  Lock,
  MessageSquare,
  ShieldCheck,
} from "lucide-react";

import BlinkText from "@/components/BlinkText";
import ProductPicker from "@/components/home/cta-parts/ProductPicker.astro";
import WaitlistForm from "@/components/home/WaitlistForm.astro";
import type { Locale } from "@/i18n/config";
import { pathFor } from "@/i18n/routes";
import type { Messages } from "@/i18n/types";

type Product = "kollektor" | "intelval" | "hastam" | "fountible" | "custom";

interface Props {
  locale: Locale;
  messages: Messages;
  /** Base of the lead's "source" field, so a lead says which page sent it. */
  source?: string;
  /** Product pill that is already picked when the page loads. */
  defaultProduct?: Product;
  /**
   * Replaces the three company-wide assurances. A product page passes its own,
   * so a Hastam visitor is not shown a line about Kollektor.
   */
  assurances?: readonly string[];
  /**
   * The statement beside the form. A product page passes its own, so it does
   * not close on the home page's headline. Each falls back to `finalCta`.
   */
  title?: string;
  description?: string;
  /** Label of the link under the statement. It always goes to the solutions. */
  secondaryCta?: string;
  /** Per-product notes for the pills (see ProductPicker). */
  productNotes?: Partial<Record<Product, string>>;
}

const {
  locale,
  messages,
  source,
  defaultProduct,
  assurances: pageAssurances,
  title = messages.finalCta.title,
  description = messages.finalCta.description,
  secondaryCta = messages.finalCta.secondaryCta,
  productNotes,
} = Astro.props;

// Unique per render so ids inside the card never collide if this section
// appears more than once.
const idBase = Math.random().toString(36).slice(2, 8);
// Anchored to the home page: on /about a bare "#solutions" has no target.
const solutionsHref = `${pathFor("home", locale)}#solutions`;

const ui =
  locale === "tr"
    ? {
        team: "Bize ulaşın",
        privacy: "E-postanızı yalnızca bu talep için kullanırız. Paylaşmayız.",
        assurancesLabel: "Neden GBO Vision",
        kvkk: "KVKK’ye uygun geliştirme süreci",
        languages: "Türkçe, İngilizce, Almanca",
        live: "Analizden çalışan ürüne",
      }
    : {
        team: "Contact us",
        privacy: "We use your email only for this request. We never share it.",
        assurancesLabel: "Why GBO Vision",
        kvkk: "KVKK-compliant development process",
        languages: "Turkish, English, German",
        live: "From analysis to working software",
      };

const icons = [ShieldCheck, Languages, MessageSquare];
const assurances = (pageAssurances ?? [ui.kvkk, ui.languages, ui.live]).map(
  (label, index) => ({
    label,
    // A page's own lines are not about compliance or languages, so they all
    // take the neutral mark rather than borrowing a meaning from the icon.
    Icon: pageAssurances ? Check : icons[index % icons.length],
  }),
);
---

<section
  id="demo"
  aria-labelledby="final-cta-heading"
  class="bg-background"
  data-reveal-root
>
  <div class="frame frame-cross border-b border-border">
    <div class="grid lg:grid-cols-12">
      {/* Statement */}
      <div class="flex flex-col lg:col-span-6" data-reveal>
        <div class="flex-1 px-5 pt-(--head-top) pb-12 sm:px-8 lg:px-12 lg:pb-16">
          <p class="eyebrow">
            <span class="eyebrow-mark" aria-hidden="true"></span>
            {messages.finalCta.eyebrow}
          </p>
          <h2
            id="final-cta-heading"
            class="mt-4 max-w-[30rem] text-balance text-title-h2 text-foreground"
          >
            <BlinkText client:visible text={title} />
          </h2>
          <p
            class="mt-5 max-w-md text-pretty text-paragraph-md text-muted-foreground"
          >
            {description}
          </p>

          <a
            href={solutionsHref}
            class="button button-secondary group mt-8 w-fit"
          >
            {secondaryCta}
            <ArrowRight
              aria-hidden="true"
              focusable="false"
              className="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
              strokeWidth={1.5}
            />
          </a>
        </div>

        <ul
          class="flex flex-wrap gap-x-6 gap-y-3 px-5 pb-10 sm:px-8 lg:px-12 lg:pb-14"
          aria-label={ui.assurancesLabel}
        >
          {
            assurances.map(({ label, Icon }) => (
              <li class="inline-flex items-center gap-2 text-[0.8125rem] leading-5 text-muted-foreground">
                <Icon
                  className="size-4 shrink-0 text-foreground/70"
                  strokeWidth={1.5}
                  aria-hidden="true"
                />
                {label}
              </li>
            ))
          }
        </ul>
      </div>

      {/* Match the product cards: a soft shell around an inset content panel. */}
      <div
        class="flex flex-col justify-center p-3 sm:p-4 lg:col-span-6 lg:py-6 lg:pr-6 lg:pl-0"
        data-reveal
      >
        <div class="soft-card w-full p-2 pt-6 sm:pt-8">
          <div class="flex items-center gap-3 px-3 sm:px-6">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-background text-muted-foreground">
              <MessageSquare className="size-5" strokeWidth={1.5} aria-hidden="true" />
            </span>
            <p class="text-title-h3 text-foreground">{ui.team}</p>
          </div>

          <div class="mt-6 rounded-card bg-background px-4 py-5 sm:p-6">
            <WaitlistForm
              locale={locale}
              messages={messages}
              idBase={idBase}
              source={source}
            >
              <ProductPicker
                slot="before"
                locale={locale}
                defaultProduct={defaultProduct}
                notes={productNotes}
              />
            </WaitlistForm>
            <p class="mt-4 flex items-center gap-2 text-paragraph-xs text-tertiary-foreground">
              <Lock className="size-3.5 shrink-0" strokeWidth={1.5} aria-hidden="true" />
              {ui.privacy}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
