---
import { ArrowRight } from "lucide-react";

import WaitlistForm from "@/components/home/WaitlistForm.astro";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
---

<section
  id="demo"
  aria-labelledby="final-cta-heading"
  class="scroll-mt-20 border-b border-border bg-background"
>
  <div class="relative mx-auto w-full max-w-[83.75rem] overflow-hidden border-x border-border">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-32 left-1/4 size-80 bg-brand/5 blur-3xl"
    ></div>

    <div class="relative grid lg:grid-cols-12">
      <div class="px-6 py-12 sm:px-8 sm:py-16 lg:col-span-7 lg:px-12 lg:py-20">
        <p
          class="inline-flex items-center gap-2 font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground"
        >
          <span aria-hidden="true" class="size-1.5 bg-brand"></span>
          {messages.finalCta.eyebrow}
        </p>
        <h2
          id="final-cta-heading"
          class="mt-5 max-w-3xl text-balance text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl"
        >
          {messages.finalCta.title}
        </h2>
        <p
          class="mt-5 max-w-xl text-pretty text-base leading-7 text-muted-foreground sm:text-lg"
        >
          {messages.finalCta.description}
        </p>
      </div>

      <div
        class="flex flex-col justify-center border-t border-border bg-card/30 px-6 py-12 sm:px-8 lg:col-span-5 lg:border-t-0 lg:border-l lg:px-10 lg:py-16"
      >
        <div class="pb-6">
          <WaitlistForm locale={locale} messages={messages} />
        </div>

        <a
          href="#solutions"
          class="group mt-1 inline-flex min-h-11 w-fit items-center gap-2 text-sm font-medium text-foreground underline-offset-4 transition-colors hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
        >
          {messages.finalCta.secondaryCta}
          <ArrowRight
            aria-hidden="true"
            focusable="false"
            className="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
            strokeWidth={1.5}
          />
        </a>
      </div>
    </div>
  </div>
</section>
