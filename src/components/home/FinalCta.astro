---
import { ArrowRight, Languages, Lock, MessageSquare, ShieldCheck } from "lucide-react";

import BlinkText from "@/components/BlinkText";
import ProductPicker from "@/components/home/cta-parts/ProductPicker.astro";
import WaitlistForm from "@/components/home/WaitlistForm.astro";
import type { Locale } from "@/i18n/config";
import { pathFor } from "@/i18n/routes";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;

// Unique per render so ids inside the card never collide if this section
// appears more than once.
const idBase = Math.random().toString(36).slice(2, 8);
// Anchored to the home page: on /about a bare "#solutions" has no target.
const solutionsHref = `${pathFor("home", locale)}#solutions`;

const ui =
  locale === "tr"
    ? {
        team: "Bize ulaşın",
        privacy: "E-postanızı yalnızca bu talep için kullanırız. Paylaşmayız.",
        assurancesLabel: "Neden GBO Vision",
        // Backed for Kollektor only (kollektorDeep FAQ + guardrails), so it
        // names the product rather than reading as a company-wide badge.
        kvkk: "Kollektor KVKK uyumlu",
        languages: "Türkçe, İngilizce, Almanca",
        live: "Demo, işinize göre",
      }
    : {
        team: "Contact us",
        privacy: "We use your email only for this request. We never share it.",
        assurancesLabel: "Why GBO Vision",
        kvkk: "Kollektor is KVKK compliant",
        languages: "Turkish, English, German",
        live: "A demo shaped to your work",
      };

const assurances = [
  { label: ui.kvkk, Icon: ShieldCheck },
  { label: ui.languages, Icon: Languages },
  { label: ui.live, Icon: MessageSquare },
];
---

<section
  id="demo"
  aria-labelledby="final-cta-heading"
  class="scroll-mt-20 border-b border-border bg-background"
  data-reveal-root
>
  <div class="mx-auto w-full max-w-[83.75rem] border-x border-border">
    <div class="grid lg:grid-cols-12">
      {/* Statement */}
      <div class="flex flex-col lg:col-span-6" data-reveal>
        <div class="flex-1 px-6 py-14 sm:px-8 sm:py-16 lg:px-12 lg:py-24">
          <p class="eyebrow">
            <span class="eyebrow-mark" aria-hidden="true"></span>
            {messages.finalCta.eyebrow}
          </p>
          <h2
            id="final-cta-heading"
            class="mt-5 max-w-2xl text-balance text-title-h2 text-foreground"
          >
            <BlinkText client:visible text={messages.finalCta.title} />
          </h2>
          <p
            class="mt-6 max-w-xl text-pretty text-paragraph-lg text-muted-foreground"
          >
            {messages.finalCta.description}
          </p>

          <a
            href={solutionsHref}
            class="group mt-8 inline-flex min-h-11 w-fit items-center gap-2 text-label-sm text-foreground underline-offset-4 transition-colors hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
          >
            {messages.finalCta.secondaryCta}
            <ArrowRight
              aria-hidden="true"
              focusable="false"
              className="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
              strokeWidth={1.5}
            />
          </a>
        </div>

        <ul
          class="flex flex-wrap gap-x-6 gap-y-3 border-t border-border px-6 py-5 sm:px-8 lg:px-12"
          aria-label={ui.assurancesLabel}
        >
          {
            assurances.map(({ label, Icon }) => (
              <li class="inline-flex items-center gap-2 text-label-xs text-muted-foreground">
                <Icon
                  className="size-4 shrink-0 text-brand"
                  strokeWidth={1.5}
                  aria-hidden="true"
                />
                {label}
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="flex flex-col justify-center border-t border-border px-6 py-14 sm:px-8 sm:py-16 lg:col-span-6 lg:border-t-0 lg:border-l lg:px-12 lg:py-24"
        data-reveal
      >
        <div class="w-full max-w-md">
          <p class="text-title-h3 text-foreground">{ui.team}</p>

          <div class="mt-8">
            <WaitlistForm locale={locale} messages={messages} idBase={idBase}>
              <ProductPicker slot="before" locale={locale} />
            </WaitlistForm>
          </div>

          <p class="mt-3 flex items-center gap-2 text-caption text-tertiary-foreground">
            <Lock className="size-3.5 shrink-0" strokeWidth={1.5} aria-hidden="true" />
            {ui.privacy}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
