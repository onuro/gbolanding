---
import ProductVideo from "@/components/home/ProductVideo.astro";
import HastamBookingCard from "@/components/home/solutions-mocks/HastamBookingCard.astro";
import MockWell from "@/components/home/solutions-mocks/MockWell.astro";
import { ArrowUpRight, Stethoscope } from "lucide-react";
import hastamImage from "@/assets/editorial/hastam-doctor-consultation.png";
import type { Locale } from "@/i18n/config";
import { pathFor } from "@/i18n/routes";
import type { HastamSolutionMessage } from "@/i18n/types";

interface Props {
  locale: Locale;
  product: HastamSolutionMessage;
}

const { locale, product } = Astro.props;
---

<article
  id="hastam"
  aria-labelledby="hastam-title"
  class="group relative overflow-hidden bg-background"
  data-reveal-root
>
  <div class="grid pt-6 lg:grid-cols-2 xl:grid-cols-12">
    <div class="bg-background p-3 lg:order-2 lg:flex xl:col-span-5">
      {/* The exchange sits over the patient, so the doctor stays in view. */}
      <MockWell
        reveal
        align="start"
        class="w-full min-h-[28rem] pt-40 sm:min-h-[30rem] lg:min-h-[34rem] lg:flex-1"
      >
        <Fragment slot="media">
          <ProductVideo
            image={hastamImage}
            label={product.imageAlt}
            widths={[480, 768, 1120, 1536]}
            sizes="(min-width: 1340px) 534px, (min-width: 1280px) calc(41.67vw - 24px), (min-width: 1024px) calc(50vw - 24px), calc(100vw - 24px)"
            position="58% center"
            sources={[{ src: "/media/hastam-doctor-consultation-960.mp4", type: "video/mp4" }]}
          />
        </Fragment>
        <HastamBookingCard locale={locale} />
      </MockWell>
    </div>

    <div class="flex flex-col bg-background px-5 py-8 sm:px-8 sm:py-10 lg:px-12 lg:py-12 xl:col-span-7">
      <div data-reveal>
        <div class="flex items-start justify-between gap-6">
          <div class="min-w-0">
            <p class="mb-3 text-label-sm text-tertiary-foreground">
              {product.eyebrow}
            </p>
            <h3 id="hastam-title" class="text-title-h2">
              {product.title}
            </h3>
          </div>
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-foreground/[0.045] text-foreground/70">
            <Stethoscope aria-hidden="true" className="size-6" strokeWidth={1.5} />
          </span>
        </div>
        <p class="mt-6 max-w-xl text-title-h4">
          {product.headline}
        </p>
        <p class="mt-5 max-w-xl text-paragraph-md text-muted-foreground">
          {product.description}
        </p>
        <p class="mt-5 max-w-xl text-paragraph-sm text-muted-foreground">
          {product.support}
        </p>
      </div>
    </div>
  </div>

  <ol class="grid gap-3 border-t border-border p-3 md:grid-cols-3">
    {product.steps.map((step, index) => (
      <li>
        <div class="h-full rounded-tile bg-card p-3 shadow-card dark:bg-foreground/[0.035] dark:shadow-none sm:p-5">
          <div class="mb-5" aria-hidden="true">
            <span class="data-label tabular-nums">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
          <h4 class="text-title-h5">{step.title}</h4>
          <p class="mt-3 max-w-sm text-paragraph-sm text-muted-foreground">
            {step.description}
          </p>
        </div>
      </li>
    ))}
  </ol>

  {/* The demo request, and beside it the way to Hastam's own page. */}
  <div class="relative flex flex-wrap items-center gap-1.5 px-3 pt-2 pb-5">
    <a href="#demo" data-demo-product="hastam" class="button button-primary group/row sm:rounded-[1.25rem_5px_5px_1.25rem]">
      {product.cta}
      <ArrowUpRight
        aria-hidden="true"
        className="size-3.5 shrink-0 text-current transition-transform group-hover/row:translate-x-0.5 group-hover/row:-translate-y-0.5"
        strokeWidth={1.5}
      />
    </a>
    <a
      href={pathFor("hastam", locale)}
      class="button button-primary group/row sm:rounded-[5px_1.25rem_1.25rem_5px]"
    >
      {product.pageCta}
      <ArrowUpRight
        aria-hidden="true"
        className="size-3.5 shrink-0 text-current transition-transform group-hover/row:translate-x-0.5 group-hover/row:-translate-y-0.5"
        strokeWidth={1.5}
      />
    </a>
  </div>
</article>
