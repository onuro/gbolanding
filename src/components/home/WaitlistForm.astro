---
import { ArrowRight, CheckCircle2, Loader2, Mail } from "lucide-react";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
  /** Keeps ids unique when the form renders more than once on a page. */
  idBase?: string;
  /** Base of the hidden "source" field. A product picker may append ":<product>". */
  source?: string;
}

const {
  locale,
  messages,
  idBase = Math.random().toString(36).slice(2, 8),
  source = "homepage",
} = Astro.props;
const inputId = `waitlist-email-${locale}-${idBase}`;
const errorId = `waitlist-error-${locale}-${idBase}`;
const hasLead = Astro.slots.has("before");

const ui =
  locale === "tr"
    ? { example: "adiniz@sirketiniz.com" }
    : { example: "you@company.com" };
---

<div data-waitlist-root>
  <form
    action="/api/waitlist"
    method="post"
    class="w-full"
    novalidate
    data-waitlist-form
    data-required-error={messages.signup.errors.required}
    data-invalid-error={messages.signup.errors.invalid}
    data-submission-error={messages.signup.errors.submission}
  >
    <slot name="before" />

    <input
      class="absolute -left-[9999px] size-px"
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="source" value={source} data-source-base={source} />

    <div class:list={[hasLead && "mt-6"]}>
      <label class="block text-label-sm text-foreground" for={inputId}>
        {messages.signup.placeholder}
      </label>

      <div class="group relative mt-3" data-input-shell>
        <Mail
          aria-hidden="true"
          strokeWidth={1.5}
          className="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-tertiary-foreground transition-colors group-focus-within:text-foreground group-data-[invalid]:text-danger"
        />
        <input
          id={inputId}
          name="email"
          type="email"
          required
          placeholder={ui.example}
          autocomplete="email"
          inputmode="email"
          aria-describedby={errorId}
          class="h-11 w-full rounded-full border border-border-strong bg-background py-2 pl-11 pr-4 text-paragraph-sm text-foreground shadow-card transition-colors placeholder:text-faint-foreground disabled:cursor-not-allowed disabled:opacity-60 aria-[invalid=true]:border-danger"
          data-email-input
        />
      </div>

      <p
        id={errorId}
        class="min-h-5 px-1 pt-1.5 text-left text-caption text-danger"
        role="alert"
        aria-live="polite"
        data-form-error
      >
      </p>

      <button
        type="submit"
        class="button button-primary group/submit mt-1.5 w-full"
      >
        <span class="inline-flex items-center gap-2" data-idle-label>
          <span>{messages.finalCta.primaryCta}</span>
          <ArrowRight
            aria-hidden="true"
            strokeWidth={1.5}
            className="size-4 transition-transform group-hover/submit:translate-x-0.5"
          />
        </span>
        <span class="hidden items-center gap-2" data-loading-label>
          <Loader2 aria-hidden="true" className="size-4 animate-spin" />
          <span>{messages.signup.sending}</span>
        </span>
      </button>
    </div>
  </form>

  <div
    class="hidden min-h-64 w-full flex-col items-center justify-center gap-4 rounded-tile border border-brand-line bg-brand-soft px-6 py-8 text-center outline-none"
    role="status"
    aria-live="polite"
    tabindex="-1"
    data-form-success
  >
    <span
      class="grid size-11 shrink-0 place-items-center rounded-full border border-brand-line bg-background text-brand"
    >
      <CheckCircle2 aria-hidden="true" strokeWidth={1.5} className="size-5" />
    </span>
    <span class="block">
      <strong class="block text-title-h6 text-foreground">
        {messages.signup.successTitle}
      </strong>
      <span
        class="mx-auto mt-1.5 block max-w-xs text-pretty text-paragraph-sm text-muted-foreground"
      >
        {messages.signup.successBody}
      </span>
    </span>
  </div>
</div>

<script>
  // Bundled once per page, so every instance of the form is enhanced by a
  // single pass instead of one inline copy per render.
  const FIELDS = ["email", "locale", "source", "company"];

  function enhance(form: HTMLFormElement) {
    if (form.dataset.enhanced === "true") return;
    form.dataset.enhanced = "true";

    const root = form.closest<HTMLElement>("[data-waitlist-root]");
    const input = form.querySelector<HTMLInputElement>("[data-email-input]");
    const shell = form.querySelector<HTMLElement>("[data-input-shell]");
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const idleLabel = form.querySelector<HTMLElement>("[data-idle-label]");
    const loadingLabel = form.querySelector<HTMLElement>("[data-loading-label]");
    const error = form.querySelector<HTMLElement>("[data-form-error]");
    const success = root?.querySelector<HTMLElement>("[data-form-success]");

    if (
      !root ||
      !input ||
      !shell ||
      !button ||
      !idleLabel ||
      !loadingLabel ||
      !error ||
      !success
    ) {
      return;
    }

    const fieldsets = [...form.querySelectorAll("fieldset")];

    const setError = (message: string) => {
      error.textContent = message;
      input.setAttribute("aria-invalid", message ? "true" : "false");
      shell.toggleAttribute("data-invalid", Boolean(message));
    };

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      input.disabled = busy;
      for (const fieldset of fieldsets) fieldset.disabled = busy;
      if (busy) form.setAttribute("aria-busy", "true");
      else form.removeAttribute("aria-busy");
      idleLabel.classList.toggle("hidden", busy);
      loadingLabel.classList.toggle("hidden", !busy);
      loadingLabel.classList.toggle("inline-flex", busy);
    };

    input.addEventListener("input", () => {
      if (error.textContent) setError("");
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!input.value.trim()) {
        setError(form.dataset.requiredError ?? "");
        input.focus();
        return;
      }

      if (!input.validity.valid) {
        setError(form.dataset.invalidError ?? "");
        input.focus();
        return;
      }

      setError("");
      // Only the fields the API reads; the product pill travels inside source.
      const data = new FormData(form);
      const values: Record<string, string> = {};
      for (const key of FIELDS) {
        const value = data.get(key);
        if (typeof value === "string") values[key] = value;
      }
      setBusy(true);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(values),
        });

        if (!response.ok) throw new Error("waitlist_failed");

        form.classList.add("hidden");
        success.classList.remove("hidden");
        success.classList.add("flex");
        success.focus();
      } catch {
        setError(form.dataset.submissionError ?? "");
        setBusy(false);
      }
    });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>(
    "[data-waitlist-form]",
  )) {
    enhance(form);
  }
</script>
