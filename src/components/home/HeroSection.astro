---
import { ArrowDownRight, ArrowRight } from "lucide-react";
import BlinkText from "@/components/BlinkText";
import { LogoShape } from "@/components/logo";
import OrbHud from "@/components/hero-orb/OrbHud.astro";
import { StudyOrbGradient } from "@/components/hero-orb/StudyOrbGradient";
import { VoiceButton } from "@/components/hero-orb/VoiceButton";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
---

<section
  class="mx-auto w-full max-w-[83.75rem] border-x border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="grid grid-cols-1 xl:grid-cols-12">
    <div
      class="relative flex min-h-[34rem] flex-col justify-between overflow-hidden border-b border-border px-5 py-8 sm:min-h-[40rem] sm:px-8 sm:py-10 lg:px-12 lg:py-12 xl:col-span-7 xl:min-h-[43rem] xl:border-b-0"
    >
      <div
        class="pointer-events-none absolute inset-0 hidden opacity-40"
        style="background-image: linear-gradient(to right, var(--grid-line-faint) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line-faint) 1px, transparent 1px); background-size: 64px 64px;"
        aria-hidden="true"
      >
      </div>
      <svg
        class="pointer-events-none absolute -right-24 -top-20 hidden h-[24rem] w-[30rem] text-muted-foreground opacity-[0.15]"
        viewBox="0 0 544 432"
        fill="none"
        aria-hidden="true"
      >
        <path d="M92 72H244L292 120H452" stroke="currentColor" />
        <path d="M52 152H180L220 192H492" stroke="currentColor" />
        <path d="M76 360H228L276 312H468" stroke="currentColor" />
        <path d="M132 264H492" stroke="currentColor" />
        <path d="M292 48V384" stroke="currentColor" stroke-dasharray="2 10" />
        <rect x="220" y="120" width="144" height="144" stroke="currentColor" />
        <circle cx="292" cy="192" r="42" stroke="currentColor" />
        <circle cx="292" cy="192" r="72" stroke="currentColor" />
        <circle cx="292" cy="192" r="3" fill="currentColor" />
        <circle cx="92" cy="72" r="3.5" stroke="currentColor" />
        <circle cx="52" cy="152" r="3.5" stroke="currentColor" />
        <circle cx="76" cy="360" r="3.5" stroke="currentColor" />
        <circle cx="492" cy="152" r="3.5" fill="currentColor" />
        <circle cx="492" cy="264" r="3.5" stroke="currentColor" />
        <circle cx="468" cy="360" r="3.5" fill="currentColor" />
      </svg>

      <div class="relative flex items-start justify-between gap-6">
        <p
          class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground"
        >
          <span class="size-1.5 rounded-full bg-foreground/30" aria-hidden="true"></span>
          {messages.hero.eyebrow}
        </p>
        <span
          class="hidden font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/30 sm:block"
          aria-hidden="true"
        >
          GBO / 01
        </span>
      </div>

      <div class="relative mt-10 max-w-3xl sm:mt-16">
        <LogoShape
          glow={false}
          aria-hidden="true"
          focusable="false"
          className="mb-8 h-16 w-auto text-foreground sm:h-20"
        />
        <h1
          id="hero-title"
          class="text-balance text-[clamp(2.8rem,7vw,4.5rem)] font-medium leading-[0.92] tracking-[-0.055em]"
        >
          <BlinkText
            client:idle
            priority
            text={messages.hero.titleLead}
            className="block text-foreground"
            timingConfig={{ fadeTime: 0.33, randomHoldMax: 0.4, blinkTimeMax: 0.72 }}
          />
          <BlinkText
            client:idle
            priority
            text={messages.hero.titleAccent}
            className="mt-2 block text-foreground"
            delay={0.45}
            timingConfig={{ fadeTime: 0.36, randomHoldMax: 0.48, blinkTimeMax: 0.84 }}
          />
        </h1>
      </div>

      <div class="relative mt-14 border-t border-border pt-7">
        <p
          class="w-full text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
          {messages.hero.description}
        </p>

        <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <p
            class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-[0.14em] text-foreground/55"
          >
            <span class="relative flex size-2" aria-hidden="true">
              <span
                class="absolute inline-flex size-full rounded-full motion-safe:animate-ping bg-brand opacity-50"
              ></span>
              <span class="relative inline-flex size-2 rounded-full bg-brand"></span>
            </span>
            {messages.hero.status}
          </p>
          <div class="flex flex-wrap gap-2 sm:justify-end">
            <a
              href="#demo"
              class="group inline-flex h-11 items-center justify-center gap-2 rounded-full bg-brand px-5 text-sm font-medium text-brand-foreground outline-none transition-colors hover:bg-brand/90 focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {messages.hero.primaryCta}
              <ArrowRight
                aria-hidden="true"
                className="size-4 transition-transform group-hover:translate-x-0.5"
                strokeWidth={1.75}
              />
            </a>
            <a
              href="#solutions"
              class="group inline-flex h-11 items-center justify-center gap-2 rounded-full border border-border bg-card px-5 text-sm text-foreground outline-none transition-colors hover:border-foreground/25 hover:bg-muted focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {messages.hero.secondaryCta}
              <ArrowDownRight
                aria-hidden="true"
                className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:translate-y-0.5"
                strokeWidth={1.5}
              />
            </a>
          </div>
        </div>
      </div>

    </div>

    <div
      class="@container relative flex min-h-[34rem] items-center justify-center overflow-hidden bg-background sm:min-h-[38rem] xl:col-span-5 xl:min-h-[43rem] xl:border-l xl:border-border"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-40"
        style="background-image: radial-gradient(circle, var(--dot-grid-color) 1px, transparent 1px); background-size: 20px 20px;"
      >
      </div>
      <div
        class="relative z-10 aspect-square w-[min(100%,min(101cqmin,46rem))] shrink-0 overflow-visible"
      >
        <StudyOrbGradient client:idle className="absolute inset-0 w-full" />
        <OrbHud />
      </div>
      <VoiceButton
        client:idle
        lang={locale}
        labels={{
          idle: messages.hero.voiceIdle,
          connecting: messages.hero.voiceConnecting,
          live: messages.hero.voiceLive,
          error: messages.hero.voiceError,
          micDenied: messages.hero.voiceMicDenied,
          micMissing: messages.hero.voiceMicMissing,
          micError: messages.hero.voiceMicError,
          micInsecure: messages.hero.voiceMicInsecure,
          soundBlocked: messages.hero.voiceSoundBlocked,
        }}
      />
    </div>
  </div>
</section>
