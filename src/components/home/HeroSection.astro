---
import { ArrowDownRight, ArrowRight } from "lucide-react";
import { LogoShape } from "@/components/logo";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const visualCopy =
  locale === "tr"
    ? {
        intelligence: "GBO yapay zeka platformu",
        live: "Platform görünümü",
        modules: "Modüller",
        decisionLayer: "Karar katmanı",
        operational: "Operasyonel",
        ready: "Hazır",
        active: "Aktif",
        review: "İnceleniyor",
        data: "Veri",
        controls: "Kontroller",
      }
    : {
        intelligence: "GBO AI platform",
        live: "Platform view",
        modules: "Modules",
        decisionLayer: "Decision layer",
        operational: "Operational",
        ready: "Ready",
        active: "Active",
        review: "Review",
        data: "Data",
        controls: "Controls",
      };
---

<section
  class="mx-auto w-full max-w-[82.5rem] border-x border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="grid grid-cols-1 xl:grid-cols-12">
    <div
      class="relative flex min-h-[34rem] flex-col justify-between overflow-hidden border-b border-border px-5 py-8 sm:min-h-[40rem] sm:px-8 sm:py-10 lg:px-12 lg:py-12 xl:col-span-7 xl:min-h-[43rem] xl:border-r xl:border-b-0"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-40"
        style="background-image: linear-gradient(to right, var(--grid-line-faint) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line-faint) 1px, transparent 1px); background-size: 64px 64px;"
        aria-hidden="true"
      >
      </div>
      <svg
        class="pointer-events-none absolute -right-24 -top-20 h-[24rem] w-[30rem] text-brand opacity-[0.13]"
        viewBox="0 0 544 432"
        fill="none"
        aria-hidden="true"
      >
        <path d="M92 72H244L292 120H452" stroke="currentColor" />
        <path d="M52 152H184L224 192H492" stroke="currentColor" />
        <path d="M76 360H228L276 312H468" stroke="currentColor" />
        <path d="M132 256H492" stroke="currentColor" />
        <path d="M292 48V384" stroke="currentColor" stroke-dasharray="2 10" />
        <rect x="224.5" y="124.5" width="135" height="135" stroke="currentColor" />
        <circle cx="292" cy="192" r="42" stroke="currentColor" />
        <circle cx="292" cy="192" r="67.5" stroke="currentColor" />
        <circle cx="292" cy="192" r="3" fill="currentColor" />
        <circle cx="92" cy="72" r="3.5" stroke="currentColor" />
        <circle cx="52" cy="152" r="3.5" stroke="currentColor" />
        <circle cx="76" cy="360" r="3.5" stroke="currentColor" />
        <circle cx="492" cy="152" r="3.5" fill="currentColor" />
        <circle cx="492" cy="256" r="3.5" stroke="currentColor" />
        <circle cx="468" cy="360" r="3.5" fill="currentColor" />
      </svg>

      <div class="relative flex items-start justify-between gap-6">
        <p
          class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground"
        >
          <span class="size-1.5 bg-brand" aria-hidden="true"></span>
          {messages.hero.eyebrow}
        </p>
        <span
          class="hidden font-mono text-[9px] uppercase tracking-[0.18em] text-foreground/30 sm:block"
          aria-hidden="true"
        >
          GBO / 01
        </span>
      </div>

      <div class="relative mt-16 max-w-3xl sm:mt-20">
        <LogoShape
          glow={false}
          aria-hidden="true"
          focusable="false"
          className="mb-8 h-12 w-auto text-brand sm:h-14"
        />
        <h1
          id="hero-title"
          class="text-balance text-[clamp(2.8rem,7vw,4.5rem)] font-medium leading-[0.92] tracking-[-0.055em]"
        >
          <span class="block text-foreground">{messages.hero.titleLead}</span>
          <span class="mt-2 block text-brand-display">{messages.hero.titleAccent}</span>
        </h1>
      </div>

      <div class="relative mt-14 border-t border-border pt-7">
        <p
          class="w-full text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
          {messages.hero.description}
        </p>

        <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <p
            class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-foreground/55"
          >
            <span class="relative flex size-2" aria-hidden="true">
              <span
                class="absolute inline-flex size-full motion-safe:animate-ping bg-brand opacity-50"
              ></span>
              <span class="relative inline-flex size-2 bg-brand"></span>
            </span>
            {messages.hero.status}
          </p>
          <div class="flex flex-wrap gap-2 sm:justify-end">
            <a
              href="#demo"
              class="group inline-flex h-11 items-center justify-center gap-2 bg-brand px-5 text-sm font-medium text-brand-foreground outline-none transition-colors hover:bg-brand/90 focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {messages.hero.primaryCta}
              <ArrowRight
                aria-hidden="true"
                className="size-4 transition-transform group-hover:translate-x-0.5"
                strokeWidth={1.75}
              />
            </a>
            <a
              href="#solutions"
              class="group inline-flex h-11 items-center justify-center gap-2 border border-border bg-card px-5 text-sm text-foreground outline-none transition-colors hover:border-foreground/25 hover:bg-muted focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {messages.hero.secondaryCta}
              <ArrowDownRight
                aria-hidden="true"
                className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:translate-y-0.5"
                strokeWidth={1.5}
              />
            </a>
          </div>
        </div>
      </div>

    </div>

    <div
      class="relative flex min-h-[34rem] items-center overflow-hidden bg-card/40 p-4 sm:min-h-[38rem] sm:p-8 lg:p-10 xl:col-span-5 xl:min-h-[43rem]"
      aria-hidden="true"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background-image: radial-gradient(var(--dot-grid-color) 0.7px, transparent 0.7px); background-size: 12px 12px;"
      >
      </div>

      <div
        class="panel-shadow relative mx-auto w-full max-w-lg border border-foreground/15 bg-background"
      >
        <div
          class="flex h-11 items-center justify-between border-b border-border px-4"
        >
          <div class="flex items-center gap-2">
            <span class="size-1.5 bg-brand"></span>
            <span
              class="font-mono text-[9px] uppercase tracking-[0.2em] text-foreground/55"
            >
              {visualCopy.intelligence}
            </span>
          </div>
          <span
            class="font-mono text-[9px] uppercase tracking-[0.16em] text-foreground/30"
          >
            {visualCopy.live}
          </span>
        </div>

        <div class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[6.5rem_1fr]">
          <div class="border-r border-border">
            <div
              class="flex h-14 items-center border-b border-border px-3 font-mono text-[9px] uppercase tracking-[0.16em] text-foreground/35"
            >
              {visualCopy.modules}
            </div>
            {
              ["01", "02", "03"].map((item, index) => (
                <div
                  class:list={[
                    "flex h-16 items-center justify-between border-b border-border px-3 font-mono text-[9px]",
                    index === 0
                      ? "bg-brand/[0.07] text-brand"
                      : "text-foreground/30",
                  ]}
                >
                  {item}
                  <span
                    class:list={[
                      "size-1.5",
                      index === 0 ? "bg-brand" : "border border-foreground/20",
                    ]}
                  />
                </div>
              ))
            }
            <div class="h-36"></div>
          </div>

          <div class="min-w-0">
            <div
              class="flex h-14 items-center justify-between border-b border-border px-4"
            >
              <span
                class="font-mono text-[9px] uppercase tracking-[0.16em] text-foreground/55"
              >
                {visualCopy.decisionLayer}
              </span>
              <span
                class="border border-brand/25 bg-brand/[0.07] px-2 py-1 font-mono text-[8px] uppercase tracking-[0.14em] text-brand"
              >
                {visualCopy.operational}
              </span>
            </div>

            <div class="space-y-3 border-b border-border p-4">
              {
                [
                  { label: "Kollektor", value: visualCopy.ready, width: "86%" },
                  { label: "Intelval", value: visualCopy.active, width: "72%" },
                  {
                    label: messages.solutions.enterprise.eyebrow,
                    value: visualCopy.review,
                    width: "94%",
                  },
                ].map((item) => (
                  <div>
                    <div
                      class="mb-2 flex justify-between font-mono text-[9px] uppercase tracking-[0.1em] text-foreground/45"
                    >
                      <span>{item.label}</span>
                      <span class="text-foreground/25">{item.value}</span>
                    </div>
                    <div class="h-1 bg-foreground/[0.06]">
                      <div
                        class="h-full bg-brand/60"
                        style={`width: ${item.width};`}
                      />
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="grid grid-cols-3 border-b border-border">
              {
                [
                  { value: "ON", label: visualCopy.modules },
                  { value: "SYNC", label: visualCopy.data },
                  { value: "HITL", label: visualCopy.controls },
                ].map((item, index) => (
                  <div
                    class:list={[
                      "px-3 py-4",
                      index !== 2 ? "border-r border-border" : "",
                    ]}
                  >
                    <p class="font-mono text-lg text-foreground/80">{item.value}</p>
                    <p
                      class="mt-1 font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/30"
                    >
                      {item.label}
                    </p>
                  </div>
                ))
              }
            </div>

            <div class="relative h-24 overflow-hidden p-4">
              <div
                class="absolute inset-x-4 bottom-4 top-4 opacity-50"
                style="background-image: linear-gradient(to right, var(--grid-line-strong) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line-strong) 1px, transparent 1px); background-size: 28px 20px;"
              >
              </div>
              <div
                class="absolute right-[18%] bottom-4 left-4 h-px origin-left -rotate-[8deg] bg-brand/70"
              >
              </div>
              <div
                class="absolute right-4 bottom-[45%] left-[78%] h-px origin-left rotate-[23deg] bg-brand/70"
              >
              </div>
              <span
                class="absolute right-[12%] top-[32%] size-2 bg-brand shadow-[0_0_16px_rgba(5,221,135,0.7)]"
              ></span>
            </div>
          </div>
        </div>

        <span
          class="absolute -left-px -top-px size-2.5 border-l border-t border-brand/70"
        ></span>
        <span
          class="absolute -right-px -bottom-px size-2.5 border-r border-b border-brand/70"
        ></span>
      </div>
    </div>
  </div>
</section>
