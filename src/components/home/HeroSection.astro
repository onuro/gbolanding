---
import { ArrowDownRight, ArrowRight } from "lucide-react";
import BlinkText from "@/components/BlinkText";
import { LogoShape } from "@/components/logo";
import OrbHud from "@/components/hero-orb/OrbHud.astro";
import { StudyOrbGradient } from "@/components/hero-orb/StudyOrbGradient";
import { VoiceButton } from "@/components/hero-orb/VoiceButton";
import { HeroFacePreview } from "@/components/hero-face/HeroFacePreview";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
---

<section
  class="mx-auto w-full max-w-[83.75rem] border-x border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="grid grid-cols-1 xl:grid-cols-12">
    <div
      class="relative flex min-h-[34rem] flex-col justify-between overflow-hidden border-b border-border px-5 py-8 sm:min-h-[40rem] sm:px-8 sm:py-10 lg:px-12 lg:py-12 xl:col-span-7 xl:min-h-[43rem] xl:border-b-0"
    >
      <div class="relative flex items-start justify-between gap-6">
        <p class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true"></span>
          {messages.hero.eyebrow}
        </p>
        <span
          class="hidden font-mono text-caption text-faint-foreground sm:block"
          aria-hidden="true"
        >
          GBO / 01
        </span>
      </div>

      <div class="relative mt-10 max-w-3xl sm:mt-16">
        <LogoShape
          glow={false}
          aria-hidden="true"
          focusable="false"
          className="mb-8 h-24 w-auto text-foreground sm:h-28"
        />
        <h1
          id="hero-title"
          class="text-display text-balance"
        >
          <BlinkText
            client:idle
            priority
            text={messages.hero.titleLead}
            className="block text-foreground"
            timingConfig={{ fadeTime: 0.33, randomHoldMax: 0.4, blinkTimeMax: 0.72 }}
          />
          <BlinkText
            client:idle
            priority
            text={messages.hero.titleAccent}
            className="block text-foreground"
            delay={0.45}
            timingConfig={{ fadeTime: 0.36, randomHoldMax: 0.48, blinkTimeMax: 0.84 }}
          />
        </h1>
      </div>

      <div class="relative mt-14 border-t border-border pt-7">
        <p
          class="w-full max-w-xl text-pretty text-paragraph-md text-muted-foreground sm:text-paragraph-lg"
        >
          {messages.hero.description}
        </p>

        <div class="mt-7 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <p class="eyebrow">
            <span class="relative flex size-2" aria-hidden="true">
              <span
                class="absolute inline-flex size-full rounded-full motion-safe:animate-ping bg-brand opacity-50"
              ></span>
              <span class="relative inline-flex size-2 rounded-full bg-brand"></span>
            </span>
            {messages.hero.status}
          </p>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-3 sm:justify-end">
            <a href="#demo" class="button button-primary group">
              {messages.hero.primaryCta}
              <ArrowRight
                aria-hidden="true"
                className="size-4 transition-transform group-hover:translate-x-0.5"
                strokeWidth={1.75}
              />
            </a>
            <a href="#solutions" class="button button-secondary group">
              {messages.hero.secondaryCta}
              <ArrowDownRight
                aria-hidden="true"
                className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:translate-y-0.5"
                strokeWidth={1.5}
              />
            </a>
          </div>
        </div>
      </div>

    </div>

    <div
      class="p-3 xl:col-span-5 xl:flex xl:min-h-[43rem] xl:border-l xl:border-border"
    >
      <div
        class="orb-well @container relative flex min-h-[34rem] w-full flex-1 items-center justify-center overflow-hidden rounded-[24px] sm:min-h-[38rem]"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-40"
          style="background-image: radial-gradient(circle, var(--dot-grid-color) 1px, transparent 1px); background-size: 20px 20px;"
        >
        </div>
        <div
          class="relative z-10 aspect-square w-[min(100%,min(101cqmin,46rem))] shrink-0 overflow-visible"
        >
          <StudyOrbGradient
            client:idle
            theme="dark"
            className="absolute inset-0 w-full"
          />
          <OrbHud />
        </div>
        {/* DEV-only particle-face preview: /?face=1 (&talk=1). Never rendered in production. */}
        {import.meta.env.DEV && <HeroFacePreview client:only="react" />}
        <VoiceButton
          client:idle
          lang={locale}
          labels={{
            idle: messages.hero.voiceIdle,
            connecting: messages.hero.voiceConnecting,
            live: messages.hero.voiceLive,
            error: messages.hero.voiceError,
            micDenied: messages.hero.voiceMicDenied,
            micMissing: messages.hero.voiceMicMissing,
            micError: messages.hero.voiceMicError,
            micInsecure: messages.hero.voiceMicInsecure,
            soundBlocked: messages.hero.voiceSoundBlocked,
          }}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* The orb and face preview sit in a dark well in both themes. Local tokens keep the HUD,
     hollow label, and play button on the dark palette so they don't invert
     to ink-on-ink when the page is light. */
  .orb-well {
    background: oklch(0.125 0.008 160);
    --background: oklch(0.125 0.008 160);
    --color-background: oklch(0.125 0.008 160);
    --foreground: oklch(0.965 0.005 160);
    --color-foreground: oklch(0.965 0.005 160);
    --card: oklch(0.16 0.009 160);
    --color-card: oklch(0.16 0.009 160);
    --muted: oklch(0.205 0.01 160);
    --color-muted: oklch(0.205 0.01 160);
    --border: oklch(0.92 0.008 160 / 12%);
    --color-border: oklch(0.92 0.008 160 / 12%);
    --dot-grid-color: rgb(255 255 255 / 9%);
  }
</style>
