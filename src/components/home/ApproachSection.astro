---
import { Blocks, Plug, RefreshCw, Search } from "lucide-react";

import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { messages } = Astro.props;
const stepIcons = [Search, Blocks, Plug, RefreshCw] as const;
---

<section
  id="method"
  aria-labelledby="method-heading"
  class="scroll-mt-20 border-b border-border bg-background"
>
  <div class="mx-auto w-full max-w-[82.5rem] border-x border-border">
    <header class="grid border-b border-border lg:grid-cols-12">
      <div class="px-6 py-9 sm:px-8 sm:py-11 lg:col-span-8 lg:px-12 lg:py-14">
        <p
          class="inline-flex items-center gap-2 font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground"
        >
          <span aria-hidden="true" class="size-1.5 bg-brand"></span>
          {messages.approach.eyebrow}
        </p>
        <h2
          id="method-heading"
          class="mt-5 max-w-3xl text-balance text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl"
        >
          {messages.approach.title}
        </h2>
      </div>

      <div
        class="flex items-end border-t border-border px-6 py-9 sm:px-8 lg:col-span-4 lg:border-t-0 lg:border-l lg:px-10 lg:py-14"
      >
        <p class="max-w-md text-pretty text-base leading-7 text-muted-foreground">
          {messages.approach.description}
        </p>
      </div>
    </header>

    <ol class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
      {
        messages.approach.steps.map((step, index) => {
          const Icon = stepIcons[index] ?? Search;

          return (
            <li class="relative flex min-h-72 flex-col bg-background p-6 sm:p-8">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-medium tracking-[0.2em] text-brand">
                  {step.number}
                </span>
                <Icon
                  aria-hidden="true"
                  focusable="false"
                  className="size-4 text-muted-foreground"
                  strokeWidth={1.5}
                />
              </div>

              <div class="mt-auto pt-14">
                <h3 class="text-xl font-medium tracking-tight text-foreground">
                  {step.title}
                </h3>
                <p class="mt-3 text-sm leading-6 text-muted-foreground sm:text-base">
                  {step.description}
                </p>
              </div>

              <span
                aria-hidden="true"
                class="absolute bottom-0 left-0 h-px w-8 bg-brand/50"
              ></span>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
