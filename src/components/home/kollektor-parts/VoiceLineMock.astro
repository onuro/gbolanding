---
import { AudioLines, Check, Phone } from "lucide-react";
import MockShell from "@/components/ui/MockShell.astro";
import type { Locale } from "@/i18n/config";
import KollektorStage from "./KollektorStage.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const ui =
  locale === "tr"
    ? {
        title: "Canlı görüşme",
        meta: "K-0842 · Mart tahsilat listesi",
        status: "Görüşmede",
        kollektor: "Kollektor",
        debtor: "Borçlu",
        verified: "Kimlik doğrulandı",
        maskedId: "T.C. ***4821",
        agentLine: "Ödemeniz gecikti. Bugün ödeme yapacak mısınız?",
        debtorLine: "12.500 TL'yi saat 18.00'e kadar ödeyebilirim.",
        promise: "Ödeme sözü kaydedildi",
        due: "Vade",
        dueTime: "18:00",
        amount: "₺12.500",
        sr: "Kollektor ile bir borçlu arasındaki canlı görüşme. Önce kimlik doğrulanıyor, borçlu ödeme saatini söylüyor ve ödeme sözü anında kaydediliyor.",
      }
    : {
        title: "Live call",
        meta: "K-0842 · March recovery list",
        status: "On call",
        kollektor: "Kollektor",
        debtor: "Debtor",
        verified: "Identity verified",
        maskedId: "T.C. ***4821",
        agentLine: "Your payment is overdue. Will you pay today?",
        debtorLine: "I can pay $12,500 by 18:00.",
        promise: "Payment promise recorded",
        due: "Due",
        dueTime: "18:00",
        amount: "$12,500",
        sr: "A live call between Kollektor and a debtor. Identity is verified first, the debtor names a time to pay, and the promise is recorded on the spot.",
      };

// Voice envelope: tall in the middle, quiet at the edges. Negative delays put
// every bar at a different phase, so even a paused strip reads as a waveform.
const bars = Array.from({ length: 48 }, (_, i) => {
  const t = i / 47;
  const envelope = Math.sin(t * Math.PI);
  const wobble = 0.4 + 0.6 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.85));
  return {
    height: Math.round(18 + envelope * wobble * 82),
    delay: (i * 97) % 1100,
  };
});
---

<KollektorStage label={ui.sr} fixed>
  <div class="w-full max-w-[26rem]" data-k-voice data-speaker="agent">
    <MockShell
      title={ui.title}
      meta={ui.meta}
      status={{ tone: "live", label: ui.status }}
    >
      <div class="flex items-center gap-3 border-b border-border px-4 py-3">
        <span
          class="w-10 shrink-0 font-mono text-caption tabular-nums text-muted-foreground"
          data-kv-clock
        >00:41</span>
        <span
          class="k-v-wave flex h-7 min-w-0 flex-1 items-center justify-between"
          data-kv-wave
        >
          {
            bars.map((bar) => (
              <span
                class="k-v-bar w-[2px] shrink-0 rounded-full"
                style={`height:${bar.height}%;animation-delay:-${bar.delay}ms`}
              />
            ))
          }
        </span>
        <span class="w-16 shrink-0 text-right text-micro font-medium">
          <span class="k-v-who text-brand" data-who="agent">{ui.kollektor}</span>
          <span class="k-v-who text-muted-foreground" data-who="debtor">
            {ui.debtor}
          </span>
        </span>
      </div>

      <ol class="space-y-2.5 px-4 py-4">
        <li
          class="k-v-step flex items-center gap-2.5"
          data-kv-step
          data-kv-by="agent"
          data-at="12"
        >
          <span
            class="grid size-5 shrink-0 place-items-center rounded-full border border-border bg-card text-brand"
          >
            <Check className="size-3" strokeWidth={2.25} />
          </span>
          <span class="min-w-0 truncate text-caption text-muted-foreground">
            {ui.verified}
          </span>
          <span
            class="ml-auto shrink-0 font-mono text-micro text-tertiary-foreground"
          >
            {ui.maskedId}
          </span>
        </li>

        <li
          class="k-v-step flex items-end gap-2"
          data-kv-step
          data-kv-by="agent"
          data-at="21"
        >
          <span
            class="grid size-6 shrink-0 place-items-center rounded-full bg-brand text-brand-foreground"
          >
            <AudioLines className="size-3.5" strokeWidth={1.75} />
          </span>
          <p
            class="max-w-[82%] rounded-tile rounded-bl-chip border border-brand-line bg-brand-soft px-3 py-2 text-paragraph-xs text-foreground"
          >
            {ui.agentLine}
          </p>
        </li>

        <li
          class="k-v-step flex flex-row-reverse items-end gap-2"
          data-kv-step
          data-kv-by="debtor"
          data-at="34"
        >
          <span
            class="grid size-6 shrink-0 place-items-center rounded-full border border-border bg-muted text-muted-foreground"
          >
            <Phone className="size-3" strokeWidth={1.75} />
          </span>
          <p
            class="max-w-[82%] rounded-tile rounded-br-chip bg-foreground px-3 py-2 text-paragraph-xs text-background"
          >
            {ui.debtorLine}
          </p>
        </li>

        <li
          class="k-v-step flex items-center gap-3 rounded-tile border border-brand-line bg-card px-3 py-2.5 shadow-card"
          data-kv-step
          data-kv-by="agent"
          data-at="41"
        >
          <span
            class="grid size-6 shrink-0 place-items-center rounded-full bg-brand text-brand-foreground"
          >
            <Check className="size-3.5" strokeWidth={2.25} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-label-xs text-foreground">
              {ui.promise}
            </span>
            <span class="block text-micro text-tertiary-foreground">
              {ui.due} <span class="font-mono">{ui.dueTime}</span>
            </span>
          </span>
          <span class="shrink-0 data-value">{ui.amount}</span>
        </li>
      </ol>
    </MockShell>
  </div>
</KollektorStage>

<script>
  import { reducedMotion, watchVisibility } from "./motion";

  // When each beat lands, in ms after the loop starts.
  const BEATS = [300, 1500, 3400, 5300];
  const LOOP_END = 9400;
  const RESTART_GAP = 800;

  const clockText = (s: number) =>
    `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;

  // Plays the call beat by beat (identity, agent, debtor, promise) while the
  // mock is on screen. Hidden beats keep their space, so the card never jumps.
  function initVoice(root: HTMLElement) {
    const steps = [...root.querySelectorAll<HTMLElement>("[data-kv-step]")];
    const clock = root.querySelector<HTMLElement>("[data-kv-clock]");
    const wave = root.querySelector<HTMLElement>("[data-kv-wave]");
    if (!steps.length || !clock || !wave) return;

    let timers: number[] = [];
    let ticker = 0;
    let seconds = 0;

    const clear = () => {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
      window.clearInterval(ticker);
    };

    const hideAll = () => {
      steps.forEach((step) => step.classList.remove("is-on"));
    };

    const play = () => {
      clear();
      root.setAttribute("data-armed", "");
      hideAll();
      root.dataset.speaker = "agent";
      seconds = Math.max(0, (Number(steps[0]?.dataset.at) || 0) - 3);
      clock.textContent = clockText(seconds);
      ticker = window.setInterval(() => {
        seconds += 1;
        clock.textContent = clockText(seconds);
      }, 1000);

      steps.forEach((step, i) => {
        const at = BEATS[i] ?? BEATS[BEATS.length - 1] ?? 0;
        timers.push(
          window.setTimeout(() => {
            step.classList.add("is-on");
            root.dataset.speaker = step.dataset.kvBy ?? "agent";
            seconds = Math.max(seconds, Number(step.dataset.at) || seconds);
            clock.textContent = clockText(seconds);
          }, at),
        );
      });

      timers.push(window.setTimeout(hideAll, LOOP_END));
      timers.push(window.setTimeout(play, LOOP_END + RESTART_GAP));
    };

    // Below the fold at load: hide the beats now, while nobody can see it,
    // so the first play starts from an empty feed instead of fading out.
    if (root.getBoundingClientRect().top > window.innerHeight) {
      root.setAttribute("data-armed", "");
    }

    const stop = watchVisibility(root, (active) => {
      if (active) {
        wave.classList.add("is-playing");
        play();
        return;
      }
      clear();
      wave.classList.remove("is-playing");
    });

    // No observer support: leave the finished call on screen.
    if (!stop) root.removeAttribute("data-armed");
  }

  if (!reducedMotion()) {
    document.querySelectorAll<HTMLElement>("[data-k-voice]").forEach(initVoice);
  }
</script>

<style>
  .k-v-bar {
    background-color: var(--brand);
    transform-origin: center;
    animation: kollektor-voice-wave 1.1s ease-in-out infinite;
    animation-play-state: paused;
    transition: background-color 300ms ease;
  }

  .k-v-wave.is-playing .k-v-bar {
    animation-play-state: running;
  }

  [data-speaker="debtor"] .k-v-bar {
    background-color: var(--tertiary-foreground);
  }

  .k-v-who {
    display: none;
  }

  [data-speaker="agent"] .k-v-who[data-who="agent"],
  [data-speaker="debtor"] .k-v-who[data-who="debtor"] {
    display: inline;
  }

  .k-v-step {
    transition:
      opacity 450ms cubic-bezier(0.22, 1, 0.36, 1),
      translate 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-armed] .k-v-step:not(.is-on) {
    opacity: 0;
    translate: 0 6px;
  }

  @keyframes kollektor-voice-wave {
    0%,
    100% {
      transform: scaleY(0.4);
      opacity: 0.6;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .k-v-bar {
      animation: none;
    }
  }
</style>
