---
import BlinkText from "@/components/BlinkText";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";
import DotIllo from "@/components/illos/DotIllo.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { DotIlloName } from "@/components/illos/dot-illos";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { messages } = Astro.props;

// Indexed to messages.platform.capabilities.
const illos: DotIlloName[] = [
  "analysis",
  "design",
  "automation",
  "integration",
  "oversight",
  "improvement",
];
---

<section
  id="platform"
  aria-labelledby="platform-heading"
  data-reveal-root
  class="bg-background"
>
  <div class="frame frame-cross border-b border-border">
    <SectionHeader
      eyebrow={messages.platform.eyebrow}
      lead={messages.platform.description}
      headingId="platform-heading"
      reveal="header"
      class="pt-16!"
    >
      <BlinkText client:visible text={messages.platform.title} />
    </SectionHeader>

    <ul class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
      {
        messages.platform.capabilities.map((capability, index) => {
          const illo = illos[index];

          return (
            <li class="group bg-background p-3">
              {/* The cell keeps its background while its content fades up, so
                  the hairline grid never shows through as a grey block.
                  Text leads in the DOM so a screen reader meets the heading
                  first; the visual is moved above it on screen. */}
              <div data-reveal class="flex h-full flex-col overflow-hidden rounded-tile bg-card shadow-card">
                <div class="px-4 pb-6 pt-5 sm:px-5 sm:pb-7 sm:pt-6">
                  <h3 class="text-title-h5 text-foreground">{capability.title}</h3>
                  <p class="mt-2 max-w-sm text-pretty text-paragraph-sm text-muted-foreground sm:text-paragraph-md">
                    {capability.description}
                  </p>
                </div>
                {illo && (
                  <div
                    class="order-first flex h-64 items-center justify-center overflow-hidden"
                    aria-hidden="true"
                  >
                    <div class="w-[82%] max-w-[22rem] text-foreground transition-transform duration-700 ease-out group-hover:scale-[1.04]">
                      <DotIllo name={illo} boot />
                    </div>
                  </div>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
