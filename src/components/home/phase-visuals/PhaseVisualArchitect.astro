---
import type { Locale } from "@/i18n/config";
import PhaseVisualFrame from "./PhaseVisualFrame.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy =
  locale === "tr"
    ? {
        title: "Sistem tasarımı",
        meta: "Taslak v2 · 5 katman",
        status: "İncelendi",
        description:
          "Örnek bir sistem tasarımı. Arayüzler, yapay zeka katmanı, servisler ve veri tek sistem olarak çizilir ve mevcut ERP, CRM ve e-posta araçlarına bağlanır.",
        layers: [
          { label: "Arayüzler", chips: ["Web", "Mobil", "Yönetim"] },
          { label: "Yapay zeka", chips: ["Ajanlar", "Bilgi erişimi", "Denetim"] },
          { label: "Servisler", chips: ["API", "Görevler", "Kimlik"] },
          { label: "Veri", chips: ["Model", "Depo", "Olaylar"] },
          { label: "Entegrasyon", chips: ["ERP", "CRM", "E-posta"] },
        ],
        legendAi: "Yapay zeka katmanı",
        legendNew: "Yeni sistem",
        legendExisting: "Mevcut araçlar",
      }
    : {
        title: "System design",
        meta: "Draft v2 · 5 layers",
        status: "Reviewed",
        description:
          "A sample system design. Surfaces, the AI layer, services and data are drawn as one system and connected to your existing ERP, CRM and email.",
        layers: [
          { label: "Surfaces", chips: ["Web", "Mobile", "Admin"] },
          { label: "AI layer", chips: ["Agents", "Retrieval", "Guardrails"] },
          { label: "Services", chips: ["API", "Jobs", "Auth"] },
          { label: "Data", chips: ["Model", "Store", "Events"] },
          { label: "Integrations", chips: ["ERP", "CRM", "Email"] },
        ],
        legendAi: "AI layer",
        legendNew: "New system",
        legendExisting: "Existing tools",
      };

// The AI layer is the running core (brand). The last layer is the tools the
// client already runs, drawn dashed; everything between is new.
const CORE = 1;
const EXISTING = copy.layers.length - 1;
const layers = copy.layers.map((layer, index) => ({
  ...layer,
  kind: index === CORE ? "core" : index === EXISTING ? "existing" : "new",
}));

// Each row draws the wire down to the next row's node. Nodes sit 7px (stacked)
// or 12px (side by side) below the row's top; rows are 10px apart, and the
// dashed divider before the existing tools adds 4px margin, 1px border and
// 14px padding. So a wire is its row's height plus the gap to the next node.
const ROW_GAP = 10;
const DIVIDER_GAP = ROW_GAP + 4 + 1 + 14;
---

<PhaseVisualFrame
  title={copy.title}
  meta={copy.meta}
  status={{ tone: "done", label: copy.status }}
  description={copy.description}
>
  <ul class="flex flex-col gap-2.5">
    {
      layers.map((layer, index) => {
        const next = layers[index + 1];
        return (
          <li
            data-seq
            class:list={[
              "relative grid gap-1.5 pl-6 sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:items-center sm:gap-4",
              layer.kind === "existing" &&
                "mt-1 border-t border-dashed border-border-strong pt-3.5",
            ]}
          >
            {next && (
              <span
                data-seq="grow-y"
                class:list={[
                  "absolute left-[0.3125rem] top-[0.4375rem] w-0 origin-top border-l sm:top-3",
                  next.kind === "existing"
                    ? "border-dashed border-foreground/30"
                    : "border-border-strong",
                ]}
                style={`height: calc(100% + ${next.kind === "existing" ? DIVIDER_GAP : ROW_GAP}px);`}
              />
            )}
            <span
              class:list={[
                "absolute left-0 size-2.5 rounded-full border",
                layer.kind === "existing"
                  ? "top-4 sm:top-[1.3125rem]"
                  : "top-0.5 sm:top-[0.4375rem]",
                layer.kind === "core"
                  ? "border-brand bg-brand"
                  : layer.kind === "existing"
                    ? "border-dashed border-foreground/40 bg-background"
                    : "border-foreground/30 bg-background",
              ]}
            />
            <span
              class:list={[
                "data-label",
                layer.kind === "core" && "text-brand",
              ]}
            >
              {layer.label}
            </span>
            <span class="flex flex-wrap gap-1.5">
              {layer.chips.map((chip) => (
                <span
                  class:list={[
                    "inline-flex h-6 items-center rounded-chip border px-2 data-value",
                    layer.kind === "core" &&
                      "border-brand-line bg-brand-soft text-brand",
                    layer.kind === "new" && "border-border bg-card",
                    layer.kind === "existing" &&
                      "border-dashed border-foreground/30 text-muted-foreground",
                  ]}
                >
                  {chip}
                </span>
              ))}
            </span>
          </li>
        );
      })
    }
  </ul>

  <div
    slot="footer"
    class="flex w-full flex-wrap items-center gap-x-4 gap-y-1.5"
  >
    <span class="flex items-center gap-1.5 data-label">
      <span class="size-2 rounded-full bg-brand"></span>
      {copy.legendAi}
    </span>
    <span class="flex items-center gap-1.5 data-label">
      <span class="h-2.5 w-3.5 rounded-[3px] border border-border-strong bg-card"
      ></span>
      {copy.legendNew}
    </span>
    <span class="flex items-center gap-1.5 data-label">
      <span
        class="h-2.5 w-3.5 rounded-[3px] border border-dashed border-foreground/40"
      ></span>
      {copy.legendExisting}
    </span>
  </div>
</PhaseVisualFrame>
