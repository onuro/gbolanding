---
import { Check } from "lucide-react";

import type { Locale } from "@/i18n/config";
import PhaseVisualFrame from "./PhaseVisualFrame.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy =
  locale === "tr"
    ? {
        title: "Sürüm hattı",
        meta: "8 hafta · 4 sürüm",
        status: "Yayına çıkıyor",
        description:
          "Örnek bir sürüm hattı. Dört kısa sürümü gösterir. Son sürüm testleri ve güvenlik denetimini geçmiş, kontrollü olarak yayına çıkıyor.",
        releaseHeader: "Sürüm",
        prefix: "S",
        checks: [
          { label: "Testler", value: "214 / 214" },
          { label: "Güvenlik", value: "Açık bulgu yok" },
          { label: "Yayın", value: "%40" },
        ],
        feedback: "Geri bildirim",
        feedbackValue: "9 yeni not",
        next: "S5 planlanıyor",
      }
    : {
        title: "Release train",
        meta: "8 weeks · 4 releases",
        status: "Rolling out",
        description:
          "A sample release train. It shows four short releases. The latest has passed testing and security review and is in a controlled rollout.",
        releaseHeader: "Release",
        prefix: "R",
        checks: [
          { label: "Tests", value: "214 / 214" },
          { label: "Security", value: "No open findings" },
          { label: "Rollout", value: "40%" },
        ],
        feedback: "Feedback",
        feedbackValue: "9 new notes",
        next: "R5 in planning",
      };

// Eight weeks across the track. Releases overlap: the next one starts before
// the last one lands. Only the release still rolling out carries the brand,
// solid up to today and soft for the part still ahead.
const WEEKS = 8;
const TODAY = 86;
const ROLLOUT = 40;
const releases = [
  { start: 0, width: 22 },
  { start: 18, width: 26 },
  { start: 40, width: 28 },
  { start: 64, width: 36, live: true },
];

const checks = copy.checks.map((check, index) => ({
  ...check,
  live: index === copy.checks.length - 1,
}));
---

<PhaseVisualFrame
  title={copy.title}
  meta={copy.meta}
  status={{ tone: "live", label: copy.status }}
  description={copy.description}
>
  <div class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-3">
    <span class="data-label">{copy.releaseHeader}</span>
    <span class="grid grid-cols-8 text-center data-label">
      {Array.from({ length: WEEKS }, (_, week) => <span>{week + 1}</span>)}
    </span>
  </div>

  <div class="relative mt-2">
    <div
      class="pointer-events-none absolute inset-y-0 left-[4.25rem] right-0 grid grid-cols-8"
    >
      {
        Array.from({ length: WEEKS }, (_, week) => (
          <span
            class:list={["border-border", week > 0 && "border-l"]}
          />
        ))
      }
      <span
        class="absolute inset-y-0 border-l border-dashed border-brand-line"
        style={`left: ${TODAY}%;`}
      ></span>
    </div>

    <div class="relative space-y-1.5">
      {
        releases.map((release, index) => (
          <div
            data-seq
            class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-center gap-x-3"
          >
            <span
              class:list={[
                "font-mono text-caption tabular-nums",
                release.live ? "text-brand" : "text-muted-foreground",
              ]}
            >
              {copy.prefix}
              {index + 1}
            </span>
            <span class="relative block h-6">
              {release.live ? (
                <span
                  data-seq="grow"
                  class="absolute inset-y-1.5 origin-left overflow-hidden rounded-[4px] bg-brand-soft ring-1 ring-inset ring-brand-line"
                  style={`left: ${release.start}%; width: ${release.width}%;`}
                >
                  <span
                    class="block h-full rounded-[4px] bg-brand"
                    style={`width: ${Math.round(((TODAY - release.start) / release.width) * 100)}%;`}
                  />
                </span>
              ) : (
                <span
                  data-seq="grow"
                  class="absolute inset-y-1.5 origin-left rounded-[4px] bg-foreground/25"
                  style={`left: ${release.start}%; width: ${release.width}%;`}
                />
              )}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="mt-4 grid gap-1.5 border-t border-border pt-4 sm:grid-cols-3 sm:gap-2"
  >
    {
      checks.map((check) => (
        <div
          data-seq
          class:list={[
            "flex min-w-0 items-center justify-between gap-3 rounded-tile border px-3 py-2 sm:block sm:py-2.5",
            check.live
              ? "border-brand-line bg-brand-soft"
              : "border-border bg-foreground/[0.02]",
          ]}
        >
          <p
            class:list={[
              "flex min-w-0 items-center gap-1.5 data-label",
              check.live && "text-brand",
            ]}
          >
            {check.live ? (
              <span class="size-1.5 shrink-0 rounded-full bg-brand" />
            ) : (
              <Check
                aria-hidden="true"
                className="size-3 shrink-0 text-foreground"
                strokeWidth={2}
              />
            )}
            <span class="truncate">{check.label}</span>
          </p>
          <p class="shrink-0 data-value sm:mt-1.5">{check.value}</p>
          {check.live && (
            <span class="mt-2 hidden h-1 overflow-hidden rounded-full bg-brand-line sm:block">
              <span
                data-seq="grow"
                class="block h-full origin-left rounded-full bg-brand"
                style={`width: ${ROLLOUT}%;`}
              />
            </span>
          )}
        </div>
      ))
    }
  </div>

  <div
    slot="footer"
    class="flex w-full flex-wrap items-center justify-between gap-x-4 gap-y-1.5"
  >
    <span class="flex items-center gap-2">
      <span class="data-label">{copy.feedback}</span>
      <span class="data-value">{copy.feedbackValue}</span>
    </span>
    <span class="data-label">{copy.next}</span>
  </div>
</PhaseVisualFrame>
