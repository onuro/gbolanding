---
import type { Locale } from "@/i18n/config";
import PhaseVisualFrame from "./PhaseVisualFrame.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy =
  locale === "tr"
    ? {
        title: "Analiz / Sürtünme haritası",
        lanes: ["Kullanıcılar", "Araçlar", "Devirler", "Veri"],
        laneUnit: "akış",
        flagged: "sürtünme noktası",
        clear: "sorunsuz",
      }
    : {
        title: "Analyze / Friction map",
        lanes: ["Users", "Tools", "Handoffs", "Data"],
        laneUnit: "lanes",
        flagged: "friction points",
        clear: "clear",
      };

// Four lanes of the same working week. `hot` marks where the work stalls; the
// rest is filled deterministically so the map reads as traffic, not noise.
const CELLS = 22;
const lanes = [
  { label: copy.lanes[0], seed: 2, density: 0.45, hot: [7, 8] },
  { label: copy.lanes[1], seed: 5, density: 0.6, hot: [3, 4, 12] },
  { label: copy.lanes[2], seed: 9, density: 0.35, hot: [15] },
  { label: copy.lanes[3], seed: 4, density: 0.5, hot: [9, 10] },
];

const cellLevel = (lane: (typeof lanes)[number], cell: number) => {
  if (lane.hot.includes(cell)) return 2;
  return ((cell * 13 + lane.seed * 7) % 11) / 11 < lane.density ? 1 : 0;
};

const flagged = lanes.reduce((total, lane) => total + lane.hot.length, 0);
---

<PhaseVisualFrame
  title={copy.title}
  meta={`0${lanes.length} ${copy.laneUnit}`}
>
  <div class="space-y-3.5">
    {
      lanes.map((lane) => (
        <div class="grid grid-cols-[4.25rem_1fr_1.75rem] items-center gap-3 sm:grid-cols-[6rem_1fr_2rem] sm:gap-4">
          <span class="truncate font-mono text-[10px] uppercase tracking-[0.14em] text-foreground/45">
            {lane.label}
          </span>
          <span class="flex h-4 items-stretch gap-[2px]">
            {Array.from({ length: CELLS }, (_, cell) => {
              const level = cellLevel(lane, cell);
              return (
                <span
                  class:list={[
                    "flex-1 rounded-[1px]",
                    level === 2
                      ? "bg-attention"
                      : level === 1
                        ? "bg-foreground/25"
                        : "bg-foreground/[0.07]",
                  ]}
                />
              );
            })}
          </span>
          <span class="text-right font-mono text-[10px] tabular-nums text-foreground/40">
            ×{lane.hot.length}
          </span>
        </div>
      ))
    }
  </div>

  <div
    class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-border pt-4 font-mono text-[10px] uppercase tracking-[0.14em] text-foreground/40"
  >
    <span class="flex items-center gap-2">
      <span class="size-1.5 rounded-[1px] bg-attention"></span>
      {flagged} {copy.flagged}
    </span>
    <span class="flex items-center gap-2 text-foreground/25">
      <span class="size-1.5 rounded-[1px] bg-foreground/25"></span>
      {copy.clear}
    </span>
  </div>
</PhaseVisualFrame>
