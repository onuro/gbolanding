---
import MockShell from "@/components/ui/MockShell.astro";

interface Props {
  /** Window title, e.g. "Friction map". */
  title: string;
  /** Second header line, e.g. "Case intake · 5 working days". */
  meta?: string;
  /** Header pill. Tone keeps its meaning: live = running, waiting = a person. */
  status?: { tone: "live" | "waiting" | "done"; label: string };
  /** One sentence read in place of the decorative window. */
  description: string;
  bodyClass?: string;
}

// A phase artefact floating on the quiet dotted well. The window is decorative
// (aria-hidden) and carries the data-seq hooks that EnterprisePhases animates.
// Every visual passes a footer; it is forwarded to MockShell as-is.
const { title, meta, status, description, bodyClass } = Astro.props;
---

<div
  class="stage-soft flex h-full min-h-[21rem] items-center justify-center rounded-well px-3 py-8 sm:min-h-[27rem] sm:px-10 sm:py-12 lg:px-8 xl:px-14"
>
  <p class="sr-only">{description}</p>
  <div class="w-full max-w-[34rem]" aria-hidden="true" data-seq-mock>
    <MockShell
      title={title}
      meta={meta}
      status={status}
      bodyClass={bodyClass ?? "p-4 sm:p-5"}
    >
      <slot />
      <slot name="footer" slot="footer" />
    </MockShell>
  </div>
</div>
