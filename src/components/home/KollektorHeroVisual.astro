---
import type { Locale } from "@/i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isTurkish = locale === "tr";

const copy = isTurkish
  ? {
      workflow: "Tahsilat iş akışı",
      liveSystem: "Canlı sistem",
      stages: ["Liste", "Kuyruk", "Görüşme", "Sonuç", "Rapor"],
      list: {
        title: "Liste kontrol edildi",
        badge: "142 kayıt hazır",
        columns: ["Kayıt", "Borç", "Durum"],
        status: "Hazır",
        footer: "Hata yok",
        amounts: ["₺12.500", "₺8.400", "₺21.750", "₺6.900", "₺17.250", "₺9.800", "₺28.300"],
      },
      queue: {
        title: "Arama kuyruğu",
        badge: "Arama grubu canlı",
        metrics: [
          ["Görüşülen", "41"],
          ["Aranıyor", "1"],
          ["Sırada", "100"],
        ],
        calling: "Aranıyor",
        queued: "Sırada",
      },
      call: {
        title: "Canlı görüşme",
        outbound: "Giden arama",
        listening: "Dinliyor",
        kollektor: "Kollektor",
        debtor: "Borçlu",
        agentLine: "Ödemeniz gecikti. Bugün ödeme yapacak mısınız?",
        debtorLine: "12.500 TL'yi saat 18.00'e kadar ödeyebilirim.",
      },
      outcome: {
        title: "Otomatik sınıflandırma",
        confidence: "%96 güven",
        result: "Ödeme sözü",
        fields: [
          ["Tutar", "₺12.500"],
          ["Vade", "Bugün, 18.00"],
        ],
        recorded: "Ödeme sözü kaydedildi",
      },
      report: {
        title: "Arama grubu raporu",
        badge: "Şimdi güncellendi",
        metrics: [
          ["Görüşülen", "42"],
          ["Söz alınan", "13"],
          ["Taahhüt toplamı", "₺142.500"],
        ],
        sync: "Kampanya ve dosya kaydı eşitlendi",
      },
    }
  : {
      workflow: "Collection workflow",
      liveSystem: "Live system",
      stages: ["List", "Queue", "Call", "Outcome", "Report"],
      list: {
        title: "List validated",
        badge: "142 records ready",
        columns: ["Record", "Debt", "Status"],
        status: "Ready",
        footer: "No errors",
        amounts: ["$12,500", "$8,400", "$21,750", "$6,900", "$17,250", "$9,800", "$28,300"],
      },
      queue: {
        title: "Call queue",
        badge: "Campaign live",
        metrics: [
          ["Reached", "41"],
          ["Calling", "1"],
          ["Queued", "100"],
        ],
        calling: "Calling",
        queued: "Queued",
      },
      call: {
        title: "Live call",
        outbound: "Outbound",
        listening: "Listening",
        kollektor: "Kollektor",
        debtor: "Debtor",
        agentLine: "Your payment is overdue. Will you pay today?",
        debtorLine: "I can pay $12,500 by 18:00.",
      },
      outcome: {
        title: "Automatic classification",
        confidence: "96% confidence",
        result: "Payment promise",
        fields: [
          ["Amount", "$12,500"],
          ["Due", "Today, 18:00"],
        ],
        recorded: "Promise recorded",
      },
      report: {
        title: "Campaign report",
        badge: "Updated now",
        metrics: [
          ["Reached", "42"],
          ["Promises", "13"],
          ["Promised", "$142,500"],
        ],
        sync: "Campaign and case record synced",
      },
    };

const records = ["0842", "0843", "0844", "0845", "0846", "0847", "0848"];
const waveform = [34, 58, 42, 76, 52, 88, 64, 38, 72, 94, 46, 68, 54, 84, 40, 62, 90, 48];
const reportBars = [58, 78, 94];
---

<script is:inline>
  document.documentElement.classList.add("js");
</script>

<div
  class="kollektor-visual relative z-20 mx-auto flex w-full max-w-none self-stretch flex-col gap-1"
  data-kollektor-visual
  data-motion-state="idle"
>
  <div class="kollektor-progress grid h-1 grid-cols-5 gap-1" aria-hidden="true">
    {copy.stages.map((_, index) => (
      <span class="kollektor-progress-segment bg-white" data-k-progress style={`--segment-index:${index}`}></span>
    ))}
  </div>

  <div class="kollektor-panel panel-shadow relative flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-foreground/20">
    <div class="kollektor-header flex h-12 items-center justify-between border-b border-border px-3.5 sm:px-4">
      <div class="flex min-w-0 items-center gap-2.5">
        <span class="size-1.5 shrink-0 rounded-full bg-brand"></span>
        <span class="truncate font-mono text-[10px] uppercase tracking-[0.16em] text-foreground/80">
          Kollektor
        </span>
        <span class="hidden font-mono text-[9px] uppercase tracking-[0.14em] text-foreground/35 sm:inline">
          / {copy.workflow}
        </span>
      </div>
      <span class="hidden items-center gap-2 font-mono text-[9px] uppercase tracking-[0.14em] text-foreground/40 min-[420px]:inline-flex">
        <span class="size-1.5 rounded-full bg-brand shadow-[0_0_10px_var(--brand)]"></span>
        {copy.liveSystem}
      </span>
    </div>

    <div class="kollektor-rail-viewport overflow-hidden border-b border-border" data-k-rail-viewport>
      <ol class="kollektor-rail-track flex w-max min-w-full" data-k-rail-track>
        {copy.stages.map((label, index) => (
          <li
            class="kollektor-rail-item flex h-14 min-w-[7.75rem] flex-1 items-center gap-2 border-r border-border px-3 sm:min-w-32"
            data-k-rail
            data-state={index < 4 ? "complete" : "active"}
          >
            <span class="font-mono text-[9px] tabular-nums" data-k-rail-number>
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="min-w-0 flex-1 truncate text-[11px] text-foreground/55">{label}</span>
            <span class="size-1.5 shrink-0" data-k-rail-dot></span>
          </li>
        ))}
      </ol>
    </div>

    <div class="kollektor-stage-wrap relative min-h-[22rem] flex-1 sm:min-h-[26rem] xl:min-h-0">
      <section class="kollektor-stage kollektor-stage-list absolute inset-0 p-4 sm:p-5" data-k-stage="list">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="kollektor-kicker">01 / {copy.stages[0]}</p>
            <h3 class="mt-2 text-xl font-medium tracking-[-0.025em] text-foreground">{copy.list.title}</h3>
          </div>
          <span class="kollektor-neutral-badge">{copy.list.badge}</span>
        </div>

        <div class="mt-5 overflow-hidden border border-border bg-background/80">
          <div class="grid grid-cols-[1fr_1fr_4.5rem] border-b border-border bg-foreground/[0.025] px-3 py-2 font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/35">
            {copy.list.columns.map((column) => <span>{column}</span>)}
          </div>
          {records.map((record, index) => (
            <div
              class:list={[
                "kollektor-list-row grid grid-cols-[1fr_1fr_4.5rem] items-center border-b border-border px-3 py-3 last:border-b-0",
                index === 2 && "max-sm:border-b-0",
                index === 4 && "sm:border-b-0 xl:border-b",
                index >= 3 && "max-sm:hidden",
                index >= 5 && "max-xl:hidden",
              ]}
              data-k-list-row
            >
              <span class="font-mono text-[10px] text-foreground/55">{record}</span>
              <span class="text-xs tabular-nums text-foreground/80">{copy.list.amounts[index]}</span>
              <span class="flex items-center gap-1.5 font-mono text-[8px] uppercase tracking-[0.1em] text-foreground/45">
                <span class="size-1.5 border border-foreground/25 bg-foreground/5"></span>
                {copy.list.status}
              </span>
            </div>
          ))}
        </div>
        <div class="mt-4 flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.14em] text-foreground/40" data-k-list-footer>
          <span class="size-1.5 bg-foreground/35"></span>
          {copy.list.footer}
        </div>
      </section>

      <section class="kollektor-stage absolute inset-0 p-4 sm:p-5" data-k-stage="queue">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="kollektor-kicker">02 / {copy.stages[1]}</p>
            <h3 class="mt-2 text-xl font-medium tracking-[-0.025em] text-foreground">{copy.queue.title}</h3>
          </div>
          <span class="kollektor-live-badge"><span class="size-1.5 rounded-full bg-current"></span>{copy.queue.badge}</span>
        </div>

        <div class="mt-5 grid grid-cols-3 border border-border bg-background/80">
          {copy.queue.metrics.map(([label, value], index) => (
            <div class="border-r border-border p-3 last:border-r-0">
              <p class:list={["font-mono text-xl tabular-nums", index === 1 ? "text-live" : "text-foreground/80"]}>{value}</p>
              <p class="mt-1 truncate font-mono text-[8px] uppercase tracking-[0.1em] text-foreground/35">{label}</p>
            </div>
          ))}
        </div>

        <div class="mt-4 overflow-hidden border border-border bg-background/80">
          <div class="kollektor-queue-row is-calling flex items-center gap-3 border-b border-border px-3 py-3" data-k-queue-row>
            <span class="kollektor-call-pulse relative flex size-7 shrink-0 items-center justify-center rounded-full border border-live/30 bg-live/10">
              <span class="size-2 rounded-full bg-live"></span>
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-mono text-[10px] text-foreground/75">0842</p>
              <p class="mt-1 font-mono text-[8px] uppercase tracking-[0.12em] text-live">{copy.queue.calling}</p>
            </div>
            <span class="font-mono text-[10px] tabular-nums text-foreground/45" data-k-call-timer>00:03</span>
          </div>
          {["0843", "0844"].map((record) => (
            <div class="kollektor-queue-row flex items-center gap-3 border-b border-border px-3 py-3 last:border-b-0" data-k-queue-row>
              <span class="size-7 shrink-0 border border-border bg-foreground/[0.025]"></span>
              <div class="min-w-0 flex-1">
                <p class="font-mono text-[10px] text-foreground/55">{record}</p>
                <p class="mt-1 font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/30">{copy.queue.queued}</p>
              </div>
              <span class="size-1.5 border border-foreground/20"></span>
            </div>
          ))}
        </div>
      </section>

      <section class="kollektor-stage absolute inset-0 p-4 sm:p-5" data-k-stage="call">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="kollektor-kicker">03 / {copy.call.outbound}</p>
            <h3 class="mt-2 text-xl font-medium tracking-[-0.025em] text-foreground">{copy.call.title}</h3>
          </div>
          <span class="kollektor-live-badge"><span class="size-1.5 rounded-full bg-current"></span>{copy.call.listening}</span>
        </div>

        <div class="mt-5 border border-border bg-background/80 p-3">
          <div class="flex h-14 items-center justify-center gap-[3px] overflow-hidden" data-k-waveform>
            {waveform.map((height, index) => (
              <span
                class:list={["kollektor-wave-bar w-[2px] shrink-0 origin-center bg-live", index > 11 ? "hidden sm:block" : ""]}
                style={`height:${height}%;`}
                data-k-wave-bar
              ></span>
            ))}
          </div>
        </div>

        <div class="mt-4 space-y-3">
          <div class="kollektor-transcript flex gap-3" data-k-transcript>
            <span class="mt-0.5 w-16 shrink-0 font-mono text-[8px] uppercase tracking-[0.12em] text-live">{copy.call.kollektor}</span>
            <p class="min-w-0 truncate text-sm leading-relaxed text-foreground/70 sm:whitespace-normal">{copy.call.agentLine}</p>
          </div>
          <div class="kollektor-transcript flex gap-3 border-t border-border pt-3" data-k-transcript>
            <span class="mt-0.5 w-16 shrink-0 font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/40">{copy.call.debtor}</span>
            <p class="min-w-0 truncate text-sm leading-relaxed text-foreground/85 sm:whitespace-normal">{copy.call.debtorLine}</p>
          </div>
        </div>
      </section>

      <section class="kollektor-stage absolute inset-0 overflow-hidden p-4 sm:p-5" data-k-stage="outcome">
        <div class="kollektor-scan-line absolute inset-x-0 top-0 h-px bg-foreground/25" data-k-scan></div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="kollektor-kicker">04 / {copy.stages[3]}</p>
            <h3 class="mt-2 text-xl font-medium tracking-[-0.025em] text-foreground">{copy.outcome.title}</h3>
          </div>
          <span class="kollektor-neutral-badge">{copy.outcome.confidence}</span>
        </div>

        <div class="mt-6 border border-brand/30 bg-brand/[0.07] p-4" data-k-outcome-card>
          <div class="flex items-center gap-3">
            <span class="kollektor-check flex size-9 shrink-0 items-center justify-center rounded-full border border-brand/35 bg-brand/10 text-brand" data-k-check>
              <span class="block h-2 w-4 -translate-y-0.5 -rotate-45 border-b-2 border-l-2 border-current"></span>
            </span>
            <div>
              <p class="font-mono text-[8px] uppercase tracking-[0.14em] text-brand">Kollektor AI</p>
              <p class="mt-1 text-lg font-medium text-foreground">{copy.outcome.result}</p>
            </div>
          </div>

          <div class="mt-5 grid grid-cols-2 border-t border-brand/20 pt-4">
            {copy.outcome.fields.map(([label, value]) => (
              <div class="border-r border-brand/20 pr-4 last:border-r-0 last:pl-4 last:pr-0">
                <p class="font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/35">{label}</p>
                <p class="mt-1.5 text-sm tabular-nums text-foreground/85">{value}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-4 flex items-center gap-2 border border-border bg-background/80 px-3 py-2.5 font-mono text-[9px] uppercase tracking-[0.12em] text-brand" data-k-recorded>
          <span class="size-1.5 bg-brand"></span>
          {copy.outcome.recorded}
        </div>
      </section>

      <section class="kollektor-stage kollektor-stage-report absolute inset-0 flex flex-col p-4 sm:p-5 xl:p-6" data-k-stage="report">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="kollektor-kicker">05 / {copy.stages[4]}</p>
            <h3 class="mt-2 text-xl font-medium tracking-[-0.025em] text-foreground">{copy.report.title}</h3>
          </div>
          <span class="kollektor-success-badge"><span class="size-1.5 bg-brand"></span>{copy.report.badge}</span>
        </div>

        <div class="mt-5 grid grid-cols-2 border border-border bg-background/80 sm:grid-cols-3">
          {copy.report.metrics.map(([label, value], index) => (
            <div class:list={["kollektor-kpi border-r border-border p-3 sm:p-4 sm:last:border-r-0", index === 2 ? "col-span-2 border-t sm:col-span-1 sm:border-t-0" : ""]} data-k-kpi>
              <p class:list={["text-xl font-medium tabular-nums tracking-[-0.03em] sm:text-2xl", index > 0 ? "text-brand" : "text-foreground"]}>{value}</p>
              <p class="mt-1.5 font-mono text-[8px] uppercase tracking-[0.1em] text-foreground/35">{label}</p>
            </div>
          ))}
        </div>

        <div class="mt-4 flex min-h-24 flex-1 border border-border bg-background/80 p-3">
          <div class="flex h-full min-h-20 w-full items-end gap-2">
            {reportBars.map((height) => (
              <span class="kollektor-report-bar flex-1 origin-bottom bg-brand/20" style={`height:${height}%`} data-k-report-bar>
                <span class="block h-1 w-full bg-brand"></span>
              </span>
            ))}
          </div>
        </div>

        <div class="mt-4 flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.12em] text-foreground/45" data-k-sync>
          <span class="size-1.5 bg-brand"></span>
          {copy.report.sync}
        </div>
      </section>
    </div>
  </div>

</div>

<script>
  import { createTimeline, stagger, utils } from "animejs";

  const initialiseKollektorVisual = (root: HTMLElement) => {
    if (root.dataset.initialised === "true") return;
    root.dataset.initialised = "true";

    const stages = [...root.querySelectorAll<HTMLElement>("[data-k-stage]")];
    const railViewport = root.querySelector<HTMLElement>("[data-k-rail-viewport]");
    const railTrack = root.querySelector<HTMLOListElement>("[data-k-rail-track]");
    const railItems = [...root.querySelectorAll<HTMLElement>("[data-k-rail]")];
    const progress = [...root.querySelectorAll<HTMLElement>("[data-k-progress]")];
    const listRows = [...root.querySelectorAll<HTMLElement>("[data-k-list-row]")];
    const listFooter = root.querySelector<HTMLElement>("[data-k-list-footer]");
    const queueRows = [...root.querySelectorAll<HTMLElement>("[data-k-queue-row]")];
    const waveBars = [...root.querySelectorAll<HTMLElement>("[data-k-wave-bar]")];
    const transcripts = [...root.querySelectorAll<HTMLElement>("[data-k-transcript]")];
    const scan = root.querySelector<HTMLElement>("[data-k-scan]");
    const outcomeCard = root.querySelector<HTMLElement>("[data-k-outcome-card]");
    const check = root.querySelector<HTMLElement>("[data-k-check]");
    const recorded = root.querySelector<HTMLElement>("[data-k-recorded]");
    const kpis = [...root.querySelectorAll<HTMLElement>("[data-k-kpi]")];
    const reportBars = [...root.querySelectorAll<HTMLElement>("[data-k-report-bar]")];
    const sync = root.querySelector<HTMLElement>("[data-k-sync]");

    if (
      stages.length !== 5 || railItems.length !== 5 || progress.length !== 5 ||
      listRows.length === 0 || queueRows.length === 0 || waveBars.length === 0 ||
      transcripts.length !== 2 || !listFooter || !scan || !outcomeCard || !check ||
      !recorded || kpis.length !== 3 || reportBars.length !== 3 || !sync ||
      !railViewport || !railTrack
    ) return;

    const getRailOffset = (index: number) => {
      const item = railItems[index];
      if (!item) return 0;

      const maxShift = Math.max(0, railTrack.scrollWidth - railViewport.clientWidth);
      const centred = item.offsetLeft + item.offsetWidth / 2 - railViewport.clientWidth / 2;
      return -Math.min(maxShift, Math.max(0, centred));
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.dataset.motionState = "complete";
      const alignFinalRail = () => utils.set(railTrack, { x: getRailOffset(4) });
      requestAnimationFrame(alignFinalRail);
      window.addEventListener("resize", alignFinalRail, { passive: true });
      window.addEventListener("pagehide", () => {
        window.removeEventListener("resize", alignFinalRail);
      }, { once: true });
      return;
    }

    let activeStage = 0;
    const setActiveStage = (activeIndex: number) => {
      activeStage = activeIndex;
      railItems.forEach((item, index) => {
        item.dataset.state = index < activeIndex ? "complete" : index === activeIndex ? "active" : "idle";
      });
    };

    const timeline = createTimeline({
      autoplay: false,
      defaults: { ease: "outCubic" },
      onBegin: () => {
        root.dataset.motionState = "running";
        setActiveStage(0);
      },
      onComplete: () => {
        root.dataset.motionState = "complete";
        setActiveStage(4);
        utils.set(railTrack, { x: getRailOffset(4) });
      },
    });

    const enterStage = (index: number, at: number) => {
      timeline
        .call(() => setActiveStage(index), at)
        .add(railTrack, { x: () => getRailOffset(index), duration: 820, ease: "inOutCubic" }, at)
        .add(stages[index], { opacity: [0, 1], y: [12, 0], duration: 420 }, at + 100)
        .add(progress[index], { scaleX: [0, 1], duration: 720, ease: "outExpo" }, at + 140);
    };

    const exitStage = (index: number, at: number) => {
      timeline.add(stages[index], { opacity: 0, y: -8, duration: 320, ease: "inQuad" }, at);
    };

    const sequenceHold = 1000;

    timeline
      .set(stages, { opacity: 0, y: 10 }, 0)
      .set(stages[0], { opacity: 1, y: 0 }, 0)
      .set(railTrack, { x: 0 }, 0)
      .set(progress, { scaleX: 0 }, 0)
      .set(listRows, { opacity: 0, y: 8 }, 0)
      .set(listFooter, { opacity: 0, x: -6 }, 0)
      .set(queueRows, { opacity: 0, y: 8 }, 0)
      .set(waveBars, { scaleY: 0.14, opacity: 0.3 }, 0)
      .set(transcripts, { opacity: 0, y: 8 }, 0)
      .set(scan, { opacity: 0, y: 0 }, 0)
      .set(outcomeCard, { opacity: 0, scale: 0.985 }, 0)
      .set(check, { scale: 0.55, opacity: 0 }, 0)
      .set(recorded, { opacity: 0, y: 6 }, 0)
      .set(kpis, { opacity: 0, y: 8 }, 0)
      .set(reportBars, { scaleY: 0 }, 0)
      .set(sync, { opacity: 0, x: -6 }, 0)
      .add(listRows, { opacity: 1, y: 0, duration: 420, delay: stagger(110) }, 100)
      .add(listFooter, { opacity: 1, x: 0, duration: 360 }, 620)
      .add(progress[0], { scaleX: [0, 1], duration: 820, ease: "outExpo" }, 140);

    exitStage(0, 1500 + sequenceHold);
    enterStage(1, 1760 + sequenceHold);
    timeline.add(queueRows, { opacity: 1, y: 0, duration: 420, delay: stagger(100) }, 1960 + sequenceHold);

    exitStage(1, 3150 + sequenceHold * 2);
    enterStage(2, 3410 + sequenceHold * 2);
    timeline
      .add(waveBars, {
        opacity: [0.35, 1],
        scaleY: [0.18, (_target, index) => 0.55 + ((index * 7) % 5) * 0.11, 0.42],
        duration: 1080,
        delay: stagger(36),
        ease: "inOutQuad",
      }, 3600 + sequenceHold * 2)
      .add(transcripts[0], { opacity: 1, y: 0, duration: 420 }, 4320 + sequenceHold * 2)
      .add(transcripts[1], { opacity: 1, y: 0, duration: 420 }, 5100 + sequenceHold * 2);

    exitStage(2, 5980 + sequenceHold * 3);
    enterStage(3, 6240 + sequenceHold * 3);
    timeline
      .add(scan, { opacity: [0, 0.65, 0], y: [0, 330], duration: 860, ease: "linear" }, 6380 + sequenceHold * 3)
      .add(outcomeCard, { opacity: 1, scale: 1, duration: 520, ease: "outExpo" }, 6680 + sequenceHold * 3)
      .add(check, { opacity: 1, scale: 1, duration: 520, ease: "outBack" }, 6940 + sequenceHold * 3)
      .add(recorded, { opacity: 1, y: 0, duration: 420 }, 7440 + sequenceHold * 3);

    exitStage(3, 8120 + sequenceHold * 4);
    enterStage(4, 8380 + sequenceHold * 4);
    timeline
      .add(kpis, { opacity: 1, y: 0, duration: 480, delay: stagger(120) }, 8620 + sequenceHold * 4)
      .add(reportBars, { scaleY: 1, duration: 680, delay: stagger(130), ease: "outExpo" }, 9100 + sequenceHold * 4)
      .add(sync, { opacity: 1, x: 0, duration: 440 }, 9860 + sequenceHold * 4)
      .add(stages[4], { opacity: 1, y: 0, duration: 360 }, 10380 + sequenceHold * 4);

    let hasPlayed = false;
    const play = () => {
      if (hasPlayed) return;
      hasPlayed = true;
      timeline.play();
      observer?.disconnect();
    };

    const observer = "IntersectionObserver" in window
      ? new IntersectionObserver(
          ([entry]) => {
            if (entry?.isIntersecting) play();
          },
          { threshold: 0.4 },
        )
      : null;

    if (observer) observer.observe(root);
    else play();

    let resizeFrame = 0;
    const handleResize = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        timeline.refresh();
        utils.set(railTrack, { x: getRailOffset(activeStage) });
      });
    };

    const cleanUp = () => {
      observer?.disconnect();
      timeline.cancel();
      utils.remove([...stages, railTrack]);
      cancelAnimationFrame(resizeFrame);
      window.removeEventListener("resize", handleResize);
      window.removeEventListener("pagehide", cleanUp);
    };

    window.addEventListener("resize", handleResize);
    window.addEventListener("pagehide", cleanUp, { once: true });
  };

  document.querySelectorAll<HTMLElement>("[data-kollektor-visual]").forEach(initialiseKollektorVisual);
</script>

