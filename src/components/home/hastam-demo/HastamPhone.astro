---
// The patient's own handset, beside the Hastam window on the product stage.
// Hastam answers INBOUND calls, so this is the phone placing the call: the
// outgoing-call screen while it dials and rings the clinic, then the same
// screen connected (a running timer, a voice ring that reacts to whoever is
// talking and a live caption), and finally "call ended". Nothing on it is
// Hastam-branded: the patient just calls the clinic's number.
//
// Adapted from kollektor-demo/PhoneDevice.astro (same body, same em sizing, so
// both tabs show the same handset), with every name re-prefixed hd- so the two
// demos can share a page. Fixes made there do not carry over; port them here.
//
// Everything inside is sized in em off the slot's font size, so one layout
// scales from the compact phone above the window (below lg) to the full
// handset standing beside it (lg and up). Purely decorative: the parent
// wrapper is aria-hidden and none of the "buttons" are real controls.
import { PhoneOff, Stethoscope } from "lucide-react";

interface Props {
  copy: {
    clinic: string;
    number: string;
    statusTime: string;
    dialing: string;
    ringing: string;
    ended: string;
    capAgent: string;
    capPatient: string;
  };
  /** Final call length, mm:ss, for the ended status. */
  duration: string;
  /** Caption shown in the markup (the last line); the sequence rewrites it. */
  caption: string;
}

const { copy, duration, caption } = Astro.props;

const RAY_COUNT = 40;
const rays = Array.from({ length: RAY_COUNT }, (_, i) => ({
  angle: ((360 / RAY_COUNT) * i).toFixed(1),
  // Resting length once the line is closed: short and slightly uneven.
  rest: (0.16 + 0.1 * Math.abs(Math.sin(i * 1.9))).toFixed(3),
}));
---

<div class="hd-phone-slot">
  <div class="hd-phone">
    <span class="hd-phone-key hd-phone-key--action"></span>
    <span class="hd-phone-key hd-phone-key--up"></span>
    <span class="hd-phone-key hd-phone-key--down"></span>
    <span class="hd-phone-key hd-phone-key--power"></span>

    <div class="hd-phone-screen">
      <div class="hd-status">
        <span class="hd-status-time">{copy.statusTime}</span>
        <span class="hd-island"></span>
        <span class="hd-status-icons">
          <svg viewBox="0 0 17 11" class="hd-status-signal" aria-hidden="true">
            <rect x="0" y="7" width="3" height="4" rx="0.8"></rect>
            <rect x="4.6" y="5" width="3" height="6" rx="0.8"></rect>
            <rect x="9.2" y="2.5" width="3" height="8.5" rx="0.8"></rect>
            <rect x="13.8" y="0" width="3" height="11" rx="0.8"></rect>
          </svg>
          <svg viewBox="0 0 25 12" class="hd-status-battery" aria-hidden="true">
            <rect
              x="0.5"
              y="0.5"
              width="21"
              height="11"
              rx="3.2"
              fill="none"
              stroke="currentColor"
              stroke-opacity="0.45"></rect>
            <rect x="2" y="2" width="15" height="8" rx="1.8"></rect>
            <path d="M23 4v4c.8-.3 1.3-1.1 1.3-2S23.8 4.3 23 4z" fill-opacity="0.45"></path>
          </svg>
        </span>
      </div>

      {/* One outgoing-call screen for the whole call, as a phone keeps it:
          only the status line and the voice ring change with the phase. */}
      <div class="hd-screen">
        <div class="hd-caller">
          <p class="hd-caller-name">{copy.clinic}</p>
          <p class="hd-caller-sub">{copy.number}</p>
          <p class="hd-caller-status tabular-nums">
            <span data-hd-when="dial" class="hd-blink">{copy.dialing}</span>
            <span data-hd-when="ring" class="hd-blink">{copy.ringing}</span>
            <span data-hd-when="call" data-hd-time>00:00</span>
            <span data-hd-when="ended">{copy.ended} · {duration}</span>
          </p>
        </div>
        <div class="hd-viz">
          <span class="hd-rings">
            <span class="hd-ring"></span>
            <span class="hd-ring"></span>
            <span class="hd-ring"></span>
          </span>
          <span class="hd-rays">
            {
              rays.map((ray) => (
                <span class="hd-ray" style={`--hd-angle: ${ray.angle}deg`}>
                  <i data-hd-ray style={`--hd-rest: ${ray.rest}`} />
                </span>
              ))
            }
          </span>
          <span class="hd-avatar">
            <Stethoscope className="hd-avatar-icon" strokeWidth={1.5} aria-hidden="true" />
          </span>
        </div>
        <div
          class="hd-cap"
          data-hd-cap
          data-who="agent"
          data-label-agent={copy.capAgent}
          data-label-patient={copy.capPatient}
        >
          <div class="hd-cap-window" data-hd-cap-window>
            <p>
              <span class="hd-cap-who" data-hd-cap-who>{copy.capAgent}</span>
              <span data-hd-cap-text>{caption}</span>
            </p>
          </div>
        </div>
        <div class="hd-grow"></div>
        <div class="hd-controls">
          <span class="hd-key-dot hd-key-dot--end">
            <PhoneOff className="hd-key-icon" strokeWidth={2} aria-hidden="true" />
          </span>
        </div>
      </div>

      <span class="hd-home"></span>
    </div>
  </div>

  {/* Audio between the handset and the Hastam window (lg and up): the
      patient's voice flows in, the assistant's voice flows out. */}
  <div class="hd-link">
    <span class="hd-link-line"></span>
    <span class="hd-link-flow hd-link-flow--in"><i></i><i></i><i></i></span>
    <span class="hd-link-flow hd-link-flow--out"><i></i><i></i><i></i></span>
    <span class="hd-link-cap hd-link-cap--phone"></span>
    <span class="hd-link-cap hd-link-cap--app"></span>
  </div>
</div>

<style is:global>
  /* Slot: compact and cropped above the window below lg, a full handset
     standing on the stage beside the window from lg. The window's left
     margin in HastamDemo.astro matches 19.5em + the link width here. */
  .hd-phone-slot {
    position: relative;
    width: 19.5em;
    height: 23.4em;
    margin: 0 auto 1rem;
    overflow: hidden;
    font-size: 0.75rem;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2.2em), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 2.2em), transparent);
  }

  @media (min-width: 40rem) {
    .hd-phone-slot {
      margin-bottom: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .hd-phone-slot {
      position: absolute;
      top: 0;
      bottom: auto;
      left: 0;
      height: 100%;
      margin: 0;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  @media (min-width: 80rem) {
    .hd-phone-slot {
      font-size: 1rem;
    }
  }

  /* Handset. Always dark, in both themes. */
  .hd-phone {
    position: relative;
    width: 19.5em;
    height: 39em;
    padding: 0.5em;
    border-radius: 3em;
    background: linear-gradient(150deg, #4a4a4f, #1b1b1e 38%, #2c2c30 70%, #151517);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 14%),
      inset 0 0 0 0.22em #0b0b0c,
      0 0 0 1px rgb(0 0 0 / 55%),
      0 2.4em 4em -1.6em rgb(0 0 0 / 75%);
    color: #fff;
  }

  @media (min-width: 64rem) {
    .hd-phone {
      height: 100%;
    }
  }

  .hd-phone-key {
    position: absolute;
    width: 0.24em;
    border-radius: 0.2em;
    background: linear-gradient(90deg, #3c3c40, #1e1e21);
  }

  .hd-phone-key--action {
    top: 6.2em;
    left: -0.2em;
    height: 1.9em;
  }

  .hd-phone-key--up {
    top: 9.2em;
    left: -0.2em;
    height: 3.2em;
  }

  .hd-phone-key--down {
    top: 13.1em;
    left: -0.2em;
    height: 3.2em;
  }

  .hd-phone-key--power {
    top: 10.4em;
    right: -0.2em;
    height: 4.8em;
  }

  .hd-phone-screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 2.5em;
    background: #0b0b0d;
    isolation: isolate;
  }

  .hd-status {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 3;
    display: flex;
    height: 2.9em;
    align-items: center;
    justify-content: space-between;
    padding: 0.15em 1.55em 0 1.95em;
  }

  .hd-status-time {
    font-size: 0.95em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .hd-island {
    position: absolute;
    top: 0.6em;
    left: 50%;
    width: 6.2em;
    height: 1.8em;
    margin-left: -3.1em;
    border-radius: 1em;
    background: #000;
  }

  .hd-status-icons {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    fill: currentColor;
  }

  .hd-status-signal {
    width: 1.2em;
    height: 0.78em;
  }

  .hd-status-battery {
    width: 1.75em;
    height: 0.85em;
  }

  .hd-home {
    position: absolute;
    bottom: 0.55em;
    left: 50%;
    z-index: 3;
    width: 6.4em;
    height: 0.32em;
    margin-left: -3.2em;
    border-radius: 1em;
    background: rgb(255 255 255 / 55%);
  }

  .hd-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2.9em;
    background:
      radial-gradient(100% 45% at 50% 0%, rgb(255 255 255 / 7%), transparent 70%),
      linear-gradient(180deg, #1c1c1f, #0f0f11 55%, #09090b);
  }

  /* Same block height as the Kollektor handset, so the connector's top
     (the centre of the voice ring) is the same too. */
  .hd-caller {
    display: flex;
    height: 4.2em;
    flex: none;
    flex-direction: column;
    align-items: center;
    margin-top: 1.4em;
    padding-inline: 1em;
    text-align: center;
  }

  .hd-caller-name {
    max-width: 100%;
    overflow: hidden;
    font-size: 1.4em;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hd-caller-sub {
    font-size: 0.85em;
    line-height: 1.4;
    color: rgb(255 255 255 / 55%);
    font-variant-numeric: tabular-nums;
  }

  .hd-caller-status {
    font-size: 0.9em;
    line-height: 1.4;
    color: rgb(255 255 255 / 60%);
  }

  .hd-blink {
    animation: hd-blink 2s ease-in-out infinite;
  }

  /* Voice ring: the clinic's avatar, with rings while the line rings or
     rays that follow the voice once the call is live. */
  .hd-viz {
    position: relative;
    width: 9.2em;
    height: 9.2em;
    flex: none;
    margin-top: 1.2em;
  }

  .hd-avatar {
    position: absolute;
    inset: 2.1em;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(160deg, #5d5d63, #34343a);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%);
  }

  .hd-avatar-icon {
    width: 2.2em;
    height: 2.2em;
    color: rgb(255 255 255 / 88%);
  }

  .hd-rings,
  .hd-rays {
    position: absolute;
    inset: 0;
    transition: opacity 360ms ease;
  }

  /* Rings only while the clinic's line rings; rays from the pick-up on. */
  .hd-rings {
    opacity: 0;
  }

  [data-hd-root][data-hd-phase="ring"] .hd-rings {
    opacity: 1;
  }

  [data-hd-root]:is([data-hd-phase="dial"], [data-hd-phase="ring"]) .hd-rays {
    opacity: 0;
  }

  .hd-ring {
    position: absolute;
    inset: 2.1em;
    border: 1px solid color-mix(in oklch, var(--brand) 70%, transparent);
    border-radius: 999px;
    opacity: 0;
    animation: hd-ring 1.8s ease-out infinite;
  }

  .hd-ring:nth-child(2) {
    animation-delay: 0.6s;
  }

  .hd-ring:nth-child(3) {
    animation-delay: 1.2s;
  }

  .hd-ray {
    position: absolute;
    bottom: 50%;
    left: 50%;
    width: 0.22em;
    height: 4.5em;
    margin-left: -0.11em;
    transform: rotate(var(--hd-angle));
    transform-origin: 50% 100%;
  }

  .hd-ray i {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1.55em;
    border-radius: 1em;
    background: rgb(255 255 255 / 22%);
    transform: scaleY(var(--hd-rest, 0.2));
    transform-origin: 50% 100%;
    transition: background-color 240ms ease;
  }

  [data-hd-root][data-hd-phase="ended"] .hd-ray i {
    background: rgb(255 255 255 / 14%);
    transition:
      transform 700ms var(--ease-out-quint),
      background-color 400ms ease;
  }

  [data-hd-root][data-hd-speaker="agent"] .hd-ray i {
    background: var(--brand);
  }

  [data-hd-root][data-hd-speaker="patient"] .hd-ray i {
    background: rgb(255 255 255 / 80%);
  }

  /* Live caption: the tail of the current line, three lines at most. */
  .hd-cap {
    width: calc(100% - 2.6em);
    flex: none;
    margin-top: 1.4em;
    padding: 0.55em 0.85em;
    border-radius: 1em;
    background: rgb(255 255 255 / 7%);
    font-size: 0.9em;
    line-height: 1.4;
    color: rgb(255 255 255 / 78%);
    transition: opacity 240ms ease;
  }

  /* Three lines. The sequence keeps it scrolled to the end, so the newest
     words stay in view and older ones scroll out of the top. */
  .hd-cap-window {
    height: 4.2em;
    overflow: hidden;
  }

  .hd-cap[data-who="none"] {
    opacity: 0;
  }

  [data-hd-root]:is([data-hd-phase="dial"], [data-hd-phase="ring"], [data-hd-phase="ended"])
    .hd-cap {
    opacity: 0;
  }

  .hd-cap-who {
    margin-right: 0.3em;
    font-weight: 500;
    color: rgb(255 255 255 / 95%);
  }

  .hd-cap[data-who="agent"] .hd-cap-who {
    color: var(--brand);
  }

  .hd-grow {
    flex: 1 1 0;
  }

  /* The bottom padding keeps the end key clear of the stage's 2.5rem
     bottom crop at lg: 0.5em phone padding + 3.4em = 3.9em, against 3.33em
     cropped at 12px. (The Kollektor handset's key sits lower and is
     clipped a little at lg.) */
  .hd-controls {
    display: flex;
    width: 100%;
    flex: none;
    flex-direction: column;
    align-items: center;
    padding: 0 1.7em 3.4em;
    transition: opacity 360ms ease;
  }

  [data-hd-root][data-hd-phase="ended"] .hd-controls {
    opacity: 0.35;
  }

  .hd-key-dot {
    display: grid;
    width: 4.3em;
    height: 4.3em;
    place-items: center;
    border-radius: 999px;
  }

  .hd-key-dot--end {
    background: var(--danger);
  }

  .hd-key-icon {
    width: 1.6em;
    height: 1.6em;
  }

  /* Compact phone above the window: a smaller voice ring so the caption
     still clears the crop. */
  @media (max-width: 63.999rem) {
    .hd-caller {
      margin-top: 1.2em;
    }

    .hd-viz {
      font-size: 0.75em;
    }

    .hd-cap {
      margin-top: 1.1em;
    }
  }

  /* Link between handset and window. Its width is the gap the window's
     left margin leaves; its top is the centre of the voice ring:
     0.5 phone padding + 2.9 status + 1.4 caller margin + 4.2 caller
     + 1.2 viz margin + 4.6 half the viz = 14.8em. */
  .hd-link {
    display: none;
    position: absolute;
    top: 14.8em;
    left: 100%;
    width: 2.5rem;
    height: 1em;
    margin-top: -0.5em;
  }

  @media (min-width: 64rem) {
    .hd-link {
      display: block;
    }
  }

  @media (min-width: 80rem) {
    .hd-link {
      width: 3rem;
    }
  }

  .hd-link-line {
    position: absolute;
    top: 50%;
    right: 0.3em;
    left: 0.3em;
    border-top: 1px dashed var(--border-strong);
  }

  .hd-link-cap {
    position: absolute;
    top: 50%;
    width: 0.4em;
    height: 0.4em;
    margin-top: -0.2em;
    border-radius: 999px;
  }

  .hd-link-cap--phone {
    left: 0;
    background: var(--tertiary-foreground);
  }

  .hd-link-cap--app {
    right: 0;
    background: var(--brand);
  }

  .hd-link-flow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms ease;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
  }

  .hd-link-flow--in {
    color: var(--muted-foreground);
  }

  .hd-link-flow--out {
    color: var(--brand);
  }

  .hd-link-flow i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 0;
    animation: hd-flow 1.1s linear infinite;
  }

  .hd-link-flow--out i {
    animation-direction: reverse;
  }

  .hd-link-flow i:nth-child(2) {
    animation-delay: -0.37s;
  }

  .hd-link-flow i:nth-child(3) {
    animation-delay: -0.73s;
  }

  .hd-link-flow i::after {
    position: absolute;
    top: -2px;
    right: 0;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
    content: "";
  }

  [data-hd-root][data-hd-speaker="patient"] .hd-link-flow--in,
  [data-hd-root][data-hd-speaker="agent"] .hd-link-flow--out {
    opacity: 1;
  }

  /* Inbound: while the clinic's line rings, the call is flowing in. */
  [data-hd-root][data-hd-phase="ring"] .hd-link-flow--in {
    opacity: 0.55;
  }

  [data-hd-root][data-hd-phase="ended"] .hd-link-cap--app {
    background: var(--faint-foreground);
  }

  @keyframes hd-ring {
    0% {
      opacity: 0.85;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  @keyframes hd-blink {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes hd-flow {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
</style>
