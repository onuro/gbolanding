---
// What a Hastam call leaves behind: one appointment REQUEST, still waiting for
// the clinic. Booking from a call writes status PENDING_APPROVAL, and the real
// dashboard labels that "Onay bekliyor" in the attention tone, so the pill is
// "waiting", never "done". Rendered twice by HastamDemo (the rail on md+,
// under the transcript on phones), so it stays a dumb, prop-driven card with
// the same rows as kollektor-demo/PromiseReceipt.astro, which keeps the two
// tabs the same height.
import StatusPill from "@/components/ui/StatusPill.astro";

interface Props {
  label: string;
  /** The requested slot, e.g. "Perş. 10:15". */
  when: string;
  status: string;
  rows: { label: string; value: string }[];
  id: string;
  note: string;
  class?: string;
}

const { label, when, status, rows, id, note, class: className } = Astro.props;
---

<div
  class:list={[
    "rounded-card border border-border bg-card p-1 shadow-card",
    className,
  ]}
>
  <div class="rounded-tile border border-border bg-background px-4 pt-3.5 pb-3.5">
    <div class="flex items-center justify-between gap-3">
      <p class="min-w-0 truncate data-label">{label}</p>
      <StatusPill tone="waiting" label={status} />
    </div>
    <p class="mt-3 data-figure">{when}</p>
    <ul class="mt-2.5 flex flex-col gap-1">
      {
        rows.map((row) => (
          <li class="flex items-baseline justify-between gap-3 text-caption">
            <span class="min-w-0 truncate text-muted-foreground">{row.label}</span>
            <span class="shrink-0 data-value">{row.value}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="flex items-center justify-between gap-2 px-3 pt-2 pb-1.5">
    <span class="min-w-0 truncate font-mono text-micro text-tertiary-foreground">
      {id}
    </span>
    <span class="shrink-0 text-micro text-tertiary-foreground">{note}</span>
  </div>
</div>
