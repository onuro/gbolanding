---
import {
  ArrowRight,
  ArrowUpRight,
  Check,
  Pause,
  Phone,
  Play,
  Radio,
  Scale,
  ShieldCheck,
  UserCheck,
} from "lucide-react";
import BlinkText from "@/components/BlinkText";
import PromiseLedgerMock from "@/components/home/kollektor-parts/PromiseLedgerMock.astro";
import QueueMock from "@/components/home/kollektor-parts/QueueMock.astro";
import VoiceLineMock from "@/components/home/kollektor-parts/VoiceLineMock.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { Locale } from "@/i18n/config";
import { pathFor } from "@/i18n/routes";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const copy = messages.kollektorDeep;
const ui =
  locale === "tr"
    ? {
        phone: "Yalnızca telefon",
        desk: "Canlı ekran",
        trustTitle: "Kontrol sizde.",
        trustLead:
          "Kollektor telefonda konuşur, son söz ekibinizindir. Kişisel veriler maskelenir, yasal çerçeve senaryonun içindedir ve öncelikli aramalar ekibinize devredilir.",
        pause: "Otomatik geçişi duraklat",
        play: "Otomatik geçişi sürdür",
      }
    : {
        phone: "Phone only",
        desk: "Live desk",
        trustTitle: "You stay in control.",
        trustLead:
          "Kollektor does the talking. Your team keeps the final say. Personal data is masked, the legal frame lives in the playbook, and priority calls are handed to your team.",
        pause: "Pause auto-advance",
        play: "Resume auto-advance",
      };

const [queueChapter, voiceChapter, ledgerChapter] = copy.chapters;

const sides = [
  {
    icon: Phone,
    tag: ui.phone,
    title: copy.split.debtorTitle,
    body: copy.split.debtorBody,
    beats: copy.split.debtorBeats,
    live: false,
  },
  {
    icon: Radio,
    tag: ui.desk,
    title: copy.split.operatorTitle,
    body: copy.split.operatorBody,
    beats: copy.split.operatorBeats,
    live: true,
  },
];

// KVKK, Law 6502, human control, in the order the i18n items come in.
const trustIcons = [ShieldCheck, Scale, UserCheck];
---

<section
  id="kollektor"
  aria-labelledby="kollektor-heading"
  class="bg-background"
>
  <div class="frame frame-cross border-b border-border">
    <SectionHeader
      eyebrow={copy.eyebrow}
      lead={copy.description}
      headingId="kollektor-heading"
      reveal="cells"
      revealRoot
      rule={false}
      class="pt-16!"
    >
      <BlinkText client:visible text={copy.title} />
    </SectionHeader>

    <div data-kp-track data-reveal>
      <div class="pt-6 pb-12 sm:pb-16" data-kp-stage>
        <div class="px-5 sm:px-8 lg:px-12">
          <div class="mb-8 flex items-center justify-between gap-4">
            <p class="text-label-sm text-tertiary-foreground">
              {copy.pipelineLabel}
            </p>
            <div class="flex items-center gap-3">
              <p
                class="data-label tabular-nums"
                data-kp-page
              >
                01 / 06
              </p>
              {/* Shown by the script only while the steps advance by
                  themselves, so it is never a dead control. */}
              <button
                type="button"
                class="relative grid size-7 cursor-pointer place-items-center rounded-full bg-foreground/[0.05] text-tertiary-foreground transition-colors duration-200 before:absolute before:-inset-[9px] before:content-[''] hover:bg-foreground/[0.09] hover:text-foreground"
                aria-label={ui.pause}
                title={ui.pause}
                data-label-pause={ui.pause}
                data-label-play={ui.play}
                data-kp-toggle
                hidden
              >
                <span class="grid place-items-center" data-kp-icon="pause">
                  <Pause className="size-3" strokeWidth={2} aria-hidden="true" />
                </span>
                <span class="grid place-items-center" data-kp-icon="play" hidden>
                  <Play className="size-3" strokeWidth={2} aria-hidden="true" />
                </span>
              </button>
            </div>
          </div>

          <div class="overflow-hidden" data-kp-viewport>
            <ol class="relative flex" data-kp-rail>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-5 h-px bg-border"
              ></span>
              {
                copy.pipeline.map((step) => (
                  <li class="k-step relative shrink-0 pr-10" data-kp-step>
                    <span class="relative z-10 mb-5 flex size-10 items-center justify-center rounded-full bg-muted data-label text-muted-foreground">
                      {step.number}
                    </span>
                    <h3 class="k-step-title text-title-h5 sm:text-title-h4">
                      {step.title}
                    </h3>
                    <p class="mt-3 max-w-sm text-paragraph-md text-muted-foreground">
                      {step.description}
                    </p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Chapters: visual-first cells. Each mock floats on a quiet dotted well,
         title and one paragraph underneath. The ledger takes a full row. -->
    <div
      class="grid grid-cols-1 border-b border-border px-1 md:grid-cols-2"
      data-k-chapters
      data-reveal-root
    >
      <article class="flex flex-col" data-reveal>
        <div class="px-5 pb-9 pt-5 sm:px-8 sm:pb-10">
          <h3 class="text-title-h5 text-foreground">{queueChapter.title}</h3>
          <p
            class="mt-3 max-w-md text-pretty text-paragraph-sm text-muted-foreground sm:text-paragraph-md"
          >
            {queueChapter.description}
          </p>
        </div>
        <div class="order-first p-2">
          <QueueMock locale={locale} />
        </div>
      </article>

      <article class="flex flex-col" data-reveal>
        <div class="px-5 pb-9 pt-5 sm:px-8 sm:pb-10">
          <h3 class="text-title-h5 text-foreground">{voiceChapter.title}</h3>
          <p
            class="mt-3 max-w-md text-pretty text-paragraph-sm text-muted-foreground sm:text-paragraph-md"
          >
            {voiceChapter.description}
          </p>
        </div>
        <div class="order-first p-2">
          <VoiceLineMock locale={locale} />
        </div>
      </article>

      <article class="grid md:col-span-2 lg:grid-cols-12" data-reveal>
        <div
          class="flex flex-col justify-center px-5 pb-9 pt-5 sm:px-8 sm:pb-10 lg:col-span-5 lg:px-12 lg:py-14"
        >
          <h3 class="text-title-h4 text-foreground">{ledgerChapter.title}</h3>
          <p
            class="mt-4 max-w-md text-pretty text-paragraph-sm text-muted-foreground sm:text-paragraph-md"
          >
            {ledgerChapter.description}
          </p>
        </div>
        <div class="order-first p-2 lg:order-none lg:col-span-7">
          <PromiseLedgerMock locale={locale} />
        </div>
      </article>
    </div>

    <!-- Two sides, one call: intro on the left, a checklist per side. -->
    <div class="grid border-b border-border lg:grid-cols-12" data-reveal-root>
      <div
        class="px-5 py-12 sm:px-8 sm:py-16 lg:col-span-5 lg:px-12"
        data-reveal
      >
        <p class="eyebrow">
          <span aria-hidden="true" class="eyebrow-mark"></span>
          {copy.split.eyebrow}
        </p>
        <h3 class="mt-5 text-title-h3 text-foreground">
          {copy.split.title}
        </h3>
        <p class="mt-4 max-w-md text-pretty text-paragraph-md text-muted-foreground">
          {copy.split.description}
        </p>
      </div>

      <div class="grid gap-3 p-3 sm:grid-cols-2 lg:col-span-7">
        {
          sides.map((side, index) => {
            const Icon = side.icon;
            return (
              <div
                class="soft-card flex flex-col p-2 pt-6 sm:pt-8"
                data-reveal
              >
                <div class="flex items-center gap-3 px-3 sm:px-6">
                  <span
                    class:list={[
                      "grid size-11 shrink-0 place-items-center rounded-full bg-background",
                      side.live ? "text-brand" : "text-muted-foreground",
                    ]}
                  >
                    <Icon aria-hidden="true" className="size-5" strokeWidth={1.5} />
                  </span>
                  <p class="text-label-xs text-tertiary-foreground">{side.tag}</p>
                </div>
                <div class="mt-6 flex flex-1 flex-col rounded-card bg-background p-1">
                  <div class="px-4 pb-2 pt-5 sm:px-5">
                    <h4 class="text-title-h6 text-foreground">{side.title}</h4>
                    <p class="mt-2 text-pretty text-paragraph-sm text-muted-foreground">
                      {side.body}
                    </p>
                  </div>
                  <ul>
                    {side.beats.map((beat) => (
                      <li class="flex items-start gap-3 rounded-lg px-4 py-3 text-paragraph-sm text-foreground sm:px-5">
                        <span
                          aria-hidden="true"
                          class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-brand-soft text-brand"
                        >
                          <Check className="size-3" strokeWidth={2.5} />
                        </span>
                        <span>{beat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- FAQ: the title on the left, the questions on the right, split by
         dotted rules. No cells: the rows are the structure. -->
    <div class="grid gap-y-8 border-b border-border px-5 py-14 sm:px-8 sm:py-16 lg:grid-cols-12 lg:gap-x-12 lg:px-12 lg:py-20" data-reveal-root>
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">
          {copy.faq.eyebrow}
        </p>
        <h3 class="mt-3 text-title-h3 text-foreground">
          {copy.faq.title}
        </h3>
      </div>

      <div class="rule-dotted-b lg:col-span-8" data-k-faq data-reveal>
        {
          copy.faq.items.map((item, index) => {
            const open = index === 0;
            const questionId = `kollektor-faq-q-${index}`;
            const answerId = `kollektor-faq-a-${index}`;
            return (
              <div class="rule-dotted" data-k-faq-item>
                <h4>
                  <button
                    type="button"
                    id={questionId}
                    aria-expanded={open ? "true" : "false"}
                    aria-controls={answerId}
                    class="group flex w-full cursor-pointer items-center justify-between gap-6 py-5 text-left focus-visible:outline-offset-[-2px]"
                    data-k-faq-trigger
                  >
                    <span class="flex min-w-0 items-baseline gap-5">
                      <span
                        aria-hidden="true"
                        class="hidden w-6 shrink-0 data-label tabular-nums sm:block"
                      >
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="text-paragraph-lg text-foreground">
                        {item.question}
                      </span>
                    </span>
                    <span
                      aria-hidden="true"
                      class="grid size-6 shrink-0 place-items-center text-tertiary-foreground transition-colors duration-300 group-hover:text-foreground group-aria-expanded:text-foreground"
                    >
                      <span class="relative size-3.5 transition-transform duration-300 ease-out group-aria-expanded:rotate-45">
                        <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current" />
                        <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current" />
                      </span>
                    </span>
                  </button>
                </h4>
                <div
                  id={answerId}
                  role="region"
                  aria-labelledby={questionId}
                  aria-hidden={open ? "false" : "true"}
                  class:list={[
                    "grid transition-[grid-template-rows] duration-[420ms] ease-out-quint",
                    open ? "grid-rows-[1fr]" : "grid-rows-[0fr]",
                  ]}
                  data-k-faq-panel
                >
                  <div class="overflow-hidden">
                    {/* Indented to the question's left edge, past the number. */}
                    <p class="max-w-[40rem] pb-6 text-pretty text-paragraph-md text-muted-foreground sm:pl-11">
                      {item.answer}
                    </p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Trust band: "you stay in control", the three compliance facts as
         badge cells, and the demo CTA as the section's closing move. -->
    <div data-reveal-root>
      <div class="grid lg:grid-cols-12">
        <div
          class="px-5 pt-12 sm:px-8 sm:pt-16 lg:col-span-8 lg:px-12 lg:pb-14"
          data-reveal
        >
          <p class="text-label-sm text-tertiary-foreground">
            {copy.guardrails.title}
          </p>
          <h3 class="mt-3 text-title-h3 text-foreground">{ui.trustTitle}</h3>
          <p class="mt-5 max-w-2xl text-pretty text-paragraph-md text-muted-foreground">
            {ui.trustLead}
          </p>
        </div>
        <div
          class="flex items-end px-5 pb-12 pt-8 sm:px-8 sm:pb-16 lg:col-span-4 lg:justify-end lg:px-12 lg:pb-14"
          data-reveal
        >
          <a
            href="#demo"
            data-demo-product="kollektor"
            class="button button-lg button-primary group"
          >
            {copy.cta}
            <ArrowRight
              aria-hidden="true"
              className="size-4 transition-transform group-hover:translate-x-0.5"
              strokeWidth={1.75}
            />
          </a>
        </div>
      </div>

      <ul class="grid border-t border-border md:grid-cols-3">
        {
          copy.guardrails.items.map((item, index) => {
            const Icon = trustIcons[index] ?? ShieldCheck;
            return (
              <li
                class="flex flex-col gap-6 border-b border-border px-5 py-6 last:border-b-0 sm:p-8 md:border-b-0 md:border-r md:last:border-r-0 lg:p-10"
                data-reveal
              >
                <span class="k-badge grid size-11 shrink-0 place-items-center rounded-full bg-brand-soft text-brand">
                  <Icon aria-hidden="true" className="size-5" strokeWidth={1.5} />
                </span>
                <div>
                  <h4 class="text-title-h5 text-foreground">{item.title}</h4>
                  <p class="mt-3 max-w-sm text-pretty text-paragraph-sm text-muted-foreground">
                    {item.description}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>

      <div class="flex flex-wrap items-center gap-2 px-5 pt-2 pb-10 sm:px-8 sm:pb-12 lg:px-12">
        <a
          href={pathFor("kollektor", locale)}
          class="button button-sm button-secondary group/row"
        >
          {messages.solutions.kollektor.pageCta}
          <ArrowUpRight
            aria-hidden="true"
            className="size-3.5 shrink-0 text-tertiary-foreground transition-transform group-hover/row:translate-x-0.5 group-hover/row:-translate-y-0.5"
            strokeWidth={1.5}
          />
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-kp-track]").forEach(init);

    function init(track) {
    const viewport = track.querySelector("[data-kp-viewport]");
    const rail = track.querySelector("[data-kp-rail]");
    const page = track.querySelector("[data-kp-page]");
    const steps = [...track.querySelectorAll("[data-kp-step]")];
    const toggle = track.querySelector("[data-kp-toggle]");
    if (!viewport || !rail || !steps.length) return;

    const total = steps.length;
    const hold = 1800;
    const loopDelay = 900;
    let index = 0;
    let timer = 0;
    let visible = false;
    let paused = false;

    const perView = () => {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    };

    const paint = () => {
      const columns = perView();
      const group = Math.floor(index / columns);
      rail.style.transform = `translate3d(${-group * viewport.clientWidth}px, 0, 0)`;
      steps.forEach((step, i) => step.classList.toggle("is-in", i === index));
      if (page) {
        page.textContent = `${String(index + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
      }
    };

    const layout = () => {
      const width = viewport.clientWidth / perView();
      for (const step of steps) step.style.width = `${width}px`;
      paint();
    };

    const stop = () => {
      window.clearTimeout(timer);
    };

    const tick = () => {
      index = (index + 1) % total;
      paint();
      timer = window.setTimeout(tick, index === 0 ? hold + loopDelay : hold);
    };

    const start = () => {
      stop();
      if (paused || !visible) return;
      timer = window.setTimeout(tick, hold);
    };

    layout();

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.addEventListener("resize", layout);
      return;
    }

    // The visitor can hold the steps still. Nothing else about the cadence
    // changes: same hold, same loop.
    if (toggle) {
      const pauseIcon = toggle.querySelector('[data-kp-icon="pause"]');
      const playIcon = toggle.querySelector('[data-kp-icon="play"]');
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        paused = !paused;
        const label =
          (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? "";
        toggle.setAttribute("aria-label", label);
        toggle.title = label;
        if (pauseIcon) pauseIcon.hidden = paused;
        if (playIcon) playIcon.hidden = !paused;
        if (paused) stop();
        else start();
      });
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        if (visible) start();
        else stop();
      },
      { threshold: 0.35 },
    );
    io.observe(track);

    window.addEventListener("resize", layout);
    window.addEventListener("pagehide", stop);
    }
  })();
</script>

<script>
  function initKollektorFaq(root: HTMLElement) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-k-faq-item]")];

    const setOpen = (target: HTMLElement | null) => {
      for (const item of items) {
        const open = item === target;
        const trigger = item.querySelector<HTMLButtonElement>("[data-k-faq-trigger]");
        const panel = item.querySelector<HTMLElement>("[data-k-faq-panel]");
        if (!trigger || !panel) continue;

        trigger.setAttribute("aria-expanded", open ? "true" : "false");
        panel.setAttribute("aria-hidden", open ? "false" : "true");
        panel.classList.toggle("grid-rows-[1fr]", open);
        panel.classList.toggle("grid-rows-[0fr]", !open);
      }
    };

    for (const item of items) {
      const trigger = item.querySelector<HTMLButtonElement>("[data-k-faq-trigger]");
      trigger?.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        setOpen(isOpen ? null : item);
      });
    }
  }

  document.querySelectorAll<HTMLElement>("[data-k-faq]").forEach(initKollektorFaq);
</script>

<style>
  [data-kp-rail] {
    transition: transform 1100ms cubic-bezier(0.87, 0, 0.13, 1);
  }

  /* Every step stays readable. The current one is marked by its ink disc
     and its title in full ink, not by dimming the others. */
  .k-step-title {
    color: var(--muted-foreground);
    transition: color 280ms ease;
  }

  .k-step.is-in .k-step-title {
    color: var(--foreground);
  }

  .k-step.is-in :global(span:first-child) {
    border-color: color-mix(in srgb, var(--foreground) 45%, transparent);
    background: var(--foreground);
    color: var(--background);
  }

  /* Trust badges pop in just after their cell has faded up. The hidden state
     only exists once reveal.ts has marked the page ready. */
  @media (prefers-reduced-motion: no-preference) {
    .k-badge {
      transition:
        scale 650ms cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 400ms ease;
      transition-delay: calc(var(--reveal-delay, 0ms) + 220ms);
    }

    :global(html.reveal-ready) [data-reveal]:not([data-revealed]) .k-badge {
      scale: 0.5;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-kp-rail] {
      transition: none;
    }
  }
</style>
