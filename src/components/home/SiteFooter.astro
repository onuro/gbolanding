---
import { Languages } from "lucide-react";

import type { Locale } from "@/i18n/config";
import { pageKeys, pathFor, routes } from "@/i18n/routes";
import type { Messages } from "@/i18n/types";
import { brand } from "@/lib/brand";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const year = new Date().getFullYear();
const homeHref = pathFor("home", locale);
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const currentPage =
  pageKeys.find((page) =>
    Object.values(routes[page]).some((path) => path === pathname),
  ) ?? "home";
// Fragments are anchored to the home page because this footer also renders on
// /about, where the sections they point at do not exist.
const aboutHref = pathFor("about", locale);
const footerLabel = locale === "tr" ? "Alt menü" : "Footer";
---

{/* Quiet and wide: the mark and the line the site ends on, the links as plain
    text in two columns, the language switch. No cells, no rows. */}
<footer class="bg-background">
  <div class="frame">
    <div
      class="grid gap-x-12 gap-y-12 px-5 pt-14 pb-12 sm:px-8 sm:pt-16 lg:grid-cols-12 lg:px-12 lg:pt-20 lg:pb-16"
    >
      <div class="flex flex-col justify-between gap-10 lg:col-span-5">
        <a
          href={homeHref}
          class="w-fit focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
          aria-label="GBO Vision"
        >
          <img
            src="/gbobo2.svg"
            width="1993"
            height="852"
            alt="GBO Vision"
            class="site-logo h-12 w-auto sm:h-14"
            loading="lazy"
          />
        </a>
        <div>
          <p class="max-w-xs text-balance text-title-h4 text-foreground">
            {messages.footer.tagline}
          </p>
          <address class="mt-4 max-w-sm not-italic text-paragraph-sm text-muted-foreground">
            <span class="block">{brand.streetAddress}</span>
            <span class="block">
              {brand.addressLocality}, {brand.addressRegion}, {locale === "tr" ? "Türkiye" : "Turkey"}
            </span>
          </address>
        </div>
      </div>

      <nav aria-label={footerLabel} class="lg:col-span-4">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-0.5">
          {
            [
              { href: `${homeHref}#solutions`, label: messages.footer.solutions },
              { href: pathFor("kollektor", locale), label: messages.footer.kollektor },
              { href: pathFor("intelval", locale), label: messages.footer.intelval },
              { href: pathFor("hastam", locale), label: messages.footer.hastam },
              { href: pathFor("fountible", locale), label: messages.footer.fountible },
              { href: `${homeHref}#platform`, label: messages.footer.platform },
              { href: `${homeHref}#method`, label: messages.footer.method },
              { href: aboutHref, label: messages.footer.about },
            ].map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="inline-flex min-h-9 items-center text-[0.9375rem] leading-6 text-foreground decoration-tertiary-foreground decoration-1 underline-offset-[3px] transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <div class="flex items-center gap-2 text-muted-foreground">
          <Languages
            aria-hidden="true"
            focusable="false"
            className="size-4"
            strokeWidth={1.5}
          />
          <span class="text-[0.875rem] leading-5">
            {messages.nav.languageLabel}
          </span>
        </div>

        <div
          role="group"
          aria-label={messages.nav.languageLabel}
          class="mt-4 flex w-full max-w-[13rem] items-center gap-1 rounded-full bg-foreground/[0.04] p-1"
        >
          <a
            href={pathFor(currentPage, "en")}
            hreflang="en"
            lang="en"
            aria-current={locale === "en" ? "page" : undefined}
            class:list={[
              "flex min-h-9 flex-1 items-center justify-center rounded-full px-4 text-[0.8125rem] leading-5 transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand",
              locale === "en"
                ? "bg-card text-foreground shadow-card"
                : "text-muted-foreground",
            ]}
          >
            EN
          </a>
          <a
            href={pathFor(currentPage, "tr")}
            hreflang="tr"
            lang="tr"
            aria-current={locale === "tr" ? "page" : undefined}
            class:list={[
              "flex min-h-9 flex-1 items-center justify-center rounded-full px-4 text-[0.8125rem] leading-5 transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand",
              locale === "tr"
                ? "bg-card text-foreground shadow-card"
                : "text-muted-foreground",
            ]}
          >
            TR
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-border px-5 py-5 sm:px-8 lg:px-12">
      <p class="text-paragraph-xs text-tertiary-foreground">
        © {year} {brand.name} · {brand.domain} — {messages.footer.rightsReserved}
      </p>
    </div>
  </div>
</footer>
