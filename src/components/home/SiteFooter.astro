---
import { ArrowUpRight, Languages } from "lucide-react";

import type { Locale } from "@/i18n/config";
import { pageKeys, pathFor, routes } from "@/i18n/routes";
import type { Messages } from "@/i18n/types";
import { brand } from "@/lib/brand";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const year = new Date().getFullYear();
const homeHref = pathFor("home", locale);
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const currentPage =
  pageKeys.find((page) =>
    Object.values(routes[page]).some((path) => path === pathname),
  ) ?? "home";
// Fragments are anchored to the home page because this footer also renders on
// /about, where the sections they point at do not exist.
const aboutHref = pathFor("about", locale);
---

<footer class="bg-background">
  <div class="mx-auto w-full max-w-[83.75rem] border-x border-border">
    <div class="grid lg:grid-cols-12">
      <div
        class="flex min-h-52 flex-col justify-between border-b border-border p-6 sm:p-8 lg:col-span-6 lg:border-r lg:border-b-0 lg:p-10"
      >
        <a
          href={homeHref}
          class="w-fit focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
          aria-label="GBO Vision"
        >
          <img
            src="/gbobo2.svg"
            width="1993"
            height="852"
            alt="GBO Vision"
            class="site-logo h-8 w-auto"
            loading="lazy"
          />
        </a>
        <p class="mt-10 max-w-sm text-balance text-title-h5 text-foreground sm:text-title-h4">
          {messages.footer.tagline}
        </p>
      </div>

      <nav
        aria-label={messages.footer.tagline}
        class="border-b border-border lg:col-span-3 lg:border-r lg:border-b-0"
      >
        <ul class="flex h-full flex-col">
          {
            [
              { href: `${homeHref}#solutions`, label: messages.footer.solutions },
              { href: `${homeHref}#kollektor`, label: messages.footer.kollektor },
              { href: `${homeHref}#platform`, label: messages.footer.platform },
              { href: `${homeHref}#method`, label: messages.footer.method },
              { href: aboutHref, label: messages.footer.about },
            ].map(({ href, label }) => (
              <li class="flex-1 border-b border-border last:border-b-0">
                <a
                  href={href}
                  class="group flex min-h-16 h-full items-center justify-between gap-4 px-6 py-4 text-label-sm text-muted-foreground transition-colors hover:bg-card hover:text-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand sm:px-8"
                >
                  {label}
                  <ArrowUpRight
                    aria-hidden="true"
                    focusable="false"
                    className="size-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    strokeWidth={1.5}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex min-h-44 flex-col justify-between p-6 sm:p-8 lg:col-span-3 lg:min-h-0">
        <div class="flex items-center gap-2 text-muted-foreground">
          <Languages
            aria-hidden="true"
            focusable="false"
            className="size-4"
            strokeWidth={1.5}
          />
          <span class="text-label-xs">
            {messages.nav.languageLabel}
          </span>
        </div>

        <div
          role="group"
          aria-label={messages.nav.languageLabel}
          class="mt-8 flex items-center gap-1 rounded-full border border-border p-1"
        >
          <a
            href={pathFor(currentPage, "en")}
            hreflang="en"
            lang="en"
            aria-current={locale === "en" ? "page" : undefined}
            class:list={[
              "flex min-h-11 flex-1 items-center justify-center rounded-full px-4 text-label-xs transition-colors hover:bg-card hover:text-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand",
              locale === "en" ? "bg-foreground/[0.07] text-foreground" : "text-muted-foreground",
            ]}
          >
            EN
          </a>
          <a
            href={pathFor(currentPage, "tr")}
            hreflang="tr"
            lang="tr"
            aria-current={locale === "tr" ? "page" : undefined}
            class:list={[
              "flex min-h-11 flex-1 items-center justify-center rounded-full px-4 text-label-xs transition-colors hover:bg-card hover:text-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand",
              locale === "tr" ? "bg-foreground/[0.07] text-foreground" : "text-muted-foreground",
            ]}
          >
            TR
          </a>
        </div>
      </div>
    </div>

    <div class="flex min-h-16 items-center border-t border-border px-6 py-4 sm:px-8 lg:px-10">
      <p class="font-mono text-caption text-muted-foreground">
        © {year} {brand.name} · {brand.domain} — {messages.footer.rightsReserved}
      </p>
    </div>
  </div>
</footer>
