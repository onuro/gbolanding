---
// The receipt Kollektor leaves behind after a call: one promise, its total and
// the payment schedule the debtor confirmed. Rendered twice by KollektorDemo
// (log column on md+, under the transcript on phones), so it stays a dumb,
// prop-driven card. A promise is stored as a date only, so the schedule never
// carries a time of day.
import StatusPill from "@/components/ui/StatusPill.astro";

interface Props {
  label: string;
  amount: string;
  status: string;
  schedule: { when: string; amount: string }[];
  id: string;
  note: string;
  class?: string;
}

const { label, amount, status, schedule, id, note, class: className } = Astro.props;
---

<div
  class:list={[
    "rounded-card border border-border bg-card p-1 shadow-card",
    className,
  ]}
>
  <div class="rounded-tile border border-border bg-background px-4 pt-3.5 pb-3.5">
    <div class="flex items-center justify-between gap-3">
      <p class="data-label">{label}</p>
      <StatusPill tone="done" label={status} />
    </div>
    <p class="mt-3 data-figure">{amount}</p>
    <ul class="mt-2.5 flex flex-col gap-1">
      {
        schedule.map((row) => (
          <li class="flex items-baseline justify-between gap-3 text-caption">
            <span class="min-w-0 truncate text-muted-foreground">{row.when}</span>
            <span class="shrink-0 data-value">{row.amount}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="flex items-center justify-between gap-2 px-3 pt-2 pb-1.5">
    <span class="min-w-0 truncate font-mono text-micro text-tertiary-foreground">
      {id}
    </span>
    <span class="shrink-0 text-micro text-tertiary-foreground">{note}</span>
  </div>
</div>
