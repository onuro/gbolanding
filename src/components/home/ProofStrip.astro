---
import {
  BrainCircuit,
  ChevronRight,
  Pause,
  Play,
  Plug,
  RefreshCw,
  ScanSearch,
} from "lucide-react";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const items = messages.proofStrip.items;
const total = String(items.length).padStart(2, "0");

// One glyph per service, in reading order: diagnose, build, connect, improve.
const icons = [ScanSearch, BrainCircuit, Plug, RefreshCw];

const ui =
  locale === "tr"
    ? {
        flow: "Bu dört hizmet, 01'den 04'e uzanan tek bir akış olarak birbirini izler.",
        pause: "Akış animasyonunu duraklat",
      }
    : {
        flow: "These four services follow one another as a single flow, from 01 to 04.",
        pause: "Pause the flow animation",
      };
---

<section
  aria-labelledby="proof-strip-label"
  class="frame frame-cross border-b border-border"
  data-reveal-root
  data-proof-rail
>
  <div class="grid lg:grid-cols-[repeat(24,minmax(0,1fr))]">
    <div
      class="diagonal-hatch flex p-2 lg:col-span-4"
      data-reveal
    >
      <div
        class="flex min-h-12 flex-1 items-center justify-between gap-4 bg-background px-3 py-2 sm:px-6 lg:flex-col lg:items-stretch lg:justify-between lg:gap-2 lg:px-4 lg:py-2.5"
      >
        <p
          id="proof-strip-label"
          class="eyebrow items-start"
        >
          <span class="eyebrow-mark mt-[5px]" aria-hidden="true"></span>
          {messages.proofStrip.label}
        </p>
        <p class="sr-only">{ui.flow}</p>

        <div class="flex shrink-0 items-center justify-between gap-3">
          <span class="data-label tabular-nums" aria-hidden="true">
            <span data-ps-count>01</span> / {total}
          </span>
          <button
            type="button"
            class="ps-toggle relative inline-flex size-6 shrink-0 before:absolute before:-inset-[11px] before:content-[''] items-center justify-center rounded-full bg-foreground/[0.05] text-tertiary-foreground transition-colors duration-200 hover:bg-foreground/[0.09] hover:text-foreground"
            aria-label={ui.pause}
            aria-pressed="false"
            title={ui.pause}
            data-ps-toggle
            hidden
          >
            <span class="ps-icon-pause inline-flex">
              <Pause className="size-3" strokeWidth={1.75} aria-hidden="true" />
            </span>
            <span class="ps-icon-play inline-flex">
              <Play className="size-3" strokeWidth={1.75} aria-hidden="true" />
            </span>
          </button>
        </div>
      </div>
    </div>

    <ol
      class="grid grid-cols-2 lg:col-span-20 lg:grid-cols-4"
      role="list"
      data-ps-rail
    >
      {
        items.map((item, index) => {
          const Icon = icons[index % icons.length];
          const isFirst = index === 0;
          const isLast = index === items.length - 1;
          return (
            <li
              class:list={[
                "ps-cell flex flex-col px-4 py-4 sm:px-6 sm:py-5 lg:py-3.5 lg:pr-0 lg:pl-6",
              ]}
              data-reveal
              data-ps-cell
              data-active={isFirst ? "" : undefined}
            >
              <div class="relative flex h-10 items-center" aria-hidden="true">
                {isFirst ? (
                  <span class="absolute top-1/2 -left-6 hidden h-px w-6 -translate-y-1/2 bg-border lg:block">
                    <span class="absolute top-1/2 left-0 size-[7px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-border-strong bg-background" />
                  </span>
                ) : (
                  <span class="absolute top-1/2 -left-6 hidden h-px w-6 -translate-y-1/2 bg-border lg:block">
                    <span class="ps-chev absolute top-1/2 left-0 flex size-5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-background text-faint-foreground">
                      <ChevronRight
                        className="size-3"
                        strokeWidth={1.75}
                        aria-hidden="true"
                      />
                    </span>
                  </span>
                )}

                <span
                  class="ps-tile relative flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground"
                  data-ps-tile
                >
                  <Icon
                    className="size-[1.125rem]"
                    strokeWidth={1.5}
                    aria-hidden="true"
                  />
                </span>

                <span class="ps-num data-label ml-3">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span
                  class:list={[
                    "relative ml-3 hidden h-px min-w-4 flex-1 lg:block",
                    isLast
                      ? "bg-linear-to-r from-border to-transparent"
                      : "bg-border",
                  ]}
                  data-ps-track
                >
                  <span
                    class="ps-ray absolute top-1/2 left-0 -mt-px h-0.5 w-14 rounded-full opacity-0"
                    data-ps-ray
                  />
                </span>
              </div>

              <p class="mt-2 text-balance text-label-sm text-foreground lg:pr-5">
                {item}
              </p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  // 2.4s per service: the cell holds, then the ray runs the rail to the next one.
  const DWELL = 1600;
  const TRAVEL = 800;

  function initRail(root: HTMLElement) {
    const cells = [...root.querySelectorAll<HTMLElement>("[data-ps-cell]")];
    if (cells.length < 2) return;
    // Reduced motion keeps the server-rendered state: 01 lit, nothing moves.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduce.matches) return;

    const rail = root.querySelector<HTMLElement>("[data-ps-rail]");
    const count = root.querySelector<HTMLElement>("[data-ps-count]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-ps-toggle]");

    let index = 0;
    let phase: "dwell" | "travel" = "dwell";
    let left = DWELL;
    let timer = 0;
    let startedAt = 0;
    let flight: Animation | null = null;
    let visible = false;
    let hovered = false;
    let stopped = false;

    const setActive = (next: number) => {
      index = (next + cells.length) % cells.length;
      cells.forEach((cell, i) => cell.toggleAttribute("data-active", i === index));
      if (count) count.textContent = String(index + 1).padStart(2, "0");
    };

    const wait = (ms: number, then: () => void) => {
      startedAt = performance.now();
      timer = window.setTimeout(() => {
        timer = 0;
        then();
      }, ms);
    };

    const arrive = () => {
      flight = null;
      phase = "dwell";
      left = DWELL;
      setActive(index + 1);
      run();
    };

    const fly = () => {
      const cell = cells[index];
      const track = cell?.querySelector<HTMLElement>("[data-ps-track]");
      const ray = cell?.querySelector<HTMLElement>("[data-ps-ray]");
      // Below lg there is no rail to run, so the cell simply holds a beat longer.
      if (!track || !ray || track.offsetWidth === 0) {
        wait(left, arrive);
        return;
      }

      const start = track.getBoundingClientRect().left;
      const nextTile = cells[index + 1]?.querySelector<HTMLElement>("[data-ps-tile]");
      const frames: Keyframe[] = nextTile
        ? (() => {
            // The ray's leading end lands on the next tile's left edge.
            const end = nextTile.getBoundingClientRect().left - start - ray.offsetWidth;
            return [
              { transform: "translateX(0)", opacity: 0 },
              { transform: `translateX(${end * 0.12}px)`, opacity: 1, offset: 0.12 },
              { transform: `translateX(${end * 0.9}px)`, opacity: 1, offset: 0.9 },
              { transform: `translateX(${end}px)`, opacity: 0 },
            ];
          })()
        : (() => {
            // The last cell's rail fades out; the ray fades with it and the
            // flow starts again at 01.
            const end = (track.offsetWidth - ray.offsetWidth) * 0.8;
            return [
              { transform: "translateX(0)", opacity: 0 },
              { transform: `translateX(${end * 0.12}px)`, opacity: 1, offset: 0.12 },
              { transform: `translateX(${end}px)`, opacity: 0 },
            ];
          })();

      flight = ray.animate(frames, {
        duration: TRAVEL,
        easing: "cubic-bezier(0.65, 0, 0.35, 1)",
      });
      flight.onfinish = arrive;
    };

    const halt = () => {
      if (timer) {
        window.clearTimeout(timer);
        timer = 0;
        left = Math.max(120, left - (performance.now() - startedAt));
      }
      flight?.pause();
    };

    function run() {
      if (stopped || hovered || !visible || document.hidden || reduce.matches) return;
      if (timer) return;
      if (flight) {
        if (flight.playState !== "running") flight.play();
        return;
      }
      if (phase === "dwell") {
        wait(left, () => {
          phase = "travel";
          left = TRAVEL;
          fly();
        });
      } else {
        fly();
      }
    }

    setActive(0);

    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        stopped = !stopped;
        toggle.setAttribute("aria-pressed", stopped ? "true" : "false");
        if (stopped) halt();
        else run();
      });
    }

    if (rail && window.matchMedia("(hover: hover)").matches) {
      rail.addEventListener("pointerenter", () => {
        hovered = true;
        halt();
      });
      rail.addEventListener("pointerleave", () => {
        hovered = false;
        run();
      });
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) halt();
      else run();
    });

    // Reduced motion switched on mid-visit: drop the ray, go back to the
    // static state (01 lit) and hide the control that no longer does anything.
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        halt();
        flight?.cancel();
        flight = null;
        phase = "dwell";
        left = DWELL;
        setActive(0);
        if (toggle) toggle.hidden = true;
      } else {
        if (toggle) toggle.hidden = false;
        run();
      }
    });

    if (!("IntersectionObserver" in window)) {
      visible = true;
      run();
      return;
    }

    new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visible = entry.isIntersecting;
          if (visible) run();
          else halt();
        }
      },
      { threshold: 0.5 },
    ).observe(root);
  }

  document
    .querySelectorAll<HTMLElement>("[data-proof-rail]")
    .forEach((root) => initRail(root));
</script>

<style>
  .ps-tile,
  .ps-num,
  .ps-chev {
    transition:
      color 450ms var(--ease-out-quint),
      border-color 450ms var(--ease-out-quint),
      background-color 300ms var(--ease-out-quint),
      box-shadow 450ms var(--ease-out-quint);
  }

  @media (hover: hover) {
    .ps-cell:hover .ps-tile {
      background-image: linear-gradient(var(--brand-soft), var(--brand-soft));
      color: var(--foreground);
    }
  }

  /* Lit icon box is an ink chip, like every other "this one" mark on the
     page. The number and chevron stay brand, in the value that reads as text. */
  .ps-cell[data-active] .ps-tile {
    background-color: var(--foreground);
    background-image: none;
    color: var(--background);
  }

  .ps-cell[data-active] .ps-num {
    color: var(--brand-ink);
  }

  .ps-cell[data-active] .ps-chev {
    color: var(--brand-ink);
  }

  /* The rail's light: a short streak along the hairline, brightest at its
     leading end and fading out behind it, with a faint halo. */
  .ps-ray {
    background: linear-gradient(to right, transparent, var(--brand));
    box-shadow: 0 0 6px var(--brand-line);
  }

  .ps-toggle[aria-pressed="true"] .ps-icon-pause,
  .ps-toggle:not([aria-pressed="true"]) .ps-icon-play {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ps-tile,
    .ps-num,
    .ps-chev {
      transition: none;
    }
  }
</style>
