---
import { Image } from "astro:assets";
import kollektorImage from "@/assets/editorial/kollektor-human-conversation-particles-original-2x.png";
import intelvalImage from "@/assets/editorial/intelval-architecture.png";
import {
  ArrowUpRight,
  ChartNoAxesCombined,
  Scale,
} from "lucide-react";
import BlinkText from "@/components/BlinkText";
import EnterprisePhases from "@/components/home/EnterprisePhases.astro";
import HastamProduct from "@/components/home/HastamProduct.astro";
import ProductVideo from "@/components/home/ProductVideo.astro";
import IntelvalReportCard from "@/components/home/solutions-mocks/IntelvalReportCard.astro";
import KollektorCallCard from "@/components/home/solutions-mocks/KollektorCallCard.astro";
import MockWell from "@/components/home/solutions-mocks/MockWell.astro";
import {
  formatPercent,
  formatValue,
  methodsFor,
  positionOnRange,
  valuation,
} from "@/components/home/solutions-mocks/intelval-data";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const { kollektor, intelval } = messages.solutions;

const numberPart = /^\d[\d.,]*$/;
const highlightParts = (text: string) => text.split(/(\d[\d.,]*)/).filter(Boolean);
const visualCopy =
  locale === "tr"
    ? {
        caseCommand: "Çağrı paneli",
        case: "Dosya",
        live: "Canlı",
        callsToday: "Bugünkü arama",
        recovered: "Toplam tahsilat",
        connectRate: "Ulaşma oranı",
        callState: "Durum",
        amount: "Tutar",
        onCall: "Görüşmede",
        promised: "Ödeme taahhüdü",
        callback: "Tekrar aranacak",
        settled: "Tahsil edildi",
        escalated: "Ekibe devredildi",
        // Converted at the TCMB rate for 11 Aug 2026, 47,7364 ₺/$.
        recoveredTotal: "₺1,2M",
        amounts: ["₺48.200", "₺12.750", "₺31.400", "₺7.900"],
        analysis: "Konut",
        concluded: "Tahmini değer",
        valueRange: "₺ milyon",
        low: "Alt",
        high: "Üst",
        weight: "Ağırlık",
        methodsLabel: "yöntem",
      }
    : {
        caseCommand: "Call floor",
        case: "Case",
        live: "Live",
        callsToday: "Calls today",
        recovered: "Recovered",
        connectRate: "Connect rate",
        callState: "State",
        amount: "Amount",
        onCall: "On call",
        promised: "Promise to pay",
        callback: "Call back",
        settled: "Settled",
        escalated: "To your team",
        recoveredTotal: "$25K",
        amounts: ["$1,010", "$267", "$658", "$166"],
        analysis: "Home",
        concluded: "Estimated value",
        valueRange: "₺ million",
        low: "Low",
        high: "High",
        weight: "Weight",
        methodsLabel: "methods",
      };

// One case is being worked right now; that is the only thing in either console
// allowed to carry the brand colour.
// A minute on the call floor: one call in progress, one handed to the firm, and
// closed outcomes either side. Those two are the only rows carrying a colour.
const caseRows = [
  {
    id: "K-2084",
    state: visualCopy.escalated,
    amount: visualCopy.amounts[0],
    bar: 62,
    hold: true,
  },
  {
    id: "K-1973",
    state: visualCopy.promised,
    amount: visualCopy.amounts[1],
    bar: 88,
  },
  // Not K-1911: that case is the promise-to-pay call in the Kollektor demo
  // above. This one is agreeing an instalment plan in the card's media well.
  {
    id: "K-1927",
    state: visualCopy.onCall,
    amount: visualCopy.amounts[2],
    bar: 46,
    live: true,
    timer: "02:14",
  },
  {
    id: "K-1865",
    state: visualCopy.callback,
    amount: visualCopy.amounts[3],
    bar: 24,
  },
];

const caseStats = [
  { value: "4 812", label: visualCopy.callsToday },
  { value: "68%", label: visualCopy.connectRate },
  { value: visualCopy.recoveredTotal, label: visualCopy.recovered },
];

// Speech on the wire versus a line that has hung up.
const LIVE_WAVE = [38, 72, 54, 96, 62, 88, 44, 78, 58, 92, 48, 70, 36, 84, 52];
const QUIET_WAVE = [22, 34, 26, 40, 30, 44, 24, 38, 28, 42, 26, 36, 22, 32, 24];

// Three methods bracket a range, and the concluded figure is the output. The
// same numbers feed the draft report floating in the Intelval well.
const methods = methodsFor(locale);
const concludedAt = positionOnRange(valuation.concluded);
---

<section
  id="solutions"
  class="mx-auto w-full max-w-[83.75rem] scroll-mt-16 border-x border-b border-border"
  aria-labelledby="solutions-title"
>
  <div
    class="grid grid-cols-1 border-b border-border lg:grid-cols-12 lg:items-end"
    data-reveal-root
  >
    <div class="px-5 py-10 sm:px-8 sm:py-14 lg:col-span-7 lg:px-12 lg:py-16" data-reveal>
      <p class="eyebrow mb-5">
        <span class="eyebrow-mark" aria-hidden="true"></span>
        {messages.intro.eyebrow}
      </p>
      <h2
        id="solutions-title"
        class="max-w-3xl text-title-h2"
      >
        <BlinkText client:visible text={messages.intro.title} />
      </h2>
    </div>
    <div
      class="flex items-end border-t border-border px-5 py-8 sm:px-8 lg:col-span-5 lg:border-t-0 lg:px-10 lg:py-16"
      data-reveal
    >
      <p class="max-w-lg text-pretty text-paragraph-md text-muted-foreground">
        {messages.intro.description}
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-px bg-border">
    <div
      class="grid w-full min-w-0 grid-cols-1 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]"
    >
    {/* Each article is its own reveal root, so on phones the second card still
        lifts in when it arrives instead of with the first. The article itself
        never fades: it is a cell of a hairline grid and would flash the rule
        colour underneath. */}
    <article
      class="group relative flex min-h-[41rem] w-full min-w-0 flex-col overflow-hidden border-b border-border bg-background md:grid md:grid-rows-subgrid md:row-span-4 md:border-b-0 md:border-r"
      data-reveal-root
    >
      <div class="p-3">
        <MockWell
          reveal
          align="end"
          class="h-full min-h-[26rem] pt-36 sm:min-h-[28rem] sm:pt-40"
        >
          <Fragment slot="media">
            <ProductVideo
              image={kollektorImage}
              widths={[480, 768, 1120, 1536]}
              sizes="(min-width: 1340px) 756px, (min-width: 768px) calc(58.33vw - 24px), calc(100vw - 24px)"
              position="45% 15%"
              sources={[
                { src: "/media/kollektor-human-conversation-1280.webm", type: "video/webm" },
                { src: "/media/kollektor-human-conversation-1280.mp4", type: "video/mp4" },
              ]}
            />
          </Fragment>
          <KollektorCallCard locale={locale} />
        </MockWell>
      </div>
      <div class="relative z-10 px-5 pt-8 sm:px-8 sm:pt-10" data-reveal>
        <div class="flex items-start justify-between gap-6">
          <div class="min-w-0">
            <p class="mb-3 text-label-sm text-tertiary-foreground">
              {kollektor.eyebrow}
            </p>
            <h3 class="text-title-h3">
              {kollektor.title}
            </h3>
          </div>
          <span
            class="flex size-14 shrink-0 items-center justify-center rounded-full border border-border bg-card text-muted-foreground"
          >
            <Scale aria-hidden="true" className="size-6" strokeWidth={1.5} />
          </span>
        </div>
        <p class="mt-4 max-w-2xl text-paragraph-md text-muted-foreground">
          {kollektor.description}
        </p>

        <ul
          class="mt-7 flex flex-wrap items-baseline gap-x-7 gap-y-2 border-t border-border pt-4"
        >
          {
            kollektor.highlights.map((highlight, index) => (
              <li class="flex items-baseline gap-2">
                <span class="data-label tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="text-label-xs text-muted-foreground">
                  {
                    highlightParts(highlight).map((part) =>
                      numberPart.test(part) ? (
                        <span class="font-mono tabular-nums">{part}</span>
                      ) : (
                        part
                      ),
                    )
                  }
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 flex flex-1 items-end md:mt-0 md:h-full md:min-h-0 md:flex-col md:items-stretch md:pt-10" aria-hidden="true">
        <div class="w-full bg-card/40 md:flex md:min-h-0 md:flex-1 md:flex-col">
          <div
            class="flex items-center justify-between px-5 sm:px-8"
          >
            <span class="data-label">
              Kollektor / {visualCopy.caseCommand}
            </span>
            <span
              class="data-label flex items-center gap-2 text-brand"
            >
              <span class="size-1.5 rounded-full bg-brand"></span>
              {visualCopy.live}
            </span>
          </div>

          <div class="grid grid-cols-3 border-b border-border">
            {
              caseStats.map((stat) => (
                <div class="min-w-0 px-4 py-4 sm:px-8">
                  <p class="text-2xl font-medium whitespace-nowrap tabular-nums text-foreground lg:text-4xl">
                    {stat.value}
                  </p>
                  <p class="data-label mt-1">
                    {stat.label}
                  </p>
                </div>
              ))
            }
          </div>

          <div
            class="grid grid-cols-[4.5rem_1fr_4.5rem] items-center gap-4 border-b border-border px-5 py-2 data-label sm:grid-cols-[5rem_1fr_8.5rem_4.5rem] sm:px-8"
          >
            <span>{visualCopy.case}</span>
            <span>{visualCopy.callState}</span>
            <span class="hidden sm:block" />
            <span class="text-right">{visualCopy.amount}</span>
          </div>

          {
            caseRows.map((row) => (
              <div
                class:list={[
                  "relative grid h-12 grid-cols-[4.5rem_1fr_4.5rem] items-center gap-4 border-b border-border px-5 font-mono text-micro last:border-b-0 sm:grid-cols-[5rem_1fr_8.5rem_4.5rem] sm:px-8",
                  row.live && "bg-brand/[0.04]",
                ]}
              >
                {row.live && (
                  <span class="absolute inset-y-0 left-0 w-0.5 bg-brand" />
                )}
                {row.hold && (
                  <span class="absolute inset-y-0 left-0 w-0.5 bg-attention" />
                )}
                <span
                  class:list={[
                    "tabular-nums",
                    row.live ? "text-foreground" : "text-tertiary-foreground",
                  ]}
                >
                  {row.id}
                </span>
                {/* A live call shows its waveform running; a finished one shows
                    how far through the script it got before it closed. */}
                <span class="flex h-3 items-center gap-[3px] overflow-hidden">
                  {row.live
                    ? LIVE_WAVE.map((height) => (
                        <span
                          class="w-[3px] shrink-0 bg-brand"
                          style={`height: ${height}%;`}
                        />
                      ))
                    : QUIET_WAVE.map((height, bar) => (
                        <span
                          class:list={[
                            "w-[3px] shrink-0",
                            bar * 5 < row.bar
                              ? "bg-foreground/25"
                              : "bg-foreground/[0.08]",
                          ]}
                          style={`height: ${height}%;`}
                        />
                      ))}
                </span>
                <span
                  class:list={[
                    "data-label hidden truncate sm:block",
                    row.live && "text-brand",
                    row.hold && "text-attention-ink",
                    !row.live && !row.hold && "text-tertiary-foreground",
                  ]}
                >
                  {row.live ? (
                    <>
                      {row.state} <span data-call-timer>{row.timer}</span>
                    </>
                  ) : (
                    row.state
                  )}
                </span>
                <span
                  class:list={[
                    "text-right tabular-nums",
                    row.live ? "text-foreground" : "text-tertiary-foreground",
                  ]}
                >
                  {row.amount}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <a
        href="#kollektor"
        class="relative z-20 flex min-h-14 items-center justify-between border-t border-border bg-background px-5 text-label-sm outline-none transition-colors group-hover:bg-foreground/[0.025] focus-visible:bg-foreground/[0.05] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset sm:px-8"
      >
        {kollektor.cta}
        <ArrowUpRight
          aria-hidden="true"
          className="size-4 text-tertiary-foreground transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand"
          strokeWidth={1.5}
        />
      </a>
    </article>

    <article
      class="group relative flex min-h-[41rem] w-full min-w-0 flex-col overflow-hidden bg-background md:grid md:grid-rows-subgrid md:row-span-4"
      data-reveal-root
    >
      <div class="p-3">
        <MockWell
          reveal
          align="end"
          class="h-full min-h-[26rem] pt-36 sm:min-h-[28rem] sm:pt-40"
        >
          <Fragment slot="media">
            <Image
              src={intelvalImage}
              alt=""
              width={1120}
              widths={[480, 640, 960, 1120, 1536]}
              sizes="(min-width: 1340px) 534px, (min-width: 768px) calc(41.67vw - 24px), calc(100vw - 24px)"
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </Fragment>
          <IntelvalReportCard locale={locale} />
        </MockWell>
      </div>
      <div class="relative z-10 px-5 pt-8 sm:px-8 sm:pt-10" data-reveal>
        <div class="flex items-start justify-between gap-6">
          <div class="min-w-0">
            <p class="mb-3 text-label-sm text-tertiary-foreground">
              {intelval.eyebrow}
            </p>
            <h3 class="text-title-h3">
              {intelval.title}
            </h3>
          </div>
          <span
            class="flex size-14 shrink-0 items-center justify-center rounded-full border border-border bg-card text-muted-foreground"
          >
            <ChartNoAxesCombined
              aria-hidden="true"
              className="size-6"
              strokeWidth={1.5}
            />
          </span>
        </div>
        <p class="mt-4 text-paragraph-md text-muted-foreground">
          {intelval.description}
        </p>

        <ul
          class="mt-7 flex flex-wrap items-baseline gap-x-7 gap-y-2 border-t border-border pt-4"
        >
          {
            intelval.highlights.map((highlight, index) => (
              <li class="flex items-baseline gap-2">
                <span class="data-label tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="text-label-xs text-muted-foreground">
                  {
                    highlightParts(highlight).map((part) =>
                      numberPart.test(part) ? (
                        <span class="font-mono tabular-nums">{part}</span>
                      ) : (
                        part
                      ),
                    )
                  }
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 flex flex-1 items-end md:mt-0 md:h-full md:min-h-0 md:flex-col md:items-stretch md:pt-10" aria-hidden="true">
        <div class="flex w-full flex-col bg-card/40 md:min-h-0 md:flex-1">
          <div
            class="flex items-center justify-between px-5 sm:px-8"
          >
            <span class="data-label">
              Intelval / {visualCopy.analysis}
            </span>
            <span class="data-label">
              {methods.length} {visualCopy.methodsLabel}
            </span>
          </div>

          <div class="flex flex-1 flex-col justify-center border-b border-border px-5 py-5 sm:px-8">
            <p class="data-label">
              {visualCopy.concluded}
            </p>
            <p
              class="mt-2 text-3xl font-medium tabular-nums leading-none tracking-[-0.03em] text-brand sm:text-4xl"
            >
              {formatValue(locale, valuation.concluded)}
            </p>

            <div class="mt-5">
              <div class="relative h-6">
                <span
                  class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-foreground/15"
                ></span>
                {
                  methods.map((method) => (
                    <span
                      class="absolute top-1/2 h-2 w-px -translate-y-1/2 bg-foreground/30"
                      style={`left: ${positionOnRange(method.value)}%;`}
                    />
                  ))
                }
                <span
                  class="absolute top-1/2 h-4 w-0.5 -translate-x-1/2 -translate-y-1/2 bg-brand"
                  style={`left: ${concludedAt}%;`}
                ></span>
              </div>
              <div
                class="data-label flex items-center justify-between gap-3"
              >
                <span>{visualCopy.low} {formatValue(locale, valuation.low)}</span>
                <span class="min-w-0 truncate">{visualCopy.valueRange}</span>
                <span>{formatValue(locale, valuation.high)} {visualCopy.high}</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3">
            {
              methods.map((method, index) => (
                <div
                  class:list={[
                    "min-w-0 px-4 py-4 sm:px-6",
                    index !== 2 ? "border-r border-border" : "",
                  ]}
                >
                  <div class="flex items-baseline justify-between gap-2">
                    <span class="data-label">
                      {method.key}
                    </span>
                    <span class="text-micro tabular-nums text-tertiary-foreground">
                      {formatPercent(locale, method.weight)}
                    </span>
                  </div>
                  <p class="mt-2 text-lg font-medium tabular-nums text-foreground">
                    {formatValue(locale, method.value)}
                  </p>
                  <span class="mt-3 block h-0.5 bg-foreground/[0.07]">
                    <span
                      class="block h-full bg-foreground/25"
                      style={`width: ${method.weight * 2}%;`}
                    />
                  </span>
                  <p class="data-label mt-2">
                    {method.label}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <a
        href="#demo"
        data-demo-product="intelval"
        class="relative z-20 flex min-h-14 items-center justify-between border-t border-border bg-background px-5 text-label-sm outline-none transition-colors group-hover:bg-foreground/[0.025] focus-visible:bg-foreground/[0.05] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset sm:px-8"
      >
        {intelval.cta}
        <ArrowUpRight
          aria-hidden="true"
          className="size-4 text-tertiary-foreground transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand"
          strokeWidth={1.5}
        />
      </a>
    </article>
    </div>

    <HastamProduct locale={locale} product={messages.solutions.hastam} />
    <EnterprisePhases locale={locale} messages={messages} />
  </div>
</section>
