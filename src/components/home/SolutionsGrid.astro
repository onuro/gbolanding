---
import {
  ArrowUpRight,
  BriefcaseBusiness,
  ChartNoAxesCombined,
  Database,
  Network,
  Scale,
  ShieldCheck,
} from "lucide-react";
import BlinkText from "@/components/BlinkText";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const { kollektor, intelval, enterprise } = messages.solutions;
const visualCopy =
  locale === "tr"
    ? {
        solution: "Çözüm",
        caseCommand: "Dosya iş akışı",
        queue: "İş kuyruğu",
        case: "Dosya",
        recoveryPath: "Tahsilat akışı",
        score: "Öncelik",
        workflow: "İş akışı",
        review: "İncele",
        contact: "İletişim",
        resolve: "Sonuçlandır",
        live: "Canlı",
        openCases: "Açık dosya",
        contactRate: "Temas oranı",
        avgCycle: "Ort. döngü",
        days: "gün",
        stage: "Aşama",
        analysis: "Analiz",
        method: "Yöntem",
        market: "Piyasa",
        assets: "Varlıklar",
        concluded: "Sonuçlanan değer",
        valueRange: "Değer aralığı (M)",
        low: "Alt",
        high: "Üst",
        weight: "Ağırlık",
        methodsLabel: "yöntem",
        fabric: "Kurumsal yapay zeka platformu",
        connected: "Bağlı",
        operations: "Operasyon",
        data: "Veri",
        controls: "Kontroller",
        models: "Modeller",
        decisionOutput: "Karar çıktısı",
        context: "Bağlam",
        confidence: "Güven düzeyi",
        control: "Kontrol",
        ready: "Hazır",
        active: "Aktif",
        humanReviewReady: "İnsan denetimi",
      }
    : {
        solution: "Solution",
        caseCommand: "Case workflow",
        queue: "Work queue",
        case: "Case",
        recoveryPath: "Recovery path",
        score: "Priority",
        workflow: "Workflow",
        review: "Review",
        contact: "Contact",
        resolve: "Resolve",
        live: "Live",
        openCases: "Open cases",
        contactRate: "Contact rate",
        avgCycle: "Avg. cycle",
        days: "days",
        stage: "Stage",
        analysis: "Analysis",
        method: "Method",
        market: "Market",
        assets: "Assets",
        concluded: "Concluded value",
        valueRange: "Value range (M)",
        low: "Low",
        high: "High",
        weight: "Weight",
        methodsLabel: "methods",
        fabric: "Enterprise AI platform",
        connected: "Connected",
        operations: "Operations",
        data: "Data",
        controls: "Controls",
        models: "Models",
        decisionOutput: "Decision output",
        context: "Context",
        confidence: "Confidence level",
        control: "Control",
        ready: "Ready",
        active: "Active",
        humanReviewReady: "Human review",
      };

// One case is being worked right now; that is the only thing in either console
// allowed to carry the brand colour.
const caseRows = [
  { id: "K-2084", path: 82, stage: visualCopy.review, priority: 82 },
  { id: "K-1973", path: 68, stage: visualCopy.contact, priority: 68 },
  {
    id: "K-1911",
    path: 94,
    stage: visualCopy.resolve,
    priority: 91,
    live: true,
  },
  { id: "K-1865", path: 54, stage: visualCopy.review, priority: 54 },
];

const caseStats = [
  { value: "1 248", label: visualCopy.openCases },
  { value: "64%", label: visualCopy.contactRate },
  { value: `18 ${visualCopy.days}`, label: visualCopy.avgCycle },
];

// Three methods bracket a range, and the concluded figure is the output.
const valuation = { low: 3.9, high: 4.6, concluded: 4.24 };
const methods = [
  { key: "DCF", label: visualCopy.method, value: "4.10", weight: 45 },
  { key: "MKT", label: visualCopy.market, value: "3.90", weight: 30 },
  { key: "NAV", label: visualCopy.assets, value: "4.60", weight: 25 },
];
const concludedAt = Math.round(
  ((valuation.concluded - valuation.low) / (valuation.high - valuation.low)) *
    100,
);
---

<section
  id="solutions"
  class="mx-auto w-full max-w-[83.75rem] scroll-mt-16 border-x border-b border-border"
  aria-labelledby="solutions-title"
>
  <div
    class="grid grid-cols-1 border-b border-border lg:grid-cols-12"
  >
    <div class="px-5 py-10 sm:px-8 sm:py-14 lg:col-span-7 lg:px-12 lg:py-18">
      <p
        class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/45"
      >
        <span class="h-px w-5 bg-foreground/25" aria-hidden="true"></span>
        {messages.intro.eyebrow}
      </p>
      <h2
        id="solutions-title"
        class="max-w-3xl text-balance text-3xl font-medium leading-[1.05] tracking-[-0.035em] sm:text-5xl"
      >
        <BlinkText client:visible text={messages.intro.title} />
      </h2>
    </div>
    <div
      class="flex items-end border-t border-border px-5 py-8 sm:px-8 lg:col-span-5 lg:border-t-0 lg:border-l lg:px-10 lg:py-14"
    >
      <p class="max-w-lg text-pretty text-base leading-relaxed text-muted-foreground">
        {messages.intro.description}
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-2 xl:grid-cols-12">
    <article
      class="group relative flex min-h-[41rem] flex-col overflow-hidden bg-background md:col-span-1 xl:col-span-7"
    >
      <div class="relative z-10 px-5 pt-8 sm:px-8 sm:pt-10">
        <div class="mb-8 flex items-start justify-between gap-5">
          <span
            class="flex size-10 items-center justify-center border border-border bg-card text-foreground/70"
          >
            <Scale aria-hidden="true" className="size-4" strokeWidth={1.5} />
          </span>
          <span
            class="font-mono text-[9px] uppercase tracking-[0.18em] text-foreground/30"
          >
            {visualCopy.solution} / 01
          </span>
        </div>

        <p
          class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/45"
        >
          {kollektor.eyebrow}
        </p>
        <h3 class="text-3xl font-medium tracking-[-0.03em] sm:text-4xl">
          {kollektor.title}
        </h3>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
          {kollektor.description}
        </p>

        <ul
          class="mt-7 flex flex-wrap items-baseline gap-x-7 gap-y-2 border-t border-border pt-4"
        >
          {
            kollektor.highlights.map((highlight, index) => (
              <li class="flex items-baseline gap-2">
                <span class="font-mono text-[9px] tabular-nums text-foreground/25">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-foreground/60">
                  {highlight}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 flex flex-1 items-end" aria-hidden="true">
        <div class="w-full border-t border-border bg-card/40">
          <div
            class="flex h-9 items-center justify-between border-b border-border px-5 sm:px-8"
          >
            <span
              class="font-mono text-[9px] uppercase tracking-[0.16em] text-foreground/45"
            >
              Kollektor / {visualCopy.caseCommand}
            </span>
            <span
              class="flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.14em] text-brand"
            >
              <span class="size-1.5 rounded-full bg-brand"></span>
              {visualCopy.live}
            </span>
          </div>

          <div class="grid grid-cols-3 border-b border-border">
            {
              caseStats.map((stat, index) => (
                <div
                  class:list={[
                    "px-5 py-4 sm:px-8",
                    index !== 2 ? "border-r border-border" : "",
                  ]}
                >
                  <p class="font-mono text-xl tabular-nums text-foreground/85">
                    {stat.value}
                  </p>
                  <p class="mt-1 truncate font-mono text-[8px] uppercase tracking-[0.14em] text-foreground/30">
                    {stat.label}
                  </p>
                </div>
              ))
            }
          </div>

          <div
            class="grid grid-cols-[4.5rem_1fr_2.5rem] items-center gap-4 border-b border-border px-5 py-2 font-mono text-[8px] uppercase tracking-[0.14em] text-foreground/25 sm:grid-cols-[5.5rem_1fr_6rem_3rem] sm:px-8"
          >
            <span>{visualCopy.case}</span>
            <span>{visualCopy.recoveryPath}</span>
            <span class="hidden sm:block">{visualCopy.stage}</span>
            <span class="text-right">{visualCopy.score}</span>
          </div>

          {
            caseRows.map((row) => (
              <div
                class:list={[
                  "relative grid h-12 grid-cols-[4.5rem_1fr_2.5rem] items-center gap-4 border-b border-border px-5 font-mono text-[10px] last:border-b-0 sm:grid-cols-[5.5rem_1fr_6rem_3rem] sm:px-8",
                  row.live && "bg-brand/[0.04]",
                ]}
              >
                {row.live && (
                  <span class="absolute inset-y-0 left-0 w-0.5 bg-brand" />
                )}
                <span
                  class:list={[
                    "tabular-nums",
                    row.live ? "text-foreground/85" : "text-foreground/45",
                  ]}
                >
                  {row.id}
                </span>
                <span class="h-1 bg-foreground/[0.07]">
                  <span
                    class:list={[
                      "block h-full",
                      row.live ? "bg-brand" : "bg-foreground/25",
                    ]}
                    style={`width: ${row.path}%;`}
                  />
                </span>
                <span
                  class:list={[
                    "hidden truncate text-[9px] uppercase tracking-[0.1em] sm:block",
                    row.live ? "text-brand" : "text-foreground/35",
                  ]}
                >
                  {row.stage}
                </span>
                <span
                  class:list={[
                    "text-right tabular-nums",
                    row.live ? "text-foreground/85" : "text-foreground/35",
                  ]}
                >
                  {row.priority}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <a
        href="#demo"
        class="relative z-20 flex min-h-14 items-center justify-between border-t border-border bg-background px-5 text-sm outline-none transition-colors group-hover:bg-foreground/[0.025] focus-visible:bg-foreground/[0.05] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset sm:px-8"
      >
        {kollektor.cta}
        <ArrowUpRight
          aria-hidden="true"
          className="size-4 text-foreground/40 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand"
          strokeWidth={1.5}
        />
      </a>
    </article>

    <article
      class="group relative flex min-h-[41rem] flex-col overflow-hidden bg-background md:col-span-1 xl:col-span-5"
    >
      <div class="relative z-10 px-5 pt-8 sm:px-8 sm:pt-10">
        <div class="mb-8 flex items-start justify-between gap-5">
          <span
            class="flex size-10 items-center justify-center border border-border bg-card text-foreground/70"
          >
            <ChartNoAxesCombined
              aria-hidden="true"
              className="size-4"
              strokeWidth={1.5}
            />
          </span>
          <span
            class="font-mono text-[9px] uppercase tracking-[0.18em] text-foreground/30"
          >
            {visualCopy.solution} / 02
          </span>
        </div>

        <p
          class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/45"
        >
          {intelval.eyebrow}
        </p>
        <h3 class="text-3xl font-medium tracking-[-0.03em] sm:text-4xl">
          {intelval.title}
        </h3>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
          {intelval.description}
        </p>

        <ul
          class="mt-7 flex flex-wrap items-baseline gap-x-7 gap-y-2 border-t border-border pt-4"
        >
          {
            intelval.highlights.map((highlight, index) => (
              <li class="flex items-baseline gap-2">
                <span class="font-mono text-[9px] tabular-nums text-foreground/25">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-foreground/60">
                  {highlight}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 flex flex-1 items-end" aria-hidden="true">
        <div class="w-full border-t border-border bg-card/40">
          <div
            class="flex h-9 items-center justify-between border-b border-border px-5 sm:px-8"
          >
            <span
              class="font-mono text-[9px] uppercase tracking-[0.16em] text-foreground/45"
            >
              Intelval / {visualCopy.analysis}
            </span>
            <span
              class="font-mono text-[9px] uppercase tracking-[0.14em] text-foreground/25"
            >
              {methods.length} {visualCopy.methodsLabel}
            </span>
          </div>

          <div class="border-b border-border px-5 py-5 sm:px-8">
            <p
              class="font-mono text-[8px] uppercase tracking-[0.14em] text-foreground/30"
            >
              {visualCopy.concluded}
            </p>
            <p
              class="mt-2 font-mono text-4xl tabular-nums leading-none tracking-[-0.02em] text-brand"
            >
              {valuation.concluded.toFixed(2)}
            </p>

            <div class="mt-5">
              <div class="relative h-6">
                <span
                  class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-foreground/15"
                ></span>
                {
                  methods.map((method) => (
                    <span
                      class="absolute top-1/2 h-2 w-px -translate-y-1/2 bg-foreground/30"
                      style={`left: ${Math.round(((Number(method.value) - valuation.low) / (valuation.high - valuation.low)) * 100)}%;`}
                    />
                  ))
                }
                <span
                  class="absolute top-1/2 h-4 w-0.5 -translate-x-1/2 -translate-y-1/2 bg-brand"
                  style={`left: ${concludedAt}%;`}
                ></span>
              </div>
              <div
                class="flex items-center justify-between font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/30"
              >
                <span>{visualCopy.low} {valuation.low.toFixed(2)}</span>
                <span>{visualCopy.valueRange}</span>
                <span>{valuation.high.toFixed(2)} {visualCopy.high}</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3">
            {
              methods.map((method, index) => (
                <div
                  class:list={[
                    "px-5 py-4 sm:px-6",
                    index !== 2 ? "border-r border-border" : "",
                  ]}
                >
                  <div class="flex items-baseline justify-between gap-2">
                    <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-foreground/45">
                      {method.key}
                    </span>
                    <span class="font-mono text-[9px] tabular-nums text-foreground/30">
                      {method.weight}%
                    </span>
                  </div>
                  <p class="mt-2 font-mono text-lg tabular-nums text-foreground/85">
                    {method.value}
                  </p>
                  <span class="mt-3 block h-0.5 bg-foreground/[0.07]">
                    <span
                      class="block h-full bg-foreground/25"
                      style={`width: ${method.weight * 2}%;`}
                    />
                  </span>
                  <p class="mt-2 truncate font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/25">
                    {method.label}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <a
        href="#demo"
        class="relative z-20 flex min-h-14 items-center justify-between border-t border-border bg-background px-5 text-sm outline-none transition-colors group-hover:bg-foreground/[0.025] focus-visible:bg-foreground/[0.05] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset sm:px-8"
      >
        {intelval.cta}
        <ArrowUpRight
          aria-hidden="true"
          className="size-4 text-foreground/40 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand"
          strokeWidth={1.5}
        />
      </a>
    </article>

    <article
      class="group relative grid min-h-[35rem] overflow-hidden bg-background md:col-span-2 xl:col-span-12 xl:grid-cols-12"
    >
      <div
        class="relative z-10 flex flex-col px-5 py-8 sm:px-8 sm:py-10 xl:col-span-5 xl:border-r xl:border-border xl:px-12 xl:py-12"
      >
        <div class="mb-10 flex items-start justify-between gap-5">
          <span
            class="flex size-10 items-center justify-center border border-border bg-card text-foreground/70"
          >
            <Network aria-hidden="true" className="size-4" strokeWidth={1.5} />
          </span>
          <span
            class="font-mono text-[9px] uppercase tracking-[0.18em] text-foreground/30"
          >
            {visualCopy.solution} / 03
          </span>
        </div>

        <p
          class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-foreground/45"
        >
          {enterprise.eyebrow}
        </p>
        <h3 class="max-w-xl text-3xl font-medium tracking-[-0.03em] sm:text-4xl">
          {enterprise.title}
        </h3>
        <p
          class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground"
        >
          {enterprise.description}
        </p>

        <ul
          class="mt-7 flex flex-wrap items-baseline gap-x-7 gap-y-2 border-t border-border pt-4"
        >
          {
            enterprise.highlights.map((highlight, index) => (
              <li class="flex items-baseline gap-2">
                <span class="font-mono text-[9px] tabular-nums text-foreground/25">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-foreground/60">
                  {highlight}
                </span>
              </li>
            ))
          }
        </ul>

        <a
          href="#platform"
          class="mt-9 inline-flex w-fit items-center gap-2 border-b border-foreground/20 pb-1 text-sm outline-none transition-colors hover:border-brand hover:text-brand focus-visible:ring-2 focus-visible:ring-brand"
        >
          {enterprise.cta}
          <ArrowUpRight
            aria-hidden="true"
            className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            strokeWidth={1.5}
          />
        </a>
      </div>

      <div
        class="relative flex min-h-[27rem] items-center justify-center overflow-hidden border-t border-border bg-card/35 p-5 sm:p-8 xl:col-span-7 xl:min-h-0 xl:border-t-0 xl:p-12"
        aria-hidden="true"
      >
        <div
          class="pointer-events-none absolute inset-0"
          style="background-image: radial-gradient(var(--dot-grid-color) 0.7px, transparent 0.7px); background-size: 14px 14px;"
        >
        </div>

        <div class="relative w-full max-w-2xl border border-foreground/15 bg-background">
          <div
            class="flex h-10 items-center justify-between border-b border-border px-4"
          >
            <span
              class="font-mono text-[8px] uppercase tracking-[0.16em] text-foreground/50"
            >
              {visualCopy.fabric}
            </span>
            <span
              class="font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/30"
            >
              {visualCopy.connected}
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-[1fr_4rem_1fr]">
            <div class="grid grid-cols-2 gap-px bg-border">
              {
                [
                  { label: visualCopy.operations, Icon: BriefcaseBusiness },
                  { label: visualCopy.data, Icon: Database },
                  { label: visualCopy.controls, Icon: ShieldCheck },
                  { label: visualCopy.models, Icon: ChartNoAxesCombined },
                ].map(({ label, Icon }) => (
                  <div
                    class="flex min-h-24 flex-col justify-between bg-card/60 p-3"
                  >
                    <Icon
                      className="size-4 text-foreground/35"
                      strokeWidth={1.25}
                    />
                    <span
                      class="font-mono text-[8px] uppercase tracking-[0.12em] text-foreground/40"
                    >
                      {label}
                    </span>
                  </div>
                ))
              }
            </div>

            <div
              class="relative hidden border-x border-border sm:flex sm:items-center sm:justify-center"
            >
              <span class="absolute inset-y-0 left-1/2 w-px bg-border"></span>
              <span
                class="relative z-10 flex size-7 items-center justify-center border border-border-strong bg-background"
              >
                <span class="size-1.5 bg-foreground/35"></span>
              </span>
            </div>

            <div class="border-t border-border p-4 sm:border-t-0">
              <p
                class="font-mono text-[8px] uppercase tracking-[0.14em] text-foreground/30"
              >
                {visualCopy.decisionOutput}
              </p>
              <div class="mt-5 space-y-4">
                {
                  [
                    {
                      label: visualCopy.context,
                      width: "88%",
                      status: visualCopy.ready,
                    },
                    {
                      label: visualCopy.confidence,
                      width: "72%",
                      status: visualCopy.active,
                    },
                    {
                      label: visualCopy.control,
                      width: "94%",
                      status: visualCopy.ready,
                    },
                  ].map((item) => (
                    <div>
                      <div
                        class="mb-2 flex justify-between font-mono text-[8px] uppercase tracking-[0.1em] text-foreground/35"
                      >
                        <span>{item.label}</span>
                        <span>{item.status}</span>
                      </div>
                      <div class="h-1 bg-foreground/[0.07]">
                        <div
                          class="h-full bg-foreground/25"
                          style={`width: ${item.width};`}
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
              <div
                class="mt-6 flex items-center gap-2 border border-brand/20 bg-brand/[0.06] px-3 py-2"
              >
                <span class="size-1.5 bg-brand"></span>
                <span
                  class="font-mono text-[7px] uppercase tracking-[0.12em] text-brand"
                >
                  {visualCopy.humanReviewReady}
                </span>
              </div>
            </div>
          </div>

          <span
            class="absolute -left-px -top-px size-2.5 border-l border-t border-foreground/30"
          ></span>
          <span
            class="absolute -right-px -bottom-px size-2.5 border-r border-b border-foreground/30"
          ></span>
        </div>
      </div>

      <span
        class="absolute right-0 bottom-0 size-3 border-r border-b border-foreground/25"
        aria-hidden="true"
      ></span>
    </article>
  </div>
</section>
