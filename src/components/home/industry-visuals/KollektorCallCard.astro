---
// Banking: a Kollektor collection call that ends in a recorded payment promise.
// Decorative. The parent stage is aria-hidden and carries the sr-only summary.
// Elements marked data-seq fade up in --i order when the parent plays the card.
import { AudioLines, Check, Phone, PhoneOutgoing, ShieldCheck } from "lucide-react";
import MockShell from "@/components/ui/MockShell.astro";
import type { Locale } from "@/i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const ui =
  locale === "tr"
    ? {
        title: "Kollektor · Tahsilat araması",
        meta: "Arama K-1911 · Kredi kartı borcu",
        status: "Görüşmede",
        debtor: "Borçlu",
        ids: "T.C. ***4821 · Tel ***0612",
        duration: "02:14",
        verified: "Kimlik doğrulandı",
        agentLine:
          "Geciken ₺12.480 için arıyorum. Bugün bir ödeme planı yapalım mı?",
        debtorLine: "Yarısını ayın 15'inde, kalanını ay sonunda ödeyebilirim.",
        promise: "Ödeme sözü",
        saved: "Kaydedildi",
        amount: "₺12.480",
        plan: "2 taksit",
        dates: "15 Eki · 31 Eki",
        footer: "KVKK uyumlu görüşme",
        time: "14:32",
        next: "Sıradaki arama · K-1912",
      }
    : {
        title: "Kollektor · Collection call",
        meta: "Call K-1911 · Credit card debt",
        status: "On call",
        debtor: "Debtor",
        ids: "ID ***4821 · Tel ***0612",
        duration: "02:14",
        verified: "Identity verified",
        agentLine:
          "I’m calling about the overdue $12,480. Shall we set up a payment plan today?",
        debtorLine: "I can pay half on the 15th and the rest at the end of the month.",
        promise: "Payment promise",
        saved: "Recorded",
        amount: "$12,480",
        plan: "2 installments",
        dates: "Oct 15 · Oct 31",
        footer: "KVKK-compliant call",
        time: "14:32",
        next: "Next call · K-1912",
      };

// A frozen voice envelope; the parent animates it only while the card is live.
const wave = Array.from({ length: 18 }, (_, i) => {
  const t = i / 17;
  const envelope = Math.sin(t * Math.PI);
  const wobble = 0.45 + 0.55 * Math.abs(Math.sin(i * 1.9) * Math.cos(i * 0.7));
  return Math.round(22 + envelope * wobble * 78);
});
---

<div class="relative">
  <MockShell
    title={ui.title}
    meta={ui.meta}
    status={{ tone: "live", label: ui.status }}
    bodyClass="flex flex-col gap-3 p-4"
  >
    <div data-seq style="--i: 0" class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-2.5">
        <span
          class="grid size-8 shrink-0 place-items-center rounded-full bg-muted text-muted-foreground"
        >
          <Phone className="size-3.5" strokeWidth={1.75} aria-hidden="true" />
        </span>
        <div class="min-w-0">
          <p class="text-label-xs text-foreground">{ui.debtor}</p>
          <p class="truncate font-mono text-micro text-tertiary-foreground">
            {ui.ids}
          </p>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-2.5">
        <span class="hidden h-5 items-center gap-[2px] text-brand min-[400px]:flex">
          {
            wave.map((height, i) => (
              <span
                class="industries-wave-bar w-[2px] rounded-full bg-current"
                style={`height: ${height}%; --i: ${i}`}
              />
            ))
          }
        </span>
        <span class="font-mono text-micro tabular-nums text-tertiary-foreground">
          {ui.duration}
        </span>
      </div>
    </div>

    <div data-seq style="--i: 1" class="flex items-center gap-2">
      <span class="h-px flex-1 bg-border"></span>
      <span
        class="inline-flex items-center gap-1 text-micro text-tertiary-foreground"
      >
        <Check className="size-3 text-brand" strokeWidth={2} aria-hidden="true" />
        {ui.verified}
      </span>
      <span class="h-px flex-1 bg-border"></span>
    </div>

    <div data-seq style="--i: 2" class="flex max-w-[90%] items-end gap-2">
      <span
        class="grid size-6 shrink-0 place-items-center rounded-full bg-brand text-brand-foreground"
      >
        <AudioLines className="size-3.5" strokeWidth={1.75} aria-hidden="true" />
      </span>
      <p
        class="rounded-tile rounded-bl-chip border border-brand-line bg-brand-soft px-3 py-2 text-paragraph-xs text-foreground"
      >
        {ui.agentLine}
      </p>
    </div>

    <div data-seq style="--i: 3" class="ml-auto max-w-[82%]">
      <p
        class="rounded-tile rounded-br-chip bg-muted px-3 py-2 text-paragraph-xs text-foreground"
      >
        {ui.debtorLine}
      </p>
    </div>

    <div
      data-seq
      style="--i: 4"
      class="rounded-tile border border-border bg-muted/40 p-3"
    >
      <div class="flex items-center justify-between gap-3">
        <p class="data-label">{ui.promise}</p>
        <span
          class="inline-flex h-5 items-center gap-1 rounded-full bg-brand-soft px-2 text-micro font-medium text-brand"
        >
          <Check className="size-3" strokeWidth={2} aria-hidden="true" />
          {ui.saved}
        </span>
      </div>
      <div class="mt-2.5 flex items-end justify-between gap-3">
        <p class="data-figure">{ui.amount}</p>
        <div class="min-w-0 text-right">
          <p class="data-value">{ui.plan}</p>
          <p class="mt-0.5 truncate text-caption tabular-nums text-tertiary-foreground">
            {ui.dates}
          </p>
        </div>
      </div>
    </div>

    <div slot="footer" class="flex min-w-0 items-center gap-2">
      <ShieldCheck
        className="size-3.5 shrink-0 text-muted-foreground"
        strokeWidth={1.75}
        aria-hidden="true"
      />
      <span class="truncate text-caption text-muted-foreground">{ui.footer}</span>
      <span class="font-mono text-micro text-tertiary-foreground">{ui.time}</span>
    </div>
  </MockShell>

  <div
    data-seq
    data-seq-pop
    style="--i: 5"
    class="absolute -bottom-5 right-5 hidden h-8 items-center gap-1.5 whitespace-nowrap rounded-full border border-border bg-card px-3 text-caption text-foreground shadow-float sm:flex"
  >
    <PhoneOutgoing className="size-3.5 text-brand" strokeWidth={1.75} aria-hidden="true" />
    {ui.next}
  </div>
</div>
