---
import { ArrowRight, Menu } from "lucide-react";
import ThemeToggle from "@/components/home/ThemeToggle.astro";
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const homeHref = locale === "tr" ? "/tr" : "/";
const primaryNavigationLabel =
  locale === "tr" ? "Ana menü" : "Primary navigation";
const menuLabel = locale === "tr" ? "Menü" : "Menu";
const aboutHref = locale === "tr" ? "/tr/about" : "/about";
// Anchored to the home page rather than left as bare fragments: the same header
// renders on /about, where "#solutions" would point at a section that is not on
// the page. On the home page these still resolve to a same-page jump.
const navItems = [
  { href: `${homeHref}#solutions`, label: messages.nav.solutions },
  { href: `${homeHref}#kollektor`, label: messages.nav.kollektor },
  { href: `${homeHref}#method`, label: messages.nav.method },
  { href: aboutHref, label: messages.nav.about },
];
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-16 w-full max-w-[83.75rem] items-stretch border-x border-border"
  >
    <a
      href={homeHref}
      class="flex min-w-0 items-center border-r border-border px-4 outline-none transition-colors hover:bg-foreground/[0.035] focus-visible:bg-foreground/[0.06] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset sm:px-6"
      aria-label="GBO Vision"
    >
      <img
        src="/gbobo2.svg"
        alt=""
        width="1993"
        height="852"
        class="site-logo h-7 w-auto select-none"
      />
    </a>

    <nav
      aria-label={primaryNavigationLabel}
      class="hidden items-stretch md:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="group relative flex items-center border-r border-border px-4 font-mono text-[12px] uppercase tracking-[0.14em] text-muted-foreground outline-none transition-colors hover:bg-foreground/[0.035] hover:text-foreground focus-visible:bg-foreground/[0.06] focus-visible:text-foreground focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset lg:px-5"
          >
            {item.label}
            <span class="absolute inset-x-4 bottom-0 h-px origin-left scale-x-0 bg-brand transition-transform group-hover:scale-x-100 group-focus-visible:scale-x-100 lg:inset-x-5" />
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-stretch">
      <ThemeToggle locale={locale} />

      <nav
        aria-label={messages.nav.languageLabel}
        class="hidden items-center gap-1 border-l border-border px-3 md:flex"
      >
        <a
          href="/en"
          hreflang="en"
          lang="en"
          aria-current={locale === "en" ? "page" : undefined}
          class:list={[
            "rounded-full px-2.5 py-1.5 font-mono text-[12px] uppercase tracking-[0.12em] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-brand",
            locale === "en"
              ? "bg-foreground/[0.07] text-foreground"
              : "text-muted-foreground hover:text-foreground",
          ]}
        >
          EN
        </a>
        <a
          href="/tr/"
          hreflang="tr"
          lang="tr"
          aria-current={locale === "tr" ? "page" : undefined}
          class:list={[
            "rounded-full px-2.5 py-1.5 font-mono text-[12px] uppercase tracking-[0.12em] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-brand",
            locale === "tr"
              ? "bg-foreground/[0.07] text-foreground"
              : "text-muted-foreground hover:text-foreground",
          ]}
        >
          TR
        </a>
      </nav>

      <div class="flex items-center border-l border-border px-2 sm:px-3">
      <a
        href="#demo"
        class="group inline-flex h-10 items-center justify-center gap-2 rounded-full bg-foreground px-3 text-sm font-medium text-background outline-none transition-colors hover:bg-foreground/90 focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:px-4"
      >
        <span class="sr-only sm:not-sr-only">{messages.nav.scheduleDemo}</span>
        <ArrowRight
          aria-hidden="true"
          className="size-4 transition-transform group-hover:translate-x-0.5"
          strokeWidth={1.75}
        />
      </a>
      </div>

      <details
        class="group relative border-l border-border md:hidden"
        data-mobile-menu
      >
        <summary
          class="flex h-full w-12 cursor-pointer list-none items-center justify-center text-muted-foreground outline-none transition-colors hover:bg-foreground/[0.035] hover:text-foreground focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">{menuLabel}</span>
          <Menu
            aria-hidden="true"
            className="size-4"
            strokeWidth={1.5}
          />
        </summary>

        <div
          class="panel-shadow absolute right-0 top-full mt-2 w-64 overflow-hidden rounded-2xl border border-border bg-background"
        >
          <nav aria-label={primaryNavigationLabel} class="flex flex-col">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class="border-b border-border px-5 py-4 font-mono text-[12px] uppercase tracking-[0.14em] text-muted-foreground outline-none transition-colors hover:bg-foreground/[0.035] hover:text-foreground focus-visible:bg-foreground/[0.06] focus-visible:text-foreground focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-inset"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <nav
            aria-label={messages.nav.languageLabel}
            class="flex items-center justify-between px-5 py-3"
          >
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground">
              {messages.nav.languageLabel}
            </span>
            <span class="flex items-center gap-1">
              <a
                href="/en"
                hreflang="en"
                lang="en"
                aria-current={locale === "en" ? "page" : undefined}
                class:list={[
                  "rounded-full px-2.5 py-1.5 font-mono text-[12px] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-brand",
                  locale === "en"
                    ? "bg-foreground/[0.07] text-foreground"
                    : "text-muted-foreground hover:text-foreground",
                ]}
              >
                EN
              </a>
              <a
                href="/tr"
                hreflang="tr"
                lang="tr"
                aria-current={locale === "tr" ? "page" : undefined}
                class:list={[
                  "rounded-full px-2.5 py-1.5 font-mono text-[12px] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-brand",
                  locale === "tr"
                    ? "bg-foreground/[0.07] text-foreground"
                    : "text-muted-foreground hover:text-foreground",
                ]}
              >
                TR
              </a>
            </span>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const mobileMenu =
    document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");

  mobileMenu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      mobileMenu.open = false;
    }
  });
</script>
