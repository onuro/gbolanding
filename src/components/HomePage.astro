---
import type { Locale } from "@/i18n/config";
import type { Messages } from "@/i18n/types";
import ApproachSection from "@/components/home/ApproachSection.astro";
import EnterprisePhases from "@/components/home/EnterprisePhases.astro";
import FinalCta from "@/components/home/FinalCta.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import IndustriesSection from "@/components/home/IndustriesSection.astro";
import ProductDemos from "@/components/home/ProductDemos.astro";
import KollektorSection from "@/components/home/KollektorSection.astro";
import PlatformSection from "@/components/home/PlatformSection.astro";
import SolutionsGrid from "@/components/home/SolutionsGrid.astro";
import ProofStrip from "@/components/home/ProofStrip.astro";
import SiteFooter from "@/components/home/SiteFooter.astro";
import SiteHeader from "@/components/home/SiteHeader.astro";
import DecoSpacer from "@/components/ui/DecoSpacer.astro";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const skipLink = locale === "tr" ? "Ana içeriğe geç" : "Skip to content";
---

<a class="skip-link" href="#main-content">{skipLink}</a>

<div class="min-h-screen bg-background">
  <SiteHeader locale={locale} messages={messages} />

  <main id="main-content" tabindex="-1">
    <HeroSection locale={locale} messages={messages} />
    <ProofStrip locale={locale} messages={messages} />
    <SolutionsGrid locale={locale} messages={messages} />
    <ProductDemos locale={locale} />
    <div class="mx-auto w-full max-w-[83.75rem] border-x border-b border-border">
      <EnterprisePhases locale={locale} messages={messages} />
    </div>
    <DecoSpacer />
    <IndustriesSection locale={locale} messages={messages} />
    <KollektorSection locale={locale} messages={messages} />
    <DecoSpacer />
    <PlatformSection locale={locale} messages={messages} />
    <ApproachSection locale={locale} messages={messages} />
    <DecoSpacer />
    <FinalCta locale={locale} messages={messages} />
  </main>

  <SiteFooter locale={locale} messages={messages} />
</div>
