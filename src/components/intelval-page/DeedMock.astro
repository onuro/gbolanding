---
// The sample flat's title deed and what Intelval reads off it. On the left the
// deed as it is printed (a TAKBİS record, in Turkish on both pages); on its
// right edge the valuer's screen with the fields and every encumbrance, each
// with the mark of what it means for the file. A few lines on the deed carry
// a numbered highlight, and the value read from that line carries the same
// number on the card, so the eye goes from the paper to the value. A still.
//
// A flagged line is one the valuer has to look at; Intelval lists it, the
// valuer decides what it does to the value. Which line is flagged, and the
// deed itself, are sample data (sample-file.ts), so both locales show the same.
//
// KollektorStage around it hides the picture from screen readers and gives
// them copy.label, so there is no second label here.
import SampleTag from "@/components/product/SampleTag.astro";
import MockShell from "@/components/ui/MockShell.astro";
import type { Locale } from "@/i18n/config";
import type { IntelvalDeedMockCopy } from "@/i18n/page-types/intelval";
import { deedRecord, deedTones, fill } from "./sample-file";
import ToneMark from "./ToneMark.astro";

interface Props {
  locale: Locale;
  copy: IntelvalDeedMockCopy;
}

const { locale, copy } = Astro.props;

// Highlights are numbered in reading order down the deed.
let count = 0;
const sections = deedRecord.sections.map((section) => ({
  heading: section.heading,
  rows: section.rows.map((row) => ({
    ...row,
    ...lastWord(row.value),
    mark: row.reads ? ++count : undefined,
  })),
}));
const marked = sections.flatMap((section) => section.rows).filter((row) => row.mark);
const markOf = (kind: "field" | "encumbrance", index: number) =>
  marked.find((row) => row.reads && row.reads[0] === kind && row.reads[1] === index)?.mark;

const fields = copy.fields.map((field, index) => {
  const value = fill(locale, field.value);
  return { label: field.label, value, ...lastWord(value), mark: markOf("field", index) };
});
const encumbrances = copy.encumbrances.map((item, index) => ({
  ...item,
  ...lastWord(item.detail),
  tone: deedTones[index],
  mark: markOf("encumbrance", index),
}));

// A highlighted field reads the same on the paper and on the card. If copy
// and the deed drift apart the page fails, rather than show two parcels.
for (const row of marked) {
  if (row.reads?.[0] === "field" && fields[row.reads[1]]?.value !== row.value) {
    throw new Error(`Deed row "${row.label}" does not match the card's field ${row.reads[1]}`);
  }
}
const markRange = count > 1 ? `1–${count}` : "1";

// One number style on the paper, on the card and in the footnote. Solid
// brand, so it holds on white paper and on the dark card alike.
const disc =
  "data-label inline-grid size-4 shrink-0 place-items-center rounded-full bg-brand-solid tabular-nums text-brand-foreground";
// In the text flow, so a number follows the last word of a value that wraps.
const inlineDisc = `${disc} ml-1.5 align-middle`;
// The footnote's "1–4": the same fill, as wide as its text.
const rangePill =
  "data-label inline-flex h-4 shrink-0 items-center rounded-full bg-brand-solid px-1.5 tabular-nums text-brand-foreground";
// A marker stroke on the printout; it wraps with the value on a narrow sheet.
const stroke = "bg-brand/25 py-px text-inherit box-decoration-clone";
const strokeStart = "-ml-1 rounded-l-[0.1875rem] pl-1";
const strokeEnd = "-mr-1 rounded-r-[0.1875rem] pr-1";

/** "in favour of a bank" -> { head: "in favour of a ", tail: "bank" }. */
function lastWord(text: string) {
  const at = text.lastIndexOf(" ") + 1;
  return { head: text.slice(0, at), tail: text.slice(at) };
}

// A printout, not a screen: paper white and dark ink in both themes, so it
// reads as the document the card was read from. No site token stays light in
// the dark theme, so the paper's inks are set here, from the light theme's
// zinc. The face is the plain office sans TAKBİS prints in.
const paper = [
  "[--paper-ink:#18181b] [--paper-muted:#5f5f68]",
  "[--paper-rule:rgb(24_24_27/11%)] [--paper-band:rgb(24_24_27/5.5%)]",
  "bg-[#fcfcfa] text-(--paper-ink) [font-family:Arial,Helvetica,sans-serif]",
];
---

<div class="@container w-full max-w-[52rem]">
  {/* From 42rem the card rides over the paper's right edge: they share the
      middle track. Below that they stack, the deed first. */}
  <div class="grid gap-6 @2xl:grid-cols-[minmax(0,15fr)_minmax(0,2fr)_minmax(0,11fr)] @2xl:gap-0">
    {/* Paper's own height, so the card hangs over its lower corner. */}
    <div
      lang="tr"
      class:list={[paper, "min-w-0 rounded-xs shadow-float @2xl:col-[1/3] @2xl:row-start-1 @2xl:self-start"]}
    >
      <div class="flex items-start justify-between gap-4 px-4 pt-4 pb-3 @md:px-5 @md:pt-5">
        <div class="min-w-0">
          <p class="text-micro tracking-[0.08em] text-(--paper-muted)">{deedRecord.kicker}</p>
          <p class="mt-0.5 text-label-xs font-bold tracking-[0.04em]">{deedRecord.title}</p>
        </div>
        <p class="text-micro tracking-[0.08em] text-(--paper-muted)">{deedRecord.system}</p>
      </div>

      {/* Under the card's overlap the paper is margin only: no value sits
          where the card covers it. */}
      <div class="px-4 pb-5 @md:px-5 @2xl:pr-20">
        {
          sections.map((section, index) => (
            <div class:list={[index > 0 && "mt-3"]}>
              <p class="bg-(--paper-band) px-2 py-1 text-micro font-bold tracking-[0.06em]">
                {section.heading}
              </p>
              <dl>
                {section.rows.map((row) => (
                  <div class="grid grid-cols-[6.25rem_minmax(0,1fr)] items-baseline gap-3 border-b border-(--paper-rule) px-2 py-[0.3125rem] @md:grid-cols-[7rem_minmax(0,1fr)]">
                    <dt class="text-micro text-(--paper-muted)">{row.label}</dt>
                    <dd class="text-caption">
                      {/* The stroke is two marks that meet at the last word,
                          so that word and the number stay on one line. Each
                          group sits on one line of markup: a break between
                          them would print a space inside the stroke. */}
                      {row.mark ? (
                        <>
                          {row.head && <mark class:list={[stroke, strokeStart]}>{row.head}</mark>}<span class="whitespace-nowrap"><mark class:list={[stroke, strokeEnd, !row.head && strokeStart]}>{row.tail}</mark><span class={inlineDisc}>{row.mark}</span></span>
                        </>
                      ) : (
                        row.value
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>

    <div class="relative z-10 min-w-0 @2xl:col-[2/4] @2xl:row-start-1 @2xl:pt-14">
      {/* Right-aligned beside the paper, so the line sits on the well and
          never on the deed. */}
      <p class="mb-2.5 pl-1 data-label @2xl:pr-1 @2xl:text-right">{copy.owner}</p>
      {/* A little more lift than shadow-float: in the light theme a white
          card on white paper has nothing else to part them. */}
      <div class="rounded-shell shadow-[0_18px_40px_-12px_rgb(9_9_11/22%)]">
        <MockShell bodyClass="@container">
          {/* The header MockWindow draws, here so the owner line above can
              move to the right. It carries the picture's one sample tag. */}
          <div
            class="flex min-h-12 items-center justify-between gap-3 border-b border-border px-3 py-2.5 @2xs:px-4"
          >
            <div class="min-w-0">
              <p class="truncate text-label-xs text-foreground">{copy.title}</p>
              <p class="mt-0.5 truncate data-label">{fill(locale, copy.meta)}</p>
            </div>
            <SampleTag locale={locale} />
          </div>

          <div class="px-3 pt-3.5 pb-4 @2xs:px-4">
            <p class="data-label">{copy.fieldsLabel}</p>
            {/* Label over value, as a form reads: a value never shares its line
                with a label, so a long owner name or parcel wraps on its own. */}
            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 @lg:grid-cols-3">
              {
                fields.map((field) => (
                  <div class="min-w-0">
                    <dt class="data-label">{field.label}</dt>
                    <dd class="mt-1 text-paragraph-sm text-foreground tabular-nums">
                      {field.mark ? (
                        <>
                          {field.head}<span class="whitespace-nowrap">{field.tail}<span class={inlineDisc}>{field.mark}</span></span>
                        </>
                      ) : (
                        field.value
                      )}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div class="border-t border-border pt-3.5">
            <p class="px-3 data-label @2xs:px-4">{copy.encumbrancesLabel}</p>
            {/* Every row is a subgrid of one list grid, so the details start on
                one line down the list while the kind column is only as wide as
                its longest word. Under a 20rem card the detail drops under its
                kind. The mark's column is auto: a fixed one lost the row's
                padding and pushed the mark over the kind. */}
            <ul
              class="mt-1.5 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 @xs:grid-cols-[auto_max-content_minmax(0,1fr)]"
            >
              {
                encumbrances.map((item, index) => (
                  <li
                    class:list={[
                      "col-span-full grid grid-cols-subgrid items-baseline gap-y-0.5 px-3 py-2.5 @2xs:px-4",
                      index > 0 && "border-t border-border",
                    ]}
                  >
                    <ToneMark tone={item.tone} class="self-start" />
                    <span class="pt-px text-label-xs text-foreground @xs:pt-0">{item.kind}</span>
                    {/* A flagged line's detail keeps full ink: it is the one the
                        valuer has to read. */}
                    <span
                      class:list={[
                        "col-start-2 text-paragraph-sm @xs:col-start-3",
                        item.tone === "flag" ? "text-foreground" : "text-muted-foreground",
                      ]}
                    >
                      {item.mark ? (
                        <>
                          {item.head}<span class="whitespace-nowrap">{item.tail}<span class={inlineDisc}>{item.mark}</span></span>
                        </>
                      ) : (
                        item.detail
                      )}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </MockShell>
      </div>
    </div>
  </div>

  {/* The footnote is part of the picture: it says what the numbers mean. */}
  <p class="mt-4 flex items-start gap-2 pl-1 data-label">
    <span class={rangePill}>{markRange}</span>
    <span class="min-w-0 pt-px">{copy.footnote}</span>
  </p>
</div>

