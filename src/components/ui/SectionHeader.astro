---
// The one section opener: eyebrow and heading on the left (7 of 12 columns),
// one lead sentence on the right (5), which starts level with the heading's
// first line. Open, with air above: a hairline closes it, nothing divides it.
// The heading text is the default slot, so a page can pass a BlinkText island
// with its own client directive. Anything in the "aside" slot (a button) sits
// under the lead.
interface Props {
  /** Small grey line above the heading. Leave out for a heading-only opener. */
  eyebrow?: string;
  /** The one sentence beside the heading. */
  lead: string;
  /** Heading tag. Changing it never changes the size; headingClass does. */
  as?: "h1" | "h2" | "h3";
  headingId?: string;
  /** Size and measure of the heading. */
  headingClass?: string;
  /**
   * Where the scroll reveal sits (see src/scripts/reveal.ts).
   * "cells": on the two cells. "inner": on wrappers inside the cells, so the
   * hairlines between them never fade. "header": on the header itself.
   */
  reveal?: "none" | "header" | "cells" | "inner";
  /** Makes the header its own reveal root instead of joining the section's. */
  revealRoot?: boolean;
  /**
   * The hairline under the header. On for a grid of cells, which needs a top
   * edge; off when cards or free content follow, where space is enough.
   */
  rule?: boolean;
  class?: string;
}

const {
  eyebrow,
  lead,
  as: Heading = "h2",
  headingId,
  headingClass = "max-w-[36rem] text-title-h2",
  reveal = "none",
  revealRoot = false,
  rule = true,
  class: className,
} = Astro.props;

const on = (where: Props["reveal"]) => (reveal === where ? "" : undefined);
const hasAside = Astro.slots.has("aside");
---

<header
  class:list={[
    "grid gap-y-5 px-5 pt-(--head-top) pb-(--head-bottom) sm:px-8 lg:grid-cols-12 lg:gap-x-12 lg:px-12",
    rule && "border-b border-border",
    className,
  ]}
  data-reveal-root={revealRoot ? "" : undefined}
  data-reveal={on("header")}
>
  <div class="lg:col-span-7" data-reveal={on("cells")}>
    <div data-reveal={on("inner")}>
      {
        eyebrow && (
          <p class="eyebrow">
            <span class="eyebrow-mark" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <Heading
        id={headingId}
        class:list={[eyebrow && "mt-4", "text-balance text-foreground", headingClass]}
      >
        <slot />
      </Heading>
    </div>
  </div>
  {/* The lead starts on the heading's first line: an eyebrow is 20px tall and
      sits 16px above the heading, so the lead drops by the same 36px. */}
  <div
    class:list={["lg:col-span-5", eyebrow ? "lg:pt-[2.375rem]" : "lg:pt-0.5"]}
    data-reveal={on("cells")}
  >
    <div
      class:list={[hasAside && "flex flex-col items-start gap-6"]}
      data-reveal={on("inner")}
    >
      <p class="max-w-[30rem] text-pretty text-lead text-foreground/85">
        {lead}
      </p>
      <slot name="aside" />
    </div>
  </div>
</header>
