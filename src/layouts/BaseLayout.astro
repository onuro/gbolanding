---
import "@/styles/global.css";
import CrashProbe from "@/components/dev/CrashProbe.astro";
import { defaultLocale, locales, type Locale } from "@/i18n/config";
import type { PageMetadata } from "@/i18n/metadata";
import { brand } from "@/lib/brand";
import { buildGraph } from "@/lib/schema";

interface Props {
  locale: Locale;
  metadata: PageMetadata;
  /** Page-specific JSON-LD nodes appended to the shared @graph. */
  extraSchema?: Record<string, unknown>[];
}

const { locale, metadata, extraSchema = [] } = Astro.props;
const ogLocale = locale === "tr" ? "tr_TR" : "en_US";
const siteOrigin = new URL(Astro.site ?? Astro.url.origin);
const canonicalUrl = new URL(metadata.canonicalPath, siteOrigin);
// Derived from the page's own cluster, never from a fixed pair -- otherwise
// /about would tell Google its Turkish counterpart is the home page.
const alternateUrls = locales.map((code) => ({
  code,
  href: new URL(metadata.alternates[code], siteOrigin).href,
}));
const defaultAlternateUrl = new URL(
  metadata.alternates[defaultLocale],
  siteOrigin,
).href;
const socialImageUrl = new URL("/og.png", siteOrigin);
const socialImageAlt =
  locale === "tr"
    ? "GBO Vision — İş büyümesi için kurumsal yapay zeka ve özel yazılım."
    : "GBO Vision — Enterprise AI and custom software for business growth.";

// One @graph rather than a lone Organization: the page, the site and the company
// are separate nodes that reference each other by @id, so Google reads one entity
// described from several angles instead of a bare domain it cannot place. That is
// the part of the "gbovision" → "globovision" correction we can actually control.
const schemaGraph = buildGraph({
  origin: siteOrigin,
  canonical: canonicalUrl,
  locale,
  siteDescription: metadata.siteDescription,
  title: metadata.title,
  description: metadata.description,
  pageType: metadata.pageType,
  extraNodes: extraSchema,
});
---

<!doctype html>
<html lang={locale} class="dark h-full antialiased" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e0c" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (() => {
        // Lets CSS hide anything that scripted animation will reveal, without
        // hiding it from visitors who never get the script.
        document.documentElement.classList.add("js");
        try {
          const savedTheme = localStorage.getItem("gbo_theme");
          // An explicit toggle click wins. Failing that the OS decides, which
          // is the only preference a first-time visitor hands us. Dark stays
          // the answer when the OS expresses none, when storage throws, and
          // when the script never runs at all.
          const theme =
            savedTheme === "light" || savedTheme === "dark"
              ? savedTheme
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          const root = document.documentElement;
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          root.classList.toggle("dark", theme === "dark");
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              "content",
              theme === "light" ? "#ffffff" : "#0b0e0c",
            );
          document
            .querySelector("[data-favicon]")
            ?.setAttribute(
              "href",
              theme === "light" ? "/favicon-light.svg" : "/favicon-dark.svg",
            );
        } catch {
          // Dark remains the no-script and storage-restricted default.
        }
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/tt-firs-neue/TTFirsNeue-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/tt-firs-neue/TTFirsNeue-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" data-favicon />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="keywords" content={metadata.keywords.join(", ")} />
    <meta name="author" content={`${brand.name} Team`} />
    <meta name="application-name" content={brand.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateUrls.map(({ code, href }) => (
        <link rel="alternate" hreflang={code} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultAlternateUrl} />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1733" />
    <meta property="og:image:height" content="907" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schemaGraph)}
    />
    {/* Inert unless the URL carries ?probe=1. */}
    <CrashProbe />
    {
      import.meta.env.PROD && (
        <script
          src="https://app.rybbit.io/api/script.js"
          data-site-id="3b0d7d9849c5"
          defer
          is:inline
        />
      )
    }
  </head>
  <body
    class="min-h-full flex flex-col font-sans bg-background text-foreground selection:bg-brand/25 selection:text-foreground"
  >
    <slot />
  </body>
</html>
