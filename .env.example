# Optional fallback for demo requests and contact messages when Resend is not
# configured. Demo requests use RESEND_API_KEY, CONTACT_TO and CONTACT_FROM
# below when a Resend key is available.
WAITLIST_WEBHOOK_URL=

# Optional bearer token sent to the waitlist endpoint.
WAITLIST_WEBHOOK_TOKEN=

# Contact and demo forms (/api/contact and /api/waitlist). Server-side only,
# read per request with process.env, never inlined into the browser bundle.
# With RESEND_API_KEY set, submissions are e-mailed through Resend; otherwise
# they go to WAITLIST_WEBHOOK_URL. With neither, the forms report 503.
RESEND_API_KEY=
# Recipient(s), comma-separated. Defaults to the owner's inbox inside
# src/pages/api/contact.ts; never put it in client code or markup.
CONTACT_TO=
# Sender. Must be on a domain verified in Resend.
# Default: GBO Vision Web <web@gbovision.com>
CONTACT_FROM=

# Origin of the GBO voice API that mints LiveKit tokens (POST /gbo/session).
# Public: it is read in the browser, and Astro inlines it at build time, so it
# must be set in Vercel before the build. The LiveKit wss:// URL comes back in
# the session response, so it is never configured here.
# Production: https://kollektor.gbovision.com
#
# Locally, either run the voice API and point at it:
#   PUBLIC_GBO_API=http://localhost:3010
# or leave it empty to go same-origin through the dev-only proxy in
# src/pages/gbo/session.ts, which forwards to production. The proxy exists
# because the voice API's CORS allowlist covers the production origins only.
PUBLIC_GBO_API=

# Sentry auth token. Build only: it uploads the source maps. Leave it empty
# locally. Set it in Vercel to get readable stack traces.
SENTRY_AUTH_TOKEN=
