# HTTPS endpoint that receives waitlist JSON payloads.
WAITLIST_WEBHOOK_URL=

# Optional bearer token sent to the waitlist endpoint.
WAITLIST_WEBHOOK_TOKEN=

# Origin of the GBO voice API that mints LiveKit tokens (POST /gbo/session).
# Public: it is read in the browser. The LiveKit ws:// URL comes back in that
# response, so it is never configured here.
PUBLIC_GBO_API=http://localhost:3010
